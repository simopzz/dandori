# Copy to .env (git-ignored); mise loads it automatically.

# Supabase: Connect > Session pooler connection string (port 5432).
DANDORI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: address to serve on (default 127.0.0.1:8080).
# DANDORI_ADDR=127.0.0.1:8080

# Claude, for agent Runs: an API key, or leave unset after `ant auth login`.
# ANTHROPIC_API_KEY=
# Optional: model (default the latest Claude model), retries of a failed
# request to the model (default 3) and turns per Run (default 50).
# DANDORI_MODEL=claude-opus-5-5
# DANDORI_LLM_RETRIES=3
# DANDORI_MAX_TURNS=50

# Optional: offer demo Runs on the Runs page, to try the agent and its trace
# by hand. A scripted demo makes no API calls; a Claude one does.
# DANDORI_DEMO=1
