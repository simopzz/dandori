# Copy to .env (git-ignored); mise loads it automatically.

# Supabase: Connect > Session pooler connection string (port 5432). The
# direct connection is IPv6 only, which Docker's default network and
# GitHub's runners can't reach. `mise run db:schema` prints its schema.
# `mise run dev` ignores it and uses a local Postgres (`mise run devdb`).
DANDORI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase Auth, which Users sign in through: the project's URL, and
# Project Settings > API Keys > the publishable key. Magic links lead back
# to wherever the app is reached, so add http://localhost:8080/** to
# Authentication > URL Configuration's Redirect URLs to sign in locally.
DANDORI_SUPABASE_URL=https://<project-ref>.supabase.co
DANDORI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: address to serve on (default 127.0.0.1:8080).
# DANDORI_ADDR=127.0.0.1:8080

# Optional: the zone a day starts and ends in (default Europe/Rome).
# DANDORI_TIMEZONE=Europe/Rome

# Optional: where spans and logs go over OTLP, and the token they are sent
# with: Grafana Cloud's stack > OpenTelemetry > Configure (provision.sh asks
# for both). Unset, nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
