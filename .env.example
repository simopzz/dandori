# Copy to .env (git-ignored); mise loads it automatically.

# Supabase: Connect > Session pooler connection string (port 5432).
MEALOPS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: address to serve on (default 127.0.0.1:8080).
# MEALOPS_ADDR=127.0.0.1:8080
