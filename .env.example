# Copy to .env (git-ignored); mise loads it automatically.

# Supabase: Connect > Session pooler connection string (port 5432).
DANDORI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: the language food terms are written in, it or en (default en).
# Recorded in the database on first start; switching means a new database.
# DANDORI_CONTENT_LANGUAGE=it

# Optional: address to serve on (default 127.0.0.1:8080).
# DANDORI_ADDR=127.0.0.1:8080

# Claude, for agent Runs: an API key, or leave unset after `ant auth login`.
# ANTHROPIC_API_KEY=
# Optional: model (default the latest Claude model), retries of a failed
# request to the model (default 3) and turns per Run (default 50).
# DANDORI_MODEL=claude-opus-5-5
# DANDORI_LLM_RETRIES=3
# DANDORI_MAX_TURNS=50

# Optional: offer demo Runs on the Runs page, to try the agent and its trace
# by hand. A scripted demo makes no API calls; a Claude one does.
# DANDORI_DEMO=1

# Optional: the Esselunga store. The command that runs the Playwright MCP
# server on a browser profile of its own; without it, Runs that reach the
# store fail saying so. Log in to Esselunga in the window it opens (`mise run
# smoke` waits for you to), not by opening the profile by hand: Playwright
# can't read cookies saved with the desktop keyring. It launches Google
# Chrome unless --executable-path names another Chromium browser, such as
# Brave. Check it with `mise run smoke`. The least time between store actions (default 3s), and how many
# of your latest orders a Known Catalog seed reads (default 10).
# DANDORI_PLAYWRIGHT_MCP=npx @playwright/mcp@0.0.83 --executable-path /usr/bin/brave --user-data-dir /home/you/.dandori/browser
# DANDORI_STORE_THROTTLE=3s
# DANDORI_SEED_ORDERS=10
