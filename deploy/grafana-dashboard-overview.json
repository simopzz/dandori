{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "description": "Server spans per interval, by http.route. /healthz, /static/*, /sw.js and the manifest make none.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"dandori\" && resource.deployment.environment.name = \"$env\" && kind = server } | count_over_time() by (span.http.route)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Requests per route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "description": "Tempo's quantiles are its histogram buckets, powers of two: 0.268s means between 0.134s and 0.268s.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"dandori\" && resource.deployment.environment.name = \"$env\" && kind = server } | quantile_over_time(duration, .95) by (span.http.route)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "p95 latency per route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "description": "Error server spans: only a 5xx is one.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"dandori\" && resource.deployment.environment.name = \"$env\" && kind = server && status = error } | count_over_time() by (span.http.route, span.http.response.status_code)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "5xx per route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "description": "Error spans of calls to Supabase Auth, by call: a 4xx it refused, a 5xx, or no answer.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"dandori\" && resource.deployment.environment.name = \"$env\" && name =~ \"supabase .*\" && status = error } | count_over_time() by (name)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Supabase failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "Beats: one kitchen beat span every five minutes; a gap means the server was down. Failures: the beat's error log lines, one per User it failed for (the beat's span stays OK).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "failures"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "beats"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"dandori\" && resource.deployment.environment.name = \"$env\" && name = \"kitchen beat\" } | count_over_time()",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"dandori\", deployment_environment_name=\"$env\"} | detected_level=\"error\" |= \"kitchen beat\" [$__auto]))",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Beat",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "description": "What the error alert counts. Open a line's trace_id with get_tempo_trace.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{service_name=\"dandori\", deployment_environment_name=\"$env\"} | detected_level=\"error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error lines",
      "type": "logs"
    }
  ],
  "refresh": "",
  "schemaVersion": 42,
