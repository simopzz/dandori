package stock

import (
	"fmt"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// StockPage is the Stock page: every Stock Item, the form to record one,
// and every Portion in the kitchen.
type StockPage struct {
	Ingredients []IngredientOption
	Add         ItemForm
	Items       []ItemRow
	// Waiting are the Portions cooked for a Slot still to come; Portions
	// those without a Slot.
	Waiting  []PortionRow
	Portions []PortionRow
}

// IngredientOption is a known Ingredient a Stock Item can be recorded for.
type IngredientOption struct {
	Name string
	Unit string
}

// ItemForm is a Stock Item form's raw field values, so a rejected
// submission is shown back as typed, and an error per field.
type ItemForm struct {
	Values map[string]string
	Errors map[string]string
}

// ItemRow is one Stock Item as stored, with its change form.
type ItemRow struct {
	ID         int64
	Ingredient string
	Quantity   string // e.g. "450 g"
	Location   string
	ExpiresOn  string // empty when there is no expiry date
	Form       ItemForm
}

// PortionRow is one Portion without a Slot, with its move form.
type PortionRow struct {
	ID       int64
	Recipe   string // its Prep Session's Recipe, or what says it has none
	Location string
	// For is the Slot it waits for, e.g. "lunch on Wed 4 Nov"; empty for a
	// Portion without a Slot.
	For string
	// MoveTo is the Storage Location a rejected move asked for, and Error why.
	MoveTo string
	Error  string
}

templ Page(p StockPage) {
	@web.Layout("Dandori — Stock", web.TabStock) {
		@web.PageHeader("在庫", "Stock")
		@web.Section(1, "Stock Items") {
			if len(p.Items) == 0 {
				@noItems()
			} else {
				@web.Rows() {
					for _, it := range p.Items {
						@itemRow(it)
					}
				}
			}
			if len(p.Ingredients) == 0 {
				@web.Hint() {
					Stock Items are of Ingredients the Recipe Library knows: accept a Recipe first.
				}
			}
		}
		@web.Section(2, "Portions waiting for their Slot") {
			if len(p.Waiting) == 0 {
				@web.Empty() {
					No Portions waiting for their Slot.
				}
			} else {
				@web.Rows() {
					for _, portion := range p.Waiting {
						@portionRow(portion)
					}
				}
			}
		}
		@web.Section(3, "Portions without a Slot") {
			if len(p.Portions) == 0 {
				@web.Empty() {
					No Portions without a Slot.
				}
			} else {
				@web.Rows() {
					for _, portion := range p.Portions {
						@portionRow(portion)
					}
				}
			}
		}
		if len(p.Ingredients) > 0 {
			@addSheet(p)
		}
	}
}

templ noItems() {
	@web.Empty() {
		No Stock Items yet.
	}
}

templ addSheet(p StockPage) {
	@web.AddSheet("record-stock-item", "Record a Stock Item", len(p.Add.Errors) > 0) {
		<form id="add-stock-item" class="stack" method="post" action="/stock-items">
			if len(p.Add.Errors) > 0 {
				@web.Alert() {
					The Stock Item was not recorded; fix the fields marked below.
				}
			}
			@web.Field("Ingredient", "", p.Add.Errors["ingredient"]) {
				<select name="ingredient" required
					if p.Add.Errors["ingredient"] != "" {
						aria-invalid="true"
					}
				>
					for _, ing := range p.Ingredients {
						<option value={ ing.Name } selected?={ p.Add.Values["ingredient"] == ing.Name }>{ ing.Name } ({ ing.Unit })</option>
					}
				</select>
			}
			@itemFields(p.Add)
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					Record
				}
			}
		</form>
	}
}

// itemRow is a Stock Item's row. Its forms swap only the row under htmx,
// not the boosted page, so the Stock page keeps its place (ADR 0009).
templ itemRow(it ItemRow) {
	@web.EditRow(len(it.Form.Errors) > 0, itemSummary(it)) {
		<form id={ fmt.Sprintf("stock-item-%d", it.ID) } class="stack" method="post" action={ templ.SafeURL(fmt.Sprintf("/stock-items/%d", it.ID)) } hx-post={ fmt.Sprintf("/stock-items/%d", it.ID) } hx-target="closest li" hx-swap="outerHTML">
			if len(it.Form.Errors) > 0 {
				@web.Alert() {
					The Stock Item was not changed; fix the fields marked below.
				}
			}
			@itemFields(it.Form)
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					Save
				}
				@web.DestructiveButton(templ.Attributes{"type": "submit", "form": fmt.Sprintf("remove-stock-item-%d", it.ID)}) {
					Remove
				}
			}
		</form>
		<form id={ fmt.Sprintf("remove-stock-item-%d", it.ID) } method="post" action={ templ.SafeURL(fmt.Sprintf("/stock-items/%d/delete", it.ID)) } hx-post={ fmt.Sprintf("/stock-items/%d/delete", it.ID) } hx-target="closest li" hx-swap="outerHTML"></form>
	}
}

templ itemSummary(it ItemRow) {
	<span class="row-title">{ it.Ingredient }</span>
	<span class="row-figure">{ it.Quantity }</span>
	<span class="row-meta">
		<span>{ it.Location }</span>
		if it.ExpiresOn != "" {
			<span>expires { it.ExpiresOn }</span>
		}
	</span>
}

// portionRow is a Portion's row; like itemRow, its move swaps only the row.
templ portionRow(p PortionRow) {
	@web.Row() {
		<span class="row-title">{ p.Recipe }</span>
		<span class="row-meta">
			<span>{ p.Location }</span>
			if p.For != "" {
				<span>{ "for " + p.For }</span>
			}
		</span>
		<form id={ fmt.Sprintf("portion-%d", p.ID) } class="row-action" method="post" action={ templ.SafeURL(fmt.Sprintf("/portions/%d/move", p.ID)) } hx-post={ fmt.Sprintf("/portions/%d/move", p.ID) } hx-target="closest li" hx-swap="outerHTML">
			if p.Error != "" {
				@web.Segmented("Move to", "location", locationChoices(), p.MoveTo, p.Error)
			} else {
				@web.Segmented("Move to", "location", locationChoices(), p.Location, "")
			}
			@web.TextButton(templ.Attributes{"type": "submit"}) {
				Move
			}
		</form>
	}
}

func locationChoices() []web.Choice {
	var choices []web.Choice
	for _, loc := range domain.StorageLocations {
		choices = append(choices, web.Choice{Value: string(loc), Label: string(loc)})
	}
	return choices
}

// itemFields are the fields a Stock Item is recorded and changed with.
templ itemFields(f ItemForm) {
	@web.Field("Quantity", "", f.Errors["quantity"]) {
		<input type="text" inputmode="decimal" required name="quantity" value={ f.Values["quantity"] }
			if f.Errors["quantity"] != "" {
				aria-invalid="true"
			}
		/>
	}
	@web.Field("Storage Location", "", f.Errors["location"]) {
		<select name="location" required
			if f.Errors["location"] != "" {
				aria-invalid="true"
			}
		>
			for _, loc := range domain.StorageLocations {
				<option value={ string(loc) } selected?={ f.Values["location"] == string(loc) }>{ string(loc) }</option>
			}
		</select>
	}
	@web.Field("Expires", "optional", f.Errors["expires_on"]) {
		<input type="date" name="expires_on" value={ f.Values["expires_on"] }
			if f.Errors["expires_on"] != "" {
				aria-invalid="true"
			}
		/>
	}
}
