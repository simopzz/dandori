package auth

import (
	"net/url"
	"time"

	"github.com/simopzz/dandori/internal/web"
)

// SignInForm is the sign-in form as shown: what was typed, and why it
// was rejected.
type SignInForm struct {
	Email string
	// EmailErr is why the email was rejected.
	EmailErr web.Message
	// BadLink says the magic link that led here could not sign in.
	BadLink bool
	// Failed says Supabase couldn't be reached to send the link.
	Failed bool
}

// The pages before signing in switch Language, staying where they are.
var (
	signInURL = &url.URL{Path: "/sign-in"}
	sentURL   = &url.URL{Path: "/sign-in/sent"}
)

templ signInPage(today time.Time, f SignInForm) {
	@web.Layout(web.T(ctx, msgSignInTitle), web.SignedOut) {
		@web.LanguageSwitch(signInURL)
		@web.PageHeader("入口", web.T(ctx, msgSignIn), today) {
			<p class="lede">{ web.T(ctx, msgByInvitation) }</p>
		}
		<form id="sign-in" class="stack" method="post" action="/sign-in">
			if f.BadLink {
				@web.Alert() {
					{ web.T(ctx, msgBadLink) }
				}
			}
			if f.Failed {
				@web.Alert() {
					{ web.T(ctx, msgNotSent) }
				}
			}
			@web.Field(web.T(ctx, msgEmail), "", web.T(ctx, f.EmailErr)) {
				<input
					type="email"
					name="email"
					value={ f.Email }
					required
					autocomplete="email"
					if f.EmailErr != (web.Message{}) {
						aria-invalid="true"
					}
				/>
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgSendLink) }
				}
			}
		</form>
	}
}

templ sentPage(today time.Time) {
	@web.Layout(web.T(ctx, msgCheckTitle), web.SignedOut) {
		@web.LanguageSwitch(sentURL)
		@web.PageHeader("入口", web.T(ctx, msgCheckEmail), today) {
			<p class="lede">{ web.T(ctx, msgLinkOnItsWay) }</p>
		}
		@web.Hint() {
			{ web.T(ctx, msgOpenItHere) }
		}
		<p><a href="/sign-in">{ web.T(ctx, msgAnotherEmail) }</a></p>
	}
}

// confirmPage asks for one click before redeeming a magic link, so a mail
// scanner opening the link can't use it up. u is the link, which switching
// Language keeps.
templ confirmPage(u *url.URL, today time.Time, tokenHash, kind string) {
	@web.Layout(web.T(ctx, msgSignInTitle), web.SignedOut) {
		@web.LanguageSwitch(u)
		@web.PageHeader("入口", web.T(ctx, msgSignIn), today)
		<form id="confirm" class="stack" method="post" action="/auth/confirm">
			<input type="hidden" name="token_hash" value={ tokenHash }/>
			<input type="hidden" name="type" value={ kind }/>
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgSignInTo) }
				}
			}
		</form>
	}
}
