package today

import (
	"context"
	"fmt"
	"slices"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/kitchen"
	"github.com/simopzz/dandori/internal/planning"
	"github.com/simopzz/dandori/internal/web"
)

// page is Today at `now`: a Delivery due that day, what to start preparing, the Slot now
// or next, the day's later Slots a click away, each with what fills it, where a
// Delivery's lines go, tonight's thaws, what Dandori assumed since the User last looked,
// what to do next about planning, where the Plan will show and what planning needs (no
// Plan yet), and how up to date it is.
templ page(now time.Time, d Day) {
	@web.Layout(web.T(ctx, msgTodayTitle), web.TodayTab) {
		@web.PageHeader("今日", web.T(ctx, msgToday), now)
		if d.Due != nil {
			@deliveryDue(d.Due)
		}
		@startPreparing(now, d)
		@web.Section(1, firstText(ctx, now, d)) {
			@web.Rows() {
				@slotRow(d.Filled[0], d.Times)
			}
		}
		if len(d.Slots.Later) > 0 {
			@web.Disclosure(web.T(ctx, msgLaterToday), false) {
				@web.Rows() {
					for _, f := range d.Filled[1:] {
						@slotRow(f, d.Times)
					}
				}
			}
		}
		if d.PutAway != nil {
			@putAway(d.PutAway)
		}
		if len(d.Thaws) > 0 {
			@thaws(d)
		}
		if len(d.Assumed.Days) > 0 {
			@assumedList(d)
		}
		if d.PutAway != nil || len(d.Assumed.Days) > 0 {
			@kitchen.StockItemSheets()
		}
		@reminders(d)
		<div class="section">
			@web.Empty() {
				{ web.T(ctx, msgNoPlan) }
			}
			@web.Rows() {
				for _, step := range setUp {
					@web.Row() {
						<a class="row-title" href={ templ.SafeURL(step.href) }>{ web.T(ctx, step.text) }</a>
					}
				}
			}
		</div>
		@kitchen.Status(now, d.Beat, d.Beaten)
	}
}

// deliveryDue says `c`'s Delivery is due today, in its window, linking its Grocery List,
// and that it isn't marked ordered yet while it is tentative.
templ deliveryDue(c *planning.Cycle) {
	<div class="section">
		@web.Rows() {
			@web.Row() {
				@web.Icon("list")
				<a class="row-title" href={ templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/grocery-list", c.ID)) }>
					{ web.Tf(ctx, msgDeliveryToday, web.Time(ctx, c.Delivery.Starts()), web.Time(ctx, c.Delivery.Arrives())) }
				</a>
				if c.Delivery.State == domain.Tentative {
					<span class="row-meta">{ web.T(ctx, msgNotOrderedYet) }</span>
				}
			}
		}
	</div>
}

// putAwayID is the id of Today's put-away list, which every write to the Kitchen
// Ledger refreshes.
const putAwayID = "put-away"

// putAway is Today's put-away list, listed again after each write to the Kitchen Ledger.
// The sheets its Counts and moves open are the page's, outside it so a swap leaves an
// open one be.
templ putAway(p *PutAway) {
	<div id={ putAwayID } hx-get="/today/put-away" hx-trigger={ kitchen.MovementSaved + " from:body" }>
		@putAwayList(p)
	</div>
}

// putAwayList is where each line of `p`'s Delivery goes, a freezer split as two, each
// with the Count and move of its Stock Item, which land back on Today: unavailable until
// the Delivery arrives, and a move while the Stock Item holds nothing. With no `p`, it
// is nothing.
templ putAwayList(p *PutAway) {
	if p != nil {
		@web.Section(2, web.T(ctx, msgPutAway)) {
			if !p.Arrived {
				@web.Hint() {
					{ web.T(ctx, msgPutAwayLater) }
				}
			}
			@web.Rows() {
				for _, l := range p.Lines {
					@web.Row() {
						@web.RowTitle(l.Ingredient.Name, false, "", false)
						@web.QuantityFigure(l.Quantity, l.Ingredient.Unit)
						<span class="row-meta">{ web.T(ctx, web.InLocations[l.Location]) }</span>
						@kitchen.StockItemActions(l.Ingredient, l.Location, kitchen.BackToToday, p.Arrived, p.Kitchen.Holds(l.Key()))
					}
				}
			}
		}
	}
}

// thaws are what tonight takes out of the freezer, a row each: what, how much of a Stock
// Item, and the Slot tomorrow it is for. It numbers its section after the
// put-away list's.
templ thaws(d Day) {
	@web.Section(sectionAfter(d.PutAway != nil), web.T(ctx, msgThawTonight)) {
		@web.Rows() {
			for _, t := range d.Thaws {
				@web.Row() {
					if p, ok := t.Portion(); ok {
						@web.RowTitle(p.Name, false, "", false)
					} else if ing, quantity, ok := t.Ingredient(); ok {
						@web.RowTitle(ing.Name, false, "", false)
						@web.QuantityFigure(quantity, ing.Unit)
					}
					<span class="row-meta">{ web.Tf(ctx, msgForTomorrow, web.T(ctx, web.SlotKindNames[t.For().Kind])) }</span>
				}
			}
		}
	}
}

// reminders are what Today reminds the User to do next about planning, a row each led by
// the icon of the page it links to: how planning the current Cycle and the next stand,
// ordering the next Delivery from its Grocery List, then opening a Cycle, the first or
// the next, or setting the Targets first.
templ reminders(d Day) {
	if len(d.Reminders) > 0 || d.OrderNext != 0 || d.Offer != NoOffer {
		<div class="section">
			@web.Rows() {
				for _, r := range d.Reminders {
					@standingRow(r)
				}
				if d.OrderNext != 0 {
					@web.Row() {
						@web.Icon("list")
						<a class="row-title" href={ templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/grocery-list", d.OrderNext)) }>{ web.T(ctx, msgOrderingNext) }</a>
					}
				}
				if o, ok := offers[d.Offer]; ok {
					@web.Row() {
						@web.Icon(o.icon)
						<a class="row-title" href={ templ.SafeURL(o.href) }>{ web.T(ctx, o.text) }</a>
					}
				}
			}
		</div>
	}
}

// standingRow says how planning `r`'s Cycle stands, linking to its Cycle page, straight
// to the Plan Proposal when one is waiting. A failed one is urgent: the seal, not the
// Plan page's icon, and an accent Tag.
templ standingRow(r Reminder) {
	{{ says, failed := standings[r.Standing], r.Standing == planning.PlanningFailed }}
	@web.Row() {
		if failed {
			@web.Seal()
		} else {
			@web.Icon("calendar")
		}
		<a class="row-title" href={ standingURL(r) }>
			if r.Next {
				{ web.T(ctx, says.next) }
			} else {
				{ web.T(ctx, says.current) }
			}
		</a>
		if failed {
			@web.Tag(true, "") {
				{ web.T(ctx, msgFailed) }
			}
		}
	}
}

// standingURL is the Cycle page of `r`'s Cycle, at its Plan Proposal when one is waiting.
func standingURL(r Reminder) templ.SafeURL {
	url := fmt.Sprintf("/plan/cycles/%d", r.CycleID)
	if r.Standing == planning.ProposalWaiting {
		url += "#" + planning.ProposalSectionID
	}
	return templ.SafeURL(url)
}

// firstText says which Slot is now, or next, and its time of day, as Data: tomorrow's,
// once the day's last is past.
func firstText(ctx context.Context, now time.Time, d Day) string {
	first := d.Slots.First
	kind, at := web.T(ctx, web.SlotKindNames[first.Kind]), web.Data(web.TimeOfDay(ctx, first.TimeOfDay(d.Times)))
	switch {
	case d.Slots.Now:
		return web.Tf(ctx, msgNowAt, kind, at)
	case first.On.After(now):
		return web.Tf(ctx, msgNextTomorrowAt, kind, at)
	default:
		return web.Tf(ctx, msgNextAt, kind, at)
	}
}

// startPreparing is a line for each Prep Session of a Recipe whose start time has come
// and whose Slot's time hasn't, at the top of Today, whichever Slot is next: nothing when
// none is.
templ startPreparing(now time.Time, d Day) {
	{{ var starting []templ.Component }}
	for _, f := range d.Filled {
		for _, ps := range f.Sessions {
			if ps.Preparing(now, d.Times) {
				{{ starting = append(starting, startLine(f.Slot, ps.PrepSession)) }}
			}
		}
	}
	if len(starting) > 0 {
		<div class="section">
			@web.Rows() {
				for _, line := range starting {
					@line
				}
			}
		</div>
	}
}

// startLine is the line saying to start preparing `ps` for the Slot `s`, led by its
// kind's icon.
templ startLine(s domain.Slot, ps domain.PrepSession) {
	@web.Row() {
		@web.Icon(string(s.Kind))
		<span class="row-title">{ web.Tf(ctx, msgStartPreparing, ps.Name(), web.T(ctx, web.SlotKindNames[s.Kind])) }</span>
	}
}

// slotRow is the Slot of `f` at its time by `times`: the Portion filling it and where it
// comes from, and when to start its Prep Sessions of a Recipe, if it has one, opening to
// their Ingredients, each with where it is taken from, and a link to each Recipe. A Slot
// with such a Prep Session and no Portion takes the Prep Session's name; a Slot with
// neither is its kind and time.
templ slotRow(f planning.Filled, times domain.Times) {
	{{ when := web.Time(ctx, f.Slot.At(times)) }}
	{{ cooked := recipesOf(f.Sessions) }}
	if len(cooked) > 0 {
		{{ title, from := f.Name, source(ctx, f) }}
		if title == "" {
			{{ title, from = cooked[0].Name(), "" }}
		}
		{{ start, _ := cooked[0].Start(times) }}
		@web.FoldRow(web.SlotLine(f.Slot.Kind, when, title, false, "", nil, from, web.Tf(ctx, msgStartAt, web.Time(ctx, start)))) {
			for _, ps := range cooked {
				@web.RowsHead(ps.Name())
				@web.IngredientRowsWith(ps.Ingredients(), nil, places(ps.TakesFrom))
				@web.TextLink(templ.Attributes{"href": fmt.Sprintf("/recipes/%d", ps.Recipe.ID)}) {
					{ web.T(ctx, msgRecipeSteps) }
				}
			}
		}
	} else if f.Name != "" {
		@web.SlotRow(f.Slot.Kind, when, f.Name, false, "", nil, source(ctx, f))
	} else {
		@web.Row() {
			<span class="row-title">{ web.T(ctx, web.SlotKindNames[f.Slot.Kind]) }</span>
			<span class="row-figure">{ when }</span>
		}
	}
}

// places is the Storage Locations each Ingredient is taken from by `from`, as a row's
// details: "not in the kitchen" for one held nowhere, nothing for a Staple or once `from`
// is nil, its Slot's time passed.
func places(from map[int64][]domain.StorageLocation) func(domain.Ingredient) templ.Component {
	return func(ing domain.Ingredient) templ.Component {
		locations, ok := from[ing.ID]
		if !ok {
			return nil
		}
		return placesText(locations)
	}
}

// placesText is the Storage Locations `locations`, in a sentence, or "not in the kitchen"
// for none.
templ placesText(locations []domain.StorageLocation) {
	if len(locations) == 0 {
		{ web.T(ctx, msgNotInTheKitchen) }
	} else {
		{{ var words []string }}
		for _, l := range locations {
			{{ words = append(words, web.T(ctx, web.InLocations[l])) }}
		}
		{ strings.Join(words, ", ") }
	}
}

// recipesOf are those of `sessions` preparing a Recipe, the one starting earliest first.
func recipesOf(sessions []planning.Session) []planning.Session {
	var out []planning.Session
	for _, ps := range sessions {
		if ps.Recipe != nil {
			out = append(out, ps)
		}
	}
	slices.SortStableFunc(out, func(a, b planning.Session) int { return b.Recipe.TotalMinutes - a.Recipe.TotalMinutes })
	return out
}

// source says where `f`'s Portion comes from: not in the kitchen when the kitchen doesn't
// hold it, already in it, cooked then or set out at its Slot, or from an earlier Slot of
// its day, or an earlier day, and where it is kept.
func source(ctx context.Context, f planning.Filled) string {
	switch {
	case f.Missing:
		return web.T(ctx, msgNotInTheKitchen)
	case f.From == nil:
		return web.T(ctx, msgInTheKitchen)
	case f.From.At.Equal(f.Slot) && f.From.Recipe != nil:
		return web.T(ctx, msgCookedThen)
	case f.From.At.Equal(f.Slot):
		ri := f.From.Ingredients()[0] // one without a Recipe sets out its one Ingredient
		return web.Tf(ctx, msgSetOut, web.Quantity(ctx, ri.Quantity, ri.Ingredient.Unit), ri.Ingredient.Name)
	case f.From.At.On.Equal(f.Slot.On):
		return web.Tf(ctx, msgFromEarlier, web.T(ctx, web.SlotKindNames[f.From.At.Kind]), web.T(ctx, web.InLocations[f.Location]))
	}
	return web.Tf(ctx, msgFromEarlier, web.ShortDate(ctx, f.From.At.On), web.T(ctx, web.InLocations[f.Location]))
}

// sectionAfter is the number of a Section after the first Slot's and each of the numbered
// ones before it that `shown` says Today shows.
func sectionAfter(shown ...bool) int {
	num := 2
	for _, ok := range shown {
		if ok {
			num++
		}
	}
	return num
}

// assumedList is what Dandori assumed since the User last looked, by day, oldest first: a
// row per Slot summing up its Movements, and the evening's thaws in a row of their own,
// each opening to its Movements, each a link to the Stock Item or Portion Lot it touched.
// It numbers its section after the thaws'.
templ assumedList(d Day) {
	@web.Section(sectionAfter(d.PutAway != nil, len(d.Thaws) > 0), web.T(ctx, msgSinceYouLooked)) {
		for _, day := range d.Assumed.Days {
			@web.RowsHead(web.Date(ctx, day.On))
			@web.Rows() {
				for _, r := range day.Rows {
					@web.FoldRow(web.SlotLine(r.Slot.Kind, web.Time(ctx, r.Slot.At(d.Times)), assumedTitle(ctx, d.Assumed, r), false, "", nil, forTomorrow(ctx, r))) {
						@web.Rows() {
							for _, m := range r.Movements {
								@assumedMovement(d.Assumed, m)
							}
						}
					}
				}
			}
		}
	}
}

// forTomorrow says a row of thaws is for the next day's Slots, and nothing of a Slot's.
func forTomorrow(ctx context.Context, r domain.AssumedRow) string {
	if !r.Thaws {
		return ""
	}
	return web.T(ctx, msgForTomorrowsSlots)
}

// assumedMovement is `m`, a Movement `a` lists: what it touched, a link to its Movements,
// how much, its cause and where it left it.
templ assumedMovement(a Assumed, m domain.Movement) {
	@web.Row() {
		<span class="row-title">
			@kitchen.MovementsLink(m) {
				{ touched(a, m) }
			}
		</span>
		if len(m.Portions) > 0 {
			<span class="row-figure">{ web.Tf(ctx, web.TimesCount, len(m.Portions)) }</span>
		} else {
			@web.QuantityFigure(max(m.Change, -m.Change), a.Ingredients[m.Key.Ingredient].Unit)
		}
		<span class="row-meta">
			<span>{ kitchen.CauseName(ctx, m.Cause) }</span>
			<span>{ web.T(ctx, web.InLocations[kitchen.LeftIn(m)]) }</span>
		</span>
	}
}

// touched is the name of what `m` touched: its first Portion's, or its Ingredient's.
func touched(a Assumed, m domain.Movement) string {
	if len(m.Portions) > 0 {
		return a.PortionNames[m.Portions[0]]
	}
	return a.Ingredients[m.Key.Ingredient].Name
}

// assumedTitle sums up `r`: for a Slot, each Prep Session it prepared, how many of its
// Portions the Slot ate and how many it kept, then each Portion from earlier it ate, or
// its kind when it only used up stock; for the evening's thaws, what each took out of
// the freezer.
func assumedTitle(ctx context.Context, a Assumed, r domain.AssumedRow) string {
	var parts []string
	if r.Thaws {
		for _, m := range r.Movements {
			if name := touched(a, m); !slices.Contains(parts, name) {
				parts = append(parts, name)
			}
		}
		return web.Tf(ctx, msgOutOfTheFreezer, strings.Join(parts, ", "))
	}
	for _, p := range r.Summary() {
		name := a.PortionNames[p.Portion]
		if p.Prepared == 0 {
			parts = append(parts, web.Tf(ctx, msgEatenPart, name))
			continue
		}
		part := []string{web.Tf(ctx, msgPreparedPart, name)}
		if p.Eaten > 0 {
			part = append(part, web.Tf(ctx, msgEatenCount, p.Eaten))
		}
		if kept := p.Prepared - p.Eaten; kept > 0 {
			part = append(part, web.Tf(ctx, msgKeptCount, kept))
		}
		parts = append(parts, strings.Join(part, ", "))
	}
	if len(parts) == 0 {
		return web.Capitalised(web.T(ctx, web.SlotKindNames[r.Slot.Kind]))
	}
	return strings.Join(parts, "; ")
}
