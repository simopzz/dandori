package today

import (
	"context"
	"fmt"
	"time"

	"github.com/simopzz/dandori/internal/kitchen"
	"github.com/simopzz/dandori/internal/planning"
	"github.com/simopzz/dandori/internal/web"
)

// page is Today at `now`: the Slot now or next, the day's later Slots a click away, what
// to do next about planning, where the Plan will show and what planning needs (no Plan
// yet), and how up to date it is.
templ page(now time.Time, d Day) {
	@web.Layout(web.T(ctx, msgTodayTitle), web.TodayTab) {
		@web.PageHeader("今日", web.T(ctx, msgToday), now)
		@web.Section(1, firstText(ctx, now, d))
		if len(d.Slots.Later) > 0 {
			@web.Disclosure(web.T(ctx, msgLaterToday), false) {
				@web.Rows() {
					for _, s := range d.Slots.Later {
						@web.Row() {
							<span class="row-title">{ web.T(ctx, web.SlotKindNames[s.Kind]) }</span>
							<span class="row-figure">{ web.TimeOfDay(ctx, d.Times[s.Kind]) }</span>
						}
					}
				}
			}
		}
		if d.PutAway != nil {
			@putAway(d.PutAway)
		}
		@reminders(d)
		<div class="section">
			@web.Empty() {
				{ web.T(ctx, msgNoPlan) }
			}
			@web.Rows() {
				for _, step := range setUp {
					@web.Row() {
						<a class="row-title" href={ templ.SafeURL(step.href) }>{ web.T(ctx, step.text) }</a>
					}
				}
			}
		</div>
		@kitchen.Status(now, d.Beat, d.Beaten)
	}
}

// putAwayID is the id of Today's put-away list, which every write to the Kitchen
// Ledger refreshes.
const putAwayID = "put-away"

// putAway is Today's put-away list, listed again after each write to the Kitchen Ledger,
// and the sheets its Counts and moves open, outside it so a swap leaves an open one be.
templ putAway(p *PutAway) {
	<div id={ putAwayID } hx-get="/today/put-away" hx-trigger={ kitchen.MovementSaved + " from:body" }>
		@putAwayList(p)
	</div>
	@kitchen.StockItemSheets()
}

// putAwayList is where each line of `p`'s Delivery goes, a freezer split as two, each
// with the Count and move of its Stock Item, which land back on Today: unavailable until
// the Delivery arrives, and a move while the Stock Item holds nothing. With no `p`, it
// is nothing.
templ putAwayList(p *PutAway) {
	if p != nil {
		@web.Section(2, web.T(ctx, msgPutAway)) {
			if !p.Arrived {
				@web.Hint() {
					{ web.T(ctx, msgPutAwayLater) }
				}
			}
			@web.Rows() {
				for _, l := range p.Lines {
					@web.Row() {
						<span class="row-title">{ l.Ingredient.Name }</span>
						<span class="row-figure">{ web.Quantity(ctx, l.Quantity, l.Ingredient.Unit) }</span>
						<span class="row-meta">{ web.T(ctx, web.InLocations[l.Location]) }</span>
						@kitchen.StockItemActions(l.Ingredient, l.Location, kitchen.BackToToday, p.Arrived, p.Kitchen.Holds(l.Key()))
					}
				}
			}
		}
	}
}

// reminders are what Today reminds the User to do next about planning, a row each led by
// the icon of the page it links to: how planning the current Cycle and the next stand,
// ordering the next Delivery from its Grocery List, then opening a Cycle, the first or
// the next, or setting the Targets first.
templ reminders(d Day) {
	if len(d.Reminders) > 0 || d.OrderNext != 0 || d.Offer != NoOffer {
		<div class="section">
			@web.Rows() {
				for _, r := range d.Reminders {
					@standingRow(r)
				}
				if d.OrderNext != 0 {
					@web.Row() {
						@web.Icon("list")
						<a class="row-title" href={ templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/grocery-list", d.OrderNext)) }>{ web.T(ctx, msgOrderingNext) }</a>
					}
				}
				if o, ok := offers[d.Offer]; ok {
					@web.Row() {
						@web.Icon(o.icon)
						<a class="row-title" href={ templ.SafeURL(o.href) }>{ web.T(ctx, o.text) }</a>
					}
				}
			}
		</div>
	}
}

// standingRow says how planning `r`'s Cycle stands, linking to its Cycle page, straight
// to the Plan Proposal when one is waiting. A failed one is urgent: the seal, not the
// Plan page's icon, and an accent Tag.
templ standingRow(r Reminder) {
	{{ says, failed := standings[r.Standing], r.Standing == planning.PlanningFailed }}
	@web.Row() {
		if failed {
			@web.Seal()
		} else {
			@web.Icon("calendar")
		}
		<a class="row-title" href={ standingURL(r) }>
			if r.Next {
				{ web.T(ctx, says.next) }
			} else {
				{ web.T(ctx, says.current) }
			}
		</a>
		if failed {
			@web.Tag(true, "") {
				{ web.T(ctx, msgFailed) }
			}
		}
	}
}

// standingURL is the Cycle page of `r`'s Cycle, at its Plan Proposal when one is waiting.
func standingURL(r Reminder) templ.SafeURL {
	url := fmt.Sprintf("/plan/cycles/%d", r.CycleID)
	if r.Standing == planning.ProposalWaiting {
		url += "#" + planning.ProposalSectionID
	}
	return templ.SafeURL(url)
}

// firstText says which Slot is now, or next, and its time of day, as Data: tomorrow's,
// once the day's last is past.
func firstText(ctx context.Context, now time.Time, d Day) string {
	first := d.Slots.First
	kind, at := web.T(ctx, web.SlotKindNames[first.Kind]), web.Data(web.TimeOfDay(ctx, d.Times[first.Kind]))
	switch {
	case d.Slots.Now:
		return web.Tf(ctx, msgNowAt, kind, at)
	case first.On.After(now):
		return web.Tf(ctx, msgNextTomorrowAt, kind, at)
	default:
		return web.Tf(ctx, msgNextAt, kind, at)
	}
}
