package profile

import (
	"context"
	"net/url"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// LanguageForm is a Language choice as shown: the Language chosen, and why a choice
// was rejected.
type LanguageForm struct {
	Language domain.Language
	Err      web.Message
}

// languageChoices are the Languages to choose from, each named in itself.
func languageChoices(ctx context.Context) []web.Choice {
	var choices []web.Choice
	for _, l := range domain.Languages {
		choices = append(choices, web.Choice{Value: string(l), Label: web.T(ctx, web.LanguageNames[l])})
	}
	return choices
}

var choiceURL = &url.URL{Path: "/language"}

// choicePage asks a User at their first sign-in for their Language, before anything else.
// It switches Language like the pages before it.
templ choicePage(today time.Time, f LanguageForm) {
	@web.Layout(web.T(ctx, msgChooseTitle), web.SignedOut) {
		@web.LanguageSwitch(choiceURL)
		@web.PageHeader("言語", web.T(ctx, msgChooseLanguage), today) {
			<p class="lede">{ web.T(ctx, msgChooseLede) }</p>
		}
		<form novalidate id="language" class="stack" method="post" action="/language">
			@web.Segmented(web.T(ctx, msgLanguage), "language", languageChoices(ctx), string(f.Language), web.T(ctx, f.Err))
			@web.Hint() {
				{ web.T(ctx, msgChooseHint) }
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgContinue) }
				}
			}
		</form>
	}
}

// profileForms are the Profile page's sections as shown: each as saved, but for one
// refused, shown as typed.
type profileForms struct {
	Language LanguageForm
	Times    TimesForm
	Targets  TargetsForm
	MealOut  MealOutForm
	Foods    FoodsForm
	Brief    string
}

// TargetsForm is the Targets as shown, by field: as saved or as typed, with why each
// field was refused. Set is whether the User has saved theirs.
type TargetsForm struct {
	Values, Errs map[string]string
	Set          bool
}

// TimesForm is the time of day of each kind of Slot as shown, by SlotKind: as saved or as
// typed, with why each field was refused.
type TimesForm struct {
	Values, Errs map[string]string
}

// MealOutForm is the Meal Out estimate as shown, by field: as saved or as typed, with
// why each field was refused. An unknown fibre or sugar is blank, never 0.
type MealOutForm struct {
	Values, Errs map[string]string
}

// FoodsForm is the exclusions and allergies as saved, each normalised.
type FoodsForm struct {
	Exclusions, Allergies []string
}

// section is a section of the Profile page that is saved on its own: its number on the
// page, its legend, what its button says, and its id, which also names its form and the
// route it posts to. One that reloads posts as the page's boosted forms do, the page
// it answers with replacing it, where the others swap their SectionBody.
type section struct {
	id     string
	num    int
	legend web.Message
	save   web.Message
	reload bool
}

// route is where the section's form posts.
func (s section) route() string { return "/profile/" + s.id }

// The Profile page's sections, numbered in the order the page shows them: the Language
// first, and signing in last.
const signingInNum = 7

var (
	// The Language changes every word on the page, so its section reloads it.
	languageSection = section{id: "language", num: 1, legend: msgLanguage, save: msgSaveLanguage, reload: true}
	timesSection    = section{id: "times", num: 2, legend: msgTimesOfDay, save: msgSaveTimes}
	targetsSection  = section{id: "targets", num: 3, legend: msgTargets, save: msgSaveTargets}
	mealOutSection  = section{id: "meal-out", num: 4, legend: msgMealOut, save: msgSaveMealOut}
	foodsSection    = section{id: "foods", num: 5, legend: msgFoods, save: msgSaveFoods}
	briefSection    = section{id: "brief", num: 6, legend: msgBrief, save: msgSaveBrief}
)

// profilePage is the User's Profile: their Language, the time of day of each kind of
// Slot, their Targets, their Meal Out estimate, their exclusions and allergies, their
// Planning Brief, and who is signed in.
templ profilePage(today time.Time, email string, forms profileForms) {
	@web.Layout(web.T(ctx, msgProfileTitle), web.ProfileTab) {
		@web.PageHeader("設定", web.T(ctx, msgProfile), today)
		@sectionForm(languageSection) {
			@web.Segmented(web.T(ctx, msgLanguage), "language", languageChoices(ctx), string(forms.Language.Language), web.T(ctx, forms.Language.Err))
			@web.Hint() {
				{ web.T(ctx, msgChooseHint) }
			}
		}
		@web.SectionBody(timesSection.id) {
			@timesForm(forms.Times)
		}
		@web.SectionBody(targetsSection.id) {
			@targetsForm(forms.Targets)
		}
		@web.SectionBody(mealOutSection.id) {
			@mealOutForm(forms.MealOut)
		}
		@web.SectionBody(foodsSection.id) {
			@foodsForm(forms.Foods)
		}
		@web.SectionBody(briefSection.id) {
			@briefForm(forms.Brief)
		}
		@web.Section(signingInNum, web.T(ctx, msgSigningIn)) {
			<form novalidate id="sign-out" method="post" action="/sign-out">
				@web.Hint() {
					{ web.Tf(ctx, msgSignedInAs, email) } ·
					@web.TextButton(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSignOut) }
					}
				}
			</form>
		}
		// Runs is no bottom tab on a phone, so the Profile links it.
		<p class="section"><a href="/runs">{ web.T(ctx, msgOpenRuns) }</a></p>
	}
}

// sectionForm is the section s, its fields and hints the children, followed by the button
// that saves it, named for it: a form posting to its own route, which htmx swaps in its
// SectionBody unless s reloads the page.
templ sectionForm(s section) {
	<form
		novalidate
		id={ "profile-" + s.id }
		method="post"
		action={ templ.SafeURL(s.route()) }
		if !s.reload {
			hx-post={ s.route() }
			hx-target={ "#" + s.id }
			hx-swap="innerHTML"
		}
	>
		@web.FieldGroup(s.num, web.T(ctx, s.legend)) {
			<div class="stack">
				{ children... }
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, s.save) }
					}
				}
			</div>
		}
	</form>
}

// targetsForm is the Targets section. Until the User has saved their Targets, it says
// planning needs them.
templ targetsForm(f TargetsForm) {
	@sectionForm(targetsSection) {
		if !f.Set {
			@web.Hint() {
				{ web.T(ctx, msgTargetsNeeded) }
			}
		}
		@web.FieldRow() {
			@targetField(msgKcal, msgKcalHint, domain.TargetKcal, f)
			@targetField(msgTolerance, msgToleranceHint, domain.TargetTolerance, f)
		}
		@web.FieldRow() {
			@targetField(msgProtein, msgFloorHint, domain.TargetProtein, f)
			@targetField(msgFibre, msgFloorHint, domain.TargetFibre, f)
			@targetField(msgSugar, msgCeilingHint, domain.TargetSugar, f)
		}
		@web.Hint() {
			{ web.T(ctx, msgCarbsAndFat) }
		}
	}
}

// targetField is the Target named field, a whole number, labelled label with its unit
// and direction in hint.
templ targetField(label, hint web.Message, field string, f TargetsForm) {
	@web.Field(web.T(ctx, label), web.T(ctx, hint), f.Errs[field]) {
		<input
			type="number"
			inputmode="numeric"
			step="1"
			name={ field }
			value={ f.Values[field] }
			required
			autocomplete="off"
			if f.Errs[field] != "" {
				aria-invalid="true"
			}
		/>
	}
}

// timesForm is the times-of-day section.
templ timesForm(f TimesForm) {
	@sectionForm(timesSection) {
		@web.FieldRow() {
			for _, k := range domain.SlotKinds {
				@web.TimeField(web.Capitalised(web.T(ctx, web.SlotKindNames[k])), string(k), f.Values[string(k)], f.Errs[string(k)])
			}
		}
	}
}

// mealOutForm is the Meal Out estimate's section.
templ mealOutForm(f MealOutForm) {
	@sectionForm(mealOutSection) {
		@web.Hint() {
			{ web.T(ctx, msgMealOutHint) }
		}
		@web.FieldRow() {
			@mealOutField(msgKcal, msgKcalUnit, domain.MealOutKcal, f)
			@mealOutField(msgProtein, msgGrams, domain.MealOutProtein, f)
			@mealOutField(msgCarbs, msgGrams, domain.MealOutCarbs, f)
		}
		@web.FieldRow() {
			@mealOutField(msgFat, msgGrams, domain.MealOutFat, f)
			@mealOutField(msgFibre, msgFibreHint, domain.MealOutFibre, f)
			@mealOutField(msgSugar, msgSugarHint, domain.MealOutSugar, f)
		}
	}
}

// mealOutField is the Meal Out estimate's value named field, a whole number from 0,
// labelled label with its unit in hint, which says so when it may be left blank.
templ mealOutField(label, hint web.Message, field string, f MealOutForm) {
	@web.Field(web.T(ctx, label), web.T(ctx, hint), f.Errs[field]) {
		<input
			type="number"
			inputmode="numeric"
			step="1"
			min="0"
			name={ field }
			value={ f.Values[field] }
			required?={ domain.MealOutRequired(field) }
			autocomplete="off"
			if f.Errs[field] != "" {
				aria-invalid="true"
			}
		/>
	}
}

// foodsForm is the exclusions-and-allergies section, each list shown one food per line.
templ foodsForm(f FoodsForm) {
	@sectionForm(foodsSection) {
		@web.Hint() {
			{ web.T(ctx, msgFoodsHint) }
		}
		@web.Field(web.T(ctx, msgExclusions), web.T(ctx, msgExclusionsHint), "") {
			<textarea name="exclusions" rows="4">{ strings.Join(f.Exclusions, "\n") }</textarea>
		}
		@web.Field(web.T(ctx, msgAllergies), web.T(ctx, msgAllergiesHint), "") {
			<textarea name="allergies" rows="4">{ strings.Join(f.Allergies, "\n") }</textarea>
		}
	}
}

// briefForm is the Planning Brief's section, its example only a placeholder the planner
// never reads.
templ briefForm(brief string) {
	@sectionForm(briefSection) {
		@web.Hint() {
			{ web.T(ctx, msgBriefHint) }
		}
		@web.Field(web.T(ctx, msgWishes), web.T(ctx, msgWishesHint), "") {
			<textarea name="brief" rows="5" placeholder={ web.T(ctx, msgBriefPlaceholder) }>{ brief }</textarea>
		}
	}
}
