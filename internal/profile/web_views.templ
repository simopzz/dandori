package profile

import (
	"context"
	"net/url"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// LanguageForm is a Language choice as shown: the Language chosen, and why a choice
// was rejected.
type LanguageForm struct {
	Language domain.Language
	Err      web.Message
}

// languageChoices are the Languages to choose from, each named in itself.
func languageChoices(ctx context.Context) []web.Choice {
	var choices []web.Choice
	for _, l := range domain.Languages {
		choices = append(choices, web.Choice{Value: string(l), Label: web.T(ctx, web.LanguageNames[l])})
	}
	return choices
}

var choiceURL = &url.URL{Path: "/language"}

// choicePage asks a User at their first sign-in for their Language, before anything else.
// It switches Language like the pages before it.
templ choicePage(today time.Time, f LanguageForm) {
	@web.Layout(web.T(ctx, msgChooseTitle), web.SignedOut) {
		@web.LanguageSwitch(choiceURL)
		@web.PageHeader("言語", web.T(ctx, msgChooseLanguage), today) {
			<p class="lede">{ web.T(ctx, msgChooseLede) }</p>
		}
		<form id="language" class="stack" method="post" action="/language">
			@web.Segmented(web.T(ctx, msgLanguage), "language", languageChoices(ctx), string(f.Language), web.T(ctx, f.Err))
			@web.Hint() {
				{ web.T(ctx, msgChooseHint) }
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgContinue) }
				}
			}
		</form>
	}
}

// TargetsForm is the Targets as shown, by field: as saved or as typed, with why each
// field was refused. Set is whether the User has saved theirs.
type TargetsForm struct {
	Values, Errs map[string]string
	Set          bool
}

// targetsSectionID is the element the Targets form swaps when htmx posts it.
const targetsSectionID = "targets"

// TimesForm is the time of day of each kind of Slot as shown, by SlotKind: as saved or as
// typed, with why each field was refused.
type TimesForm struct {
	Values, Errs map[string]string
}

// timesSectionID is the element the times-of-day form swaps when htmx posts it.
const timesSectionID = "times"

// MealOutForm is the Meal Out estimate as shown, by field: as saved or as typed, with
// why each field was refused. An unknown fibre or sugar is blank, never 0.
type MealOutForm struct {
	Values, Errs map[string]string
}

// mealOutSectionID is the element the Meal Out form swaps when htmx posts it.
const mealOutSectionID = "meal-out"

// profilePage is the User's Profile: their Language, the time of day of each kind of
// Slot, their Targets, their Meal Out estimate, and who is signed in.
templ profilePage(today time.Time, email string, f LanguageForm, targets TargetsForm, times TimesForm, mealOut MealOutForm) {
	@web.Layout(web.T(ctx, msgProfileTitle), web.ProfileTab) {
		@web.PageHeader("設定", web.T(ctx, msgProfile), today)
		<form id="profile-language" method="post" action="/profile/language">
			@web.FieldGroup(1, web.T(ctx, msgLanguage)) {
				@web.Segmented(web.T(ctx, msgLanguage), "language", languageChoices(ctx), string(f.Language), web.T(ctx, f.Err))
				@web.Hint() {
					{ web.T(ctx, msgChooseHint) }
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSave) }
					}
				}
			}
		</form>
		@web.SectionBody(timesSectionID) {
			@timesForm(times)
		}
		@web.SectionBody(targetsSectionID) {
			@targetsForm(targets)
		}
		@web.SectionBody(mealOutSectionID) {
			@mealOutForm(mealOut)
		}
		@web.Section(5, web.T(ctx, msgSigningIn)) {
			<form id="sign-out" method="post" action="/sign-out">
				@web.Hint() {
					{ web.Tf(ctx, msgSignedInAs, email) } ·
					@web.TextButton(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSignOut) }
					}
				}
			</form>
		}
	}
}

// targetsForm is the Targets section, swapping itself when htmx posts it. Until the User
// has saved their Targets, it says planning needs them.
templ targetsForm(f TargetsForm) {
	<form
		id="profile-targets"
		method="post"
		action="/profile/targets"
		hx-post="/profile/targets"
		hx-target={ "#" + targetsSectionID }
		hx-swap="innerHTML"
	>
		@web.FieldGroup(3, web.T(ctx, msgTargets)) {
			<div class="stack">
				if !f.Set {
					@web.Hint() {
						{ web.T(ctx, msgTargetsNeeded) }
					}
				}
				@web.FieldRow() {
					@targetField(msgKcal, msgKcalHint, domain.TargetKcal, f)
					@targetField(msgTolerance, msgToleranceHint, domain.TargetTolerance, f)
				}
				@web.FieldRow() {
					@targetField(msgProtein, msgFloorHint, domain.TargetProtein, f)
					@targetField(msgFibre, msgFloorHint, domain.TargetFibre, f)
					@targetField(msgSugar, msgCeilingHint, domain.TargetSugar, f)
				}
				@web.Hint() {
					{ web.T(ctx, msgCarbsAndFat) }
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSave) }
					}
				}
			</div>
		}
	</form>
}

// targetField is the Target named field, a whole number, labelled label with its unit
// and direction in hint.
templ targetField(label, hint web.Message, field string, f TargetsForm) {
	@web.Field(web.T(ctx, label), web.T(ctx, hint), f.Errs[field]) {
		<input
			type="number"
			inputmode="numeric"
			step="1"
			name={ field }
			value={ f.Values[field] }
			required
			autocomplete="off"
			if f.Errs[field] != "" {
				aria-invalid="true"
			}
		/>
	}
}

// timesForm is the times-of-day section, swapping itself when htmx posts it.
templ timesForm(f TimesForm) {
	<form
		id="profile-times"
		method="post"
		action="/profile/times"
		hx-post="/profile/times"
		hx-target={ "#" + timesSectionID }
		hx-swap="innerHTML"
	>
		@web.FieldGroup(2, web.T(ctx, msgTimesOfDay)) {
			<div class="stack">
				@web.FieldRow() {
					for _, k := range domain.SlotKinds {
						@web.TimeField(web.Capitalised(web.T(ctx, web.SlotKindNames[k])), string(k), f.Values[string(k)], f.Errs[string(k)])
					}
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSave) }
					}
				}
			</div>
		}
	</form>
}

// mealOutForm is the Meal Out estimate's section, swapping itself when htmx posts it.
templ mealOutForm(f MealOutForm) {
	<form
		id="profile-meal-out"
		method="post"
		action="/profile/meal-out"
		hx-post="/profile/meal-out"
		hx-target={ "#" + mealOutSectionID }
		hx-swap="innerHTML"
	>
		@web.FieldGroup(4, web.T(ctx, msgMealOut)) {
			<div class="stack">
				@web.Hint() {
					{ web.T(ctx, msgMealOutHint) }
				}
				@web.FieldRow() {
					@mealOutField(msgKcal, msgKcalUnit, "kcal", f)
					@mealOutField(msgProtein, msgGrams, "protein", f)
					@mealOutField(msgCarbs, msgGrams, "carbs", f)
				}
				@web.FieldRow() {
					@mealOutField(msgFat, msgGrams, "fat", f)
					@mealOutField(msgFibre, msgGrams, "fibre", f)
					@mealOutField(msgSugar, msgGrams, "sugar", f)
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgSave) }
					}
				}
			</div>
		}
	</form>
}

// mealOutField is the Meal Out estimate's value named field, a whole number from 0,
// labelled label with its unit; fibre and sugar may be left blank.
templ mealOutField(label, unit web.Message, field string, f MealOutForm) {
	@web.Field(web.T(ctx, label), web.T(ctx, unit), f.Errs[field]) {
		<input
			type="number"
			inputmode="numeric"
			step="1"
			min="0"
			name={ field }
			value={ f.Values[field] }
			required?={ field != "fibre" && field != "sugar" }
			autocomplete="off"
			if f.Errs[field] != "" {
				aria-invalid="true"
			}
		/>
	}
}
