package profile

import "github.com/simopzz/dandori/internal/web"

// ProfileForm is the Profile as the form shows it: the raw field values, so
// a rejected submission is shown back as typed, and an error per field.
type ProfileForm struct {
	Values map[string]string
	Errors map[string]string
	Saved  bool
	// Failed means the Profile was valid but could not be stored.
	Failed bool
}

// ProfilePage shows the Profile for viewing and editing.
templ ProfilePage(f ProfileForm) {
	@web.Layout("Dandori — Profile", web.TabProfile) {
		@web.PageHeader("設定", "Profile")
		@ProfileFormFragment(f)
	}
}

// ProfileFormFragment is the Profile form alone, which HTMX swaps in place
// after a submission.
templ ProfileFormFragment(f ProfileForm) {
	<form method="post" action="/profile" hx-post="/profile" hx-target="this" hx-swap="outerHTML">
		if f.Saved {
			@web.Notice() {
				Profile saved.
			}
		}
		if f.Failed {
			@web.Alert() {
				The Profile could not be saved; try again. Details are in the server log.
			}
		}
		if len(f.Errors) > 0 {
			@web.Alert() {
				The Profile was not saved; fix the fields marked below.
			}
		}
		@web.FieldGroup(1, "Daily Targets") {
			@nutritionFields(f, "target")
		}
		@web.FieldGroup(2, "Exclusions and allergies") {
			@web.Hint() {
				One food per line, or separated by commas. Recipes containing them are never planned.
			}
			<div class="stack">
				@foodField(f, "exclusions", "Never eat")
				@foodField(f, "allergies", "Allergies")
			</div>
		}
		@web.FieldGroup(3, "Meal Out estimate") {
			@web.Hint() {
				What one Meal Out is assumed to contain unless you say otherwise.
			}
			@nutritionFields(f, "meal_out")
		}
		@web.FieldGroup(4, "Untracked Allowance") {
			@web.Hint() {
				Eaten each day outside the Plan (coffee, snacks); reserved before Slots are filled.
			}
			@nutritionFields(f, "untracked")
		}
		@web.FieldGroup(5, "Slot times") {
			@web.Hint() {
				When each meal is eaten. A Cycle starts at the first meal after its Delivery arrives.
			}
			@web.FieldRow() {
				@timeInput(f, "breakfast_at", "Breakfast")
				@timeInput(f, "lunch_at", "Lunch")
				@timeInput(f, "snack_at", "Snack")
				@timeInput(f, "dinner_at", "Dinner")
			}
		}
		@web.Actions() {
			@web.Button(templ.Attributes{"type": "submit"}) {
				Save Profile
			}
		}
	</form>
}

templ nutritionFields(f ProfileForm, prefix string) {
	@web.FieldRow() {
		@numberInput(f, prefix+"_kcal", "Calories", "kcal")
		@numberInput(f, prefix+"_protein_g", "Protein", "g")
		@numberInput(f, prefix+"_carbs_g", "Carbs", "g")
		@numberInput(f, prefix+"_fat_g", "Fat", "g")
	}
}

templ numberInput(f ProfileForm, name, label, unit string) {
	@web.Field(label, unit, f.Errors[name]) {
		<input type="number" inputmode="numeric" min="0" step="1" required name={ name } value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}

templ foodField(f ProfileForm, name, label string) {
	@web.Field(label, "", f.Errors[name]) {
		<textarea name={ name } rows="3">{ f.Values[name] }</textarea>
	}
}

templ timeInput(f ProfileForm, name, label string) {
	@web.Field(label, "", f.Errors[name]) {
		<input type="time" required name={ name } value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}
