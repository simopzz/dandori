package profile

import "github.com/simopzz/dandori/internal/web"

// ProfileForm is the Profile as the form shows it: the raw field values, so
// a rejected submission is shown back as typed, and an error per field.
type ProfileForm struct {
	Values map[string]string
	Errors map[string]string
	Saved  bool
	// Failed means the Profile was valid but could not be stored.
	Failed bool
}

// BriefForm is the Planning Brief as its form shows it.
type BriefForm struct {
	Brief string
	Saved bool
	// Failed means the Planning Brief could not be stored: Brief is as typed.
	Failed bool
}

// ProfilePage shows the Profile and the Planning Brief for viewing and
// editing, each saved with its own form.
templ ProfilePage(f ProfileForm, b BriefForm) {
	@web.Layout("Dandori — Profile", web.TabProfile) {
		@web.PageHeader("設定", "Profile")
		<form method="post" action="/profile">
			if f.Saved {
				@web.Notice() {
					Profile saved.
				}
			}
			if f.Failed {
				@web.Alert() {
					The Profile could not be saved; try again. Details are in the server log.
				}
			}
			if len(f.Errors) > 0 {
				@web.Alert() {
					The Profile was not saved; fix the fields marked below.
				}
			}
			@web.FieldGroup(1, "Daily Targets") {
				@nutritionFields(f, "target")
			}
			@web.FieldGroup(2, "Exclusions and allergies") {
				@web.Hint() {
					One food per line, or separated by commas. Recipes containing them are never planned.
				}
				<div class="stack">
					@foodField(f, "exclusions", "Never eat")
					@foodField(f, "allergies", "Allergies")
				</div>
			}
			@web.FieldGroup(3, "Meal Out estimate") {
				@web.Hint() {
					What one Meal Out is assumed to contain unless you say otherwise.
				}
				@nutritionFields(f, "meal_out")
			}
			@web.FieldGroup(4, "Untracked Allowance") {
				@web.Hint() {
					Eaten each day outside the Plan (coffee, snacks); reserved before Slots are filled.
				}
				@nutritionFields(f, "untracked")
			}
			@web.FieldGroup(5, "Slot times") {
				@web.Hint() {
					The time of day of each kind of Slot. A Cycle starts at the first Slot after its Delivery arrives.
				}
				@web.FieldRow() {
					@web.TimeField("Breakfast", "breakfast_at", f.Values["breakfast_at"], f.Errors["breakfast_at"])
					@web.TimeField("Lunch", "lunch_at", f.Values["lunch_at"], f.Errors["lunch_at"])
					@web.TimeField("Snack", "snack_at", f.Values["snack_at"], f.Errors["snack_at"])
					@web.TimeField("Dinner", "dinner_at", f.Values["dinner_at"], f.Errors["dinner_at"])
				}
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					Save Profile
				}
			}
		</form>
		@briefForm(b)
	}
}

templ briefForm(b BriefForm) {
	<form id="planning-brief" method="post" action="/profile/brief">
		@web.FieldGroup(6, "Planning Brief") {
			if b.Saved {
				@web.Notice() {
					Planning Brief saved.
				}
			}
			if b.Failed {
				@web.Alert() {
					The Planning Brief could not be saved; try again. Details are in the server log.
				}
			}
			@web.Hint() {
				Your lasting wishes for every Plan: variety, effort, what you enjoy. Every planning Run reads it and follows it as far as the rules of the Plan allow; within a Cycle, its Planning Notes win. Saving it starts no planning Run: it applies from the next one.
			}
			@web.Field("Wishes", "", "") {
				<textarea name="brief" rows="5">{ b.Brief }</textarea>
			}
		}
		@web.Actions() {
			@web.Button(templ.Attributes{"type": "submit"}) {
				Save Planning Brief
			}
		}
	</form>
}

templ nutritionFields(f ProfileForm, prefix string) {
	@web.FieldRow() {
		@numberInput(f, prefix+"_kcal", "Calories", "kcal")
		@numberInput(f, prefix+"_protein_g", "Protein", "g")
		@numberInput(f, prefix+"_carbs_g", "Carbs", "g")
		@numberInput(f, prefix+"_fat_g", "Fat", "g")
	}
}

templ numberInput(f ProfileForm, name, label, unit string) {
	@web.Field(label, unit, f.Errors[name]) {
		<input
			type="number"
			inputmode="numeric"
			min="0"
			step="1"
			required
			name={ name }
			value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}

templ foodField(f ProfileForm, name, label string) {
	@web.Field(label, "", f.Errors[name]) {
		<textarea name={ name } rows="3">{ f.Values[name] }</textarea>
	}
}
