package web

// Tab is the shell tab a page belongs to, marked as current.
type Tab string

// NoTab is a page outside every tab, such as Today. SignedOut is a page before the User is
// signed in and has chosen their Language, whose shell has no tabs to lead anywhere yet.
// Each feature adds its tab here, and to the shell in Layout, as it lands.
const (
	NoTab      Tab = ""
	SignedOut  Tab = "signed-out"
	ProfileTab Tab = "/profile"
)

// Layout is the page shell every page renders inside: the head, the masthead (the
// dusk sky on a phone), the navigation (bottom tabs on a phone, a rail under the sky
// on desktop) with the page's tab marked, and the page's content. Every link and
// form is boosted, with a form's buttons disabled while its request is in flight;
// ADR 0009 says why a rejection keeps its address and why settling is off.
templ Layout(title string, current Tab) {
	<!DOCTYPE html>
	<html lang={ string(LanguageOf(ctx)) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content={ themeColour }/>
			<title>{ title }</title>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="icon" href="/static/icon-192.png"/>
			<link rel="apple-touch-icon" href="/static/icon-192.png"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<meta name="htmx-config" content="defaultSettleDelay:0"/>
			<script src="/static/htmx.min.js" defer></script>
			<script>
				if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");
			</script>
		</head>
		<body hx-boost:inherited="true" hx-disable:inherited="findAll button" hx-status:422:inherited="push:false">
			<header class="masthead">
				@sky("masthead-sky", []string{"cream", "peach", "salmon"})
				@ramp([]string{"deep", "paper"})
			</header>
			<nav class="shell" aria-label={ T(ctx, msgMainNav) }>
				@sky("rail-sky", []string{"paper", "cream", "peach", "salmon"})
				if current != SignedOut {
					<div class="tabs">
						@tab(ProfileTab, current, "user", T(ctx, msgProfile), false)
					</div>
				}
			</nav>
			<main class="page">
				{ children... }
			</main>
		</body>
	</html>
}

// sky is the README banner's dusk: a dithered ramp down through colours, the sun
// setting behind Fuji, and the wordmark linking Today. It is the masthead above each
// page on a phone and the top of the rail on desktop, each hidden where the other
// shows.
templ sky(class string, colours []string) {
	<div class={ "sky", class }>
		@ramp(colours)
		<span class="sky-sun">
			@templ.Raw(sunArt)
		</span>
		<span class="sky-fuji">
			@templ.Raw(fujiArt)
		</span>
		<a class="wordmark" href="/"><span class="wordmark-ja" lang="ja">段取り</span><span class="wordmark-latin">Dandori</span></a>
	</div>
}

// ramp dithers down through colours, each to the next in four steps.
templ ramp(colours []string) {
	<div class="ramp" aria-hidden="true">
		for _, step := range ditherSteps(colours) {
			<div class={ step }></div>
		}
	</div>
}

// tab is one link of the shell; aux ones sit apart, at the rail's foot.
templ tab(t, current Tab, icon, label string, aux bool) {
	<a
		class={ "tab", templ.KV("tab-aux", aux) }
		href={ templ.SafeURL(t) }
		if t == current {
			aria-current="page"
		}
	>
		@Icon(icon)
		<span>{ label }</span>
	</a>
}
