package web

import (
	"context"
	"fmt"
	"net/url"
	"slices"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
)

// The shared components every page is built from. docs/design.md says when to use each;
// app.css styles them.

// PageHeader opens a page: an eyebrow with the page's Japanese name and `today`'s date,
// then the `title`. Children, if any, are a lede below it.
templ PageHeader(ja, title string, today time.Time) {
	@PageHeaderBeside(ja, title, "", today) {
		{ children... }
	}
}

// PageHeaderBeside is a PageHeader with `beside`, unless "", after the `title` and a dot
// in the body face, smaller: what the page is of, such as a Cycle's dates.
templ PageHeaderBeside(ja, title, beside string, today time.Time) {
	<header class="page-header">
		<p class="eyebrow"><span lang="ja">{ ja }</span> · { Date(ctx, today) }</p>
		<h1>
			@titleText(title)
			if beside != "" {
				{ " " }
				<span class="title-beside">{ "· " + beside }</span>
			}
		</h1>
		{ children... }
	</header>
}

// Section is a numbered group of a page's content under a heading; `num` 0 marks it
// instead, for a group that isn't one of a page's, such as a side sheet's.
templ Section(num int, title string) {
	<section class="section">
		<h2 class="section-heading">
			@number(num)
			@titleText(title)
		</h2>
		{ children... }
	</section>
}

// FieldGroup is a Section of a form: its fields under a numbered `legend`, followed by
// `hint` in brackets, as a Field's, when set.
templ FieldGroup(num int, legend, hint string) {
	<fieldset class="section">
		<legend class="section-heading">
			@number(num)
			@titleText(legend)
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</legend>
		{ children... }
	</fieldset>
}

// FieldGroupAction is a FieldGroup with `action` beside its `legend`, for a secondary
// action on what the `legend` names. `id` is the legend text's: it alone names the group,
// leaving the `action` out.
templ FieldGroupAction(id string, num int, legend string, action templ.Component) {
	<fieldset class="section" aria-labelledby={ id }>
		<legend class="section-heading">
			@number(num)
			<span id={ id }>
				@titleText(legend)
			</span>
			<span class="heading-action">
				@action
			</span>
		</legend>
		{ children... }
	</fieldset>
}

// number is a Section's number, or for 0, a small mark in its place.
templ number(n int) {
	if n == 0 {
		<span class="mark" aria-hidden="true"></span>
	} else {
		<span class="num">{ fmt.Sprintf("%02d", n) }</span>
	}
}

// Data marks `s`, in a title, as data: a time, a quantity or User text, which the title
// sets in the body face, as the pixel face makes l, I and 1 hard to tell apart. Only
// PageHeader's, Section's and FieldGroup's titles read the mark.
func Data(s string) string { return dataStart + s + dataEnd }

// dataStart and dataEnd mark Data: characters of Unicode's private use, which no text a
// User reads holds.
const dataStart, dataEnd = "\uE000", "\uE001"

// titlePart is a run of a title, Data or not.
type titlePart struct {
	text string
	data bool
}

// titleParts splits `title` into its runs of Data and the rest.
func titleParts(title string) []titlePart {
	var parts []titlePart
	for {
		before, rest, found := strings.Cut(title, dataStart)
		if before != "" {
			parts = append(parts, titlePart{text: before})
		}
		if !found {
			return parts
		}
		data, after, _ := strings.Cut(rest, dataEnd)
		parts = append(parts, titlePart{text: data, data: true})
		title = after
	}
}

// titleText is `title`, its Data in the body face.
templ titleText(title string) {
	for _, p := range titleParts(title) {
		if p.data {
			<span class="data">{ p.text }</span>
		} else {
			{ p.text }
		}
	}
}

// Hint is a quiet paragraph explaining what follows.
templ Hint() {
	<p class="hint">{ children... }
</p>
}

// Empty says a list has nothing in it yet.
templ Empty() {
	<p class="empty">{ children... }
</p>
}

// Verbatim is `text` shown exactly as it was, such as a paste or a Trace Event's data:
// its lines kept, wrapping, on the surface.
templ Verbatim(text string) {
	<pre class="verbatim">{ text }</pre>
}

// Disclosure is a group of a page's content a click away, under `summary`: closed until
// the User opens it, unless `open` says it holds what they are at, such as a
// refused form.
templ Disclosure(summary string, open bool) {
	<details class="disclosure section" open?={ open }>
		<summary>
			<span>{ summary }</span>
			@Icon("chevron-down")
		</summary>
		{ children... }
	</details>
}

// Fold is a line, `summary`, that opens in place to show what it holds, the children: its
// chevron points right while closed and down while open, and it starts closed. Without
// `holds` it is the line alone, the chevron's room kept, so a list of Folds
// stays aligned.
templ Fold(summary templ.Component, holds bool) {
	if holds {
		<details class="fold">
			<summary>
				@Icon("chevron-down")
				@summary
			</summary>
			<div class="fold-body">
				{ children... }
			</div>
		</details>
	} else {
		<div class="fold fold-line">
			<span class="icon"></span>
			@summary
		</div>
	}
}

// Rows is a list of Rows or EditRows.
templ Rows() {
	<ul class="rows">
		{ children... }
	</ul>
}

// Row is one line of a list. Lay it out with a row-title, a row-figure, row-meta and
// a row-action.
templ Row() {
	<li class="row row-static">
		{ children... }
	</li>
}

// Seal marks an urgent Row with the pixel sun, before its row-title. It is decorative:
// the row's text, such as an accent Tag, says why it is urgent.
templ Seal() {
	<span class="seal">
		@templ.Raw(sunArt)
	</span>
}

// Group is a part of a Section's content under an h3, `title`, with `meta`, unless nil,
// under it: a soft line, or a day's Figures. It opens in place, closed unless `open` says
// it holds what the User is at, such as a refused form. What a Group holds is Rows, never
// a deeper heading.
templ Group(title string, meta templ.Component, open bool) {
	<details class="group" open?={ open }>
		<summary>
			<h3>{ title }</h3>
			@Icon("chevron-down")
			if meta != nil {
				<span class="group-meta">
					@meta
				</span>
			}
		</summary>
		<div class="group-body">
			{ children... }
		</div>
	</details>
}

// RowsHead is `label`, a small caption over the Rows that follow it.
templ RowsHead(label string) {
	<p class="rows-head">{ label }</p>
}

// FoldRow is a Row that opens in place to read what the children hold: unlike an EditRow
// it changes nothing and isn't raised. `summary` is the line, laid out as a Row's.
templ FoldRow(summary templ.Component) {
	<li class="row">
		<details class="fold-row">
			<summary>
				@summary
				<span class="row-edit">
					@Icon("chevron-down")
				</span>
			</summary>
			<div class="row-body">
				{ children... }
			</div>
		</details>
	</li>
}

// SlotRow is a Slot of `kind` and the Portion filling it, `portion`, marked Changed when
// `changed`: its `size` unless "", `figures`, its nutrition, unless nil, and `source`,
// unless "", a word for where the Portion comes from ("cooked", "already in
// the kitchen").
templ SlotRow(kind domain.SlotKind, portion string, changed bool, size string, figures templ.Component, source string) {
	@Row() {
		@RowTitle(portion, false, "", changed)
		if size != "" || figures != nil {
			<span class="row-figure">
				{ size }
				if size != "" && figures != nil {
					{ " · " }
				}
				if figures != nil {
					@figures
				}
			</span>
		}
		<span class="row-meta">
			<span>{ Capitalised(T(ctx, SlotKindNames[kind])) }</span>
			if source != "" {
				<span>{ source }</span>
			}
		</span>
	}
}

// Figures is a line of figures in equal columns, the children each a cell, under a
// Figures of their heads: the same values of a day, of an average or of a row, lined up
// down a Section without a table.
templ Figures() {
	<span class="figures">
		{ children... }
	</span>
}

// IngredientRows lists `ingredients`, each its name and its quantity in its unit, with a
// New Tag on one not yet saved, as a Recipe Draft's new Ingredient is.
templ IngredientRows(ingredients []domain.RecipeIngredient) {
	@IngredientRowsWith(ingredients, nil, nil)
}

// Changed marks what a Plan Proposal changes of the Plan, worth weighing: a cream Tag
// with the changed icon (•), said in words to a screen reader.
templ Changed() {
	@Tag(false, "") {
		@Icon("changed")
		<span class="sr-only">{ T(ctx, msgChanged) }</span>
	}
}

// RowTitle is a Row's title: `name`, and when `tagged`, `tag` after it as a plain Tag (a
// New Ingredient, a new Recipe), then Changed when `changed`.
templ RowTitle(name string, tagged bool, tag string, changed bool) {
	<span class="row-title">
		{ name }
		if tagged {
			{ " " }
			@Tag(false, "") {
				{ tag }
			}
		}
		if changed {
			{ " " }
			@Changed()
		}
	</span>
}

// QuantityFigure is a Row's row-figure: the quantity `q` in `unit`, as an Ingredient's is
// written. The space before it keeps it apart from the title in the row's text, which a
// screen reader reads; the Row's grid lays it out without it.
templ QuantityFigure(q domain.Quantity, unit domain.Unit) {
	{ " " }
	<span class="row-figure">{ Quantity(ctx, q, unit) }</span>
}

// IngredientRowsWith is IngredientRows with each of `ingredients` at an index of
// `changed` marked Changed, and what `meta`, unless nil, gives of each Ingredient, unless
// nil, as its row's details: a new one's proposed values.
templ IngredientRowsWith(ingredients []domain.RecipeIngredient, changed []int, meta func(domain.Ingredient) templ.Component) {
	@Rows() {
		for i, ri := range ingredients {
			@Row() {
				@RowTitle(ri.Ingredient.Name, ri.Ingredient.IsNew(), T(ctx, msgNew), slices.Contains(changed, i))
				@QuantityFigure(ri.Quantity, ri.Ingredient.Unit)
				if meta != nil {
					if c := meta(ri.Ingredient); c != nil {
						<span class="row-meta">
							@c
						</span>
					}
				}
			}
		}
	}
}

// Amount is the nutritional value `a`, then `unit` unless it is "": a dash a screen
// reader says is unknown when `a` isn't known, and "29+" when `floor` says only a floor
// is known, which a screen reader says as "at least 29".
templ Amount(a domain.Amount, floor bool, unit string) {
	if !a.Known {
		<span aria-hidden="true">–</span>
		<span class="sr-only">{ T(ctx, msgUnknown) }</span>
	} else {
		if floor {
			<span class="sr-only">{ T(ctx, msgAtLeast) + " " }</span>
			// One line, as templ parts the lines of a template with a space.
			{ Number(ctx, a.Value) }<span aria-hidden="true">+</span>
		} else {
			{ Number(ctx, a.Value) }
		}
		if unit != "" {
			{ " " + unit }
		}
	}
}

// AmountText is Amount as plain text for a sentence: "29+ g", or a dash for a value
// not known.
func AmountText(ctx context.Context, a domain.Amount, floor bool, unit string) string {
	if !a.Known {
		return "–"
	}
	s := Number(ctx, a.Value)
	if floor {
		s += "+"
	}
	return strings.TrimSpace(s + " " + unit)
}

// EditRow is one line of a list that opens in place to edit: `summary` is the line, the
// children are what it opens to.
templ EditRow(open bool, summary templ.Component) {
	@EditRowIn("", open, summary) {
		{ children... }
	}
}

// EditRowIn is an EditRow one of `group`, e.g. the Slots of a day: opening it closes
// `group`'s open one.
templ EditRowIn(group string, open bool, summary templ.Component) {
	<li class="row">
		<details { detailsAttributes(group, open)... }>
			<summary>
				@summary
				<span class="row-edit">
					@Icon("chevron-down")
					<span class="sr-only">{ T(ctx, msgChange) }</span>
				</span>
			</summary>
			<div class="row-body">
				{ children... }
			</div>
		</details>
	</li>
}

// detailsAttributes are an EditRow's <details> attributes: `open`, and the name of its
// `group` when it has one.
func detailsAttributes(group string, open bool) templ.Attributes {
	a := templ.Attributes{"open": open}
	if group != "" {
		a["name"] = group
	}
	return a
}

// Field is a labelled form control: the control is the children. `hint`, when set,
// follows the `label` (e.g. "optional"); `err` is why the value was rejected.
templ Field(label, hint, err string) {
	<label class="field">
		<span class="field-label">
			{ label }
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</span>
		{ children... }
		@FieldError(err)
	</label>
}

// FieldInfo is a Field with an information mark that reveals `info` as a tooltip.
templ FieldInfo(label, info, hint, err string) {
	<label class="field">
		<span class="field-label">
			{ label }
			<span class="field-info" tabindex="0" title={ info } aria-label={ info }>
				@Icon("info")
			</span>
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</span>
		{ children... }
		@FieldError(err)
	</label>
}

// SearchField is the search box over a list: the input is the children, with the
// magnifying glass inside it. `label` names it for a screen reader; the input's
// placeholder says it on screen.
templ SearchField(label string) {
	<label class="search-field">
		<span class="sr-only">{ label }</span>
		@Icon("search")
		{ children... }
	</label>
}

// ListSearch searches a list as the User types, swapping `listURL`'s answer into the
// element `listID` alone when htmx sends it, so the field keeps its focus; without htmx
// it opens `action` searched. The children are the input of its SearchField, named
// by `label`.
templ ListSearch(id, action, listURL, listID, label string) {
	<form
		novalidate
		id={ id }
		role="search"
		method="get"
		action={ templ.SafeURL(action) }
		hx-get={ listURL }
		hx-trigger="submit, input delay:300ms"
		hx-target={ "#" + listID }
		hx-swap="innerHTML"
	>
		@SearchField(label) {
			{ children... }
		}
	</form>
}

// TimeField is a Field for a time of day, which the User types in either form, holding
// `value` as the Language writes it (TimeOfDay). Not a native time input: that follows
// the browser's locale, not the User's Language.
templ TimeField(label, name, value, err string) {
	@Field(label, "", err) {
		<input
			type="text"
			inputmode="numeric"
			autocomplete="off"
			required
			name={ name }
			value={ value }
			placeholder={ TimeOfDay(ctx, 13*60) }
			if err != "" {
				aria-invalid="true"
			}
		/>
	}
}

// DateField is a Field for a day, holding `value` as the Language writes it
// (domain.FormatDate), for the same reason as TimeField. `hint` follows the `label`: a
// day that may be left blank says optional, and isn't required.
templ DateField(label, hint, name, value, err string) {
	@Field(label, hint, err) {
		<input
			type="text"
			inputmode="numeric"
			autocomplete="off"
			required?={ hint == "" }
			name={ name }
			value={ value }
			placeholder={ domain.FormatDate(LanguageOf(ctx), time.Date(2026, 11, 2, 0, 0, 0, 0, time.UTC)) }
			if err != "" {
				aria-invalid="true"
			}
		/>
	}
}

// CellField is a Field in a grid whose column heads name it, so its `label` is shown only
// on a phone, where the heads are hidden.
templ CellField(label, err string) {
	<label class="field">
		<span class="field-label cell-label">{ label }</span>
		{ children... }
		@FieldError(err)
	</label>
}

// Check is a checkbox, the child, before its `label`; `hint`, when set, follows
// the `label`.
templ Check(label, hint string) {
	<label class="check">
		{ children... }
		<span>
			{ label }
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</span>
	</label>
}

// Checks is a group of checkboxes named `name` under `legend`, `hint` in brackets after
// it as a Field's, one per choice, those whose Values are in `ticked` ticked, in as many
// columns as the width allows. `err` marks each and shows under them, the first taking
// `name` as its id, for an ErrorSummary to link to.
templ Checks(legend, hint, name string, choices []Choice, ticked []string, err string) {
	<fieldset class="stack">
		<legend class="field-label">
			{ legend }
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</legend>
		<div class="check-grid">
			for i, c := range choices {
				<label class="check">
					<input
						type="checkbox"
						name={ name }
						value={ c.Value }
						checked?={ slices.Contains(ticked, c.Value) }
						if err != "" {
							aria-invalid="true"
						}
						if err != "" && i == 0 {
							id={ name }
						}
					/>
					if c.Icon != "" {
						@Icon(c.Icon)
					}
					<span>{ c.Label }</span>
				</label>
			}
		</div>
		@FieldError(err)
	</fieldset>
}

// FieldError is why a value was rejected, or nothing.
templ FieldError(err string) {
	if err != "" {
		<span class="field-error">{ err }</span>
	}
}

// FieldRow lays a few short Fields side by side, wrapping on a phone.
templ FieldRow() {
	<div class="field-row">
		{ children... }
	</div>
}

// Actions is the row of buttons that ends a form.
templ Actions() {
	<div class="actions">
		{ children... }
	</div>
}

// ActionsApart is Actions for a row ending a form with one more action that isn't part of
// it: the primary one first, the other at the far end.
templ ActionsApart() {
	<div class="actions actions-apart">
		{ children... }
	</div>
}

// Button is the primary action, in ink. `attrs` must give its type.
templ Button(attrs templ.Attributes) {
	<button class="btn" { attrs... }>
		{ children... }
	</button>
}

// ButtonLink is a Button that is a link: the step forward that only goes to another page.
// `attrs` must give its href.
templ ButtonLink(attrs templ.Attributes) {
	<a class="btn" { attrs... }>
		{ children... }
	</a>
}

// TextButton is a secondary action. `attrs` must give its type.
templ TextButton(attrs templ.Attributes) {
	<button class="btn-text" { attrs... }>
		{ children... }
	</button>
}

// TextLink is a secondary action that writes nothing, looking as a TextButton does.
// `attrs` must give its href.
templ TextLink(attrs templ.Attributes) {
	<a class="btn-text" { attrs... }>
		{ children... }
	</a>
}

// TextButtonFold is a TextButton, `label`, with a chevron, that opens in place to what
// acting needs first, the children, such as Reject's Planning Note: closed unless `open`
// says it holds what the User is at. In Actions, it opens onto a line of its own.
templ TextButtonFold(label string, open bool) {
	@buttonFold("btn-text", label, open) {
		{ children... }
	}
}

// ButtonFold is a TextButtonFold that is the primary step, a Button: Plan again after a
// failed planning Run.
templ ButtonFold(label string, open bool) {
	@buttonFold("btn", label, open) {
		{ children... }
	}
}

// buttonFold is a ButtonFold or TextButtonFold, its summary of `class`.
templ buttonFold(class, label string, open bool) {
	<details class="button-fold" open?={ open }>
		<summary class={ class }>
			{ label }
			@Icon("chevron-down")
		</summary>
		<div class="button-fold-body">
			{ children... }
		</div>
	</details>
}

// SideColumn is a page's main column, the children, beside `side`: `side` comes first on
// a phone; from 1200px it is a column of its own on the right, which stays in view while
// the main column scrolls, such as a Plan Proposal's decision beside its days.
templ SideColumn(side templ.Component) {
	<div class="side-columns">
		<div class="side-column">
			@side
		</div>
		<div class="main-column">
			{ children... }
		</div>
	</div>
}

// DestructiveButton removes or discards something. `attrs` must give its type.
templ DestructiveButton(attrs templ.Attributes) {
	<button class="btn-text btn-danger" { attrs... }>
		{ children... }
	</button>
}

// RemoveLink is a DestructiveButton that asks first: it opens the SideSheet `id` on the
// RemoveStep loaded from `src`, a fragment, or without htmx goes to `href`, the
// step's page.
templ RemoveLink(id string, href, src templ.SafeURL) {
	@sheetLink("btn-text btn-danger", id, href, src, nil) {
		{ children... }
	}
}

// RemoveStepID is the id of a RemoveStep's form.
const RemoveStepID = "remove-step"

// RemoveStep asks once before deleting or discarding what the User wrote, `question`
// naming what will go: a form posting to `action`, whose DestructiveButton says `remove`,
// `attrs` adding such as the swap of a sheet's body, and the children its hidden fields.
// `back`, unless "", is a TextLink back, for the step as a page of its own; in a sheet,
// the sheet's Close is the way back.
templ RemoveStep(question, remove string, action, back templ.SafeURL, attrs templ.Attributes) {
	<form novalidate id={ RemoveStepID } class="stack" method="post" action={ action } { attrs... }>
		<p>{ question }</p>
		{ children... }
		@Actions() {
			@DestructiveButton(templ.Attributes{"type": "submit"}) {
				{ remove }
			}
			if back != "" {
				@TextLink(templ.Attributes{"href": back}) {
					{ T(ctx, msgBack) }
				}
			}
		}
	</form>
}

// Choice is one option of a Segmented choice or of Checks. Icon, if any, names the icon
// Checks shows before the label.
type Choice struct {
	Value string
	Label string
	Icon  string
}

// Segmented chooses one of a few options with square toggles, under `legend`, shown as a
// Field's label: none when the group around it already names it. `selected` is the chosen
// Value; `err` is why a choice was rejected, marking each option, the first then taking
// `name` as its id, for an ErrorSummary to link to.
templ Segmented(legend, name string, choices []Choice, selected, err string) {
	<fieldset class="field">
		if legend != "" {
			<legend class="field-label">{ legend }</legend>
		}
		<div class="seg">
			for i, c := range choices {
				<label>
					<input
						type="radio"
						name={ name }
						value={ c.Value }
						required
						checked?={ selected == c.Value }
						if err != "" {
							aria-invalid="true"
						}
						if err != "" && i == 0 {
							id={ name }
						}
					/>
					<span>{ c.Label }</span>
				</label>
			}
		</div>
		@FieldError(err)
	</fieldset>
}

// SegmentedLinks is Segmented for options that each open something rather than fill in a
// form, so the one shown is reachable from the others: its children are SegmentLinks.
// `label` is for a screen reader.
templ SegmentedLinks(label string) {
	<nav class="seg seg-links" aria-label={ label }>
		{ children... }
	</nav>
}

// SegmentLink is one option of SegmentedLinks, shown as chosen when `current`. `attrs`
// must give its href.
templ SegmentLink(current bool, attrs templ.Attributes) {
	<a
		if current {
			aria-current="true"
		}
		{ attrs... }
	><span>{ children... }
</span></a>
}

// Alert says something went wrong, on the accent wash.
templ Alert() {
	<div class="alert" role="alert">
		{ children... }
	</div>
}

// Refusal is a field a form refused: the id of its control, its label and why.
type Refusal struct{ ID, Label, Err string }

// ErrorSummary opens a rejected form longer than a screen: an Alert listing each of
// `refusals`, in the form's order, as a link to its field, taking focus as the page
// loads. It is nothing when there are none.
templ ErrorSummary(refusals []Refusal) {
	if len(refusals) > 0 {
		<div class="alert error-summary" role="alert" tabindex="-1" autofocus>
			<p>{ T(ctx, msgErrorSummary) }</p>
			<ul>
				for _, r := range refusals {
					<li><a href={ templ.SafeURL("#" + r.ID) }>{ r.Label }: { r.Err }</a></li>
				}
			</ul>
		</div>
	}
}

// notices is where floating Notices show, at the top of the screen: `text`, when set, is
// the one the page shows as it loads. It is shown without JS; Layout's showNotices only
// raises it into the top layer, over an open sheet, as a popover.
templ notices(text string) {
	<div id="notices" class="notices" popover="manual" role="status">
		if text != "" {
			@notice(text)
		}
	</div>
}

// notice says `text` happened as asked, until its time runs out, which its line tells, or
// Close closes it; hovering or focusing it stops its time.
templ notice(text string) {
	<div class="notice">
		<svg class="notice-timer" aria-hidden="true"><rect pathLength="100"></rect></svg>
		@Icon("check")
		<p class="notice-text">{ text }</p>
		<button type="button" class="btn-text notice-close" aria-label={ T(ctx, msgCloseNotice) }>{ T(ctx, msgClose) }</button>
	</div>
}

// noticePartial adds a floating Notice saying `text`, newest first, from a fragment
// htmx swaps.
templ noticePartial(text string) {
	<hx-partial hx-target="#notices" hx-swap="afterbegin">
		@notice(text)
	</hx-partial>
}

// Tag is a short label on a row or field. `accent` marks one that needs attention; its
// text must say why.
templ Tag(accent bool, title string) {
	<span
		class={ "tag", templ.KV("tag-accent", accent) }
		if title != "" {
			title={ title }
		}
	>
		{ children... }
	</span>
}

// Tone is the colour of a ToneTag.
type Tone string

// The tones of a ToneTag: Going is navy, for what is happening now, and Done is sage, for
// what has succeeded.
const (
	Going Tone = "going"
	Done  Tone = "done"
)

// ToneTag is a Tag with a `tone` of its own beside cream.
templ ToneTag(tone Tone) {
	<span class={ "tag", "tag-" + string(tone) }>
		{ children... }
	</span>
}

// AddChoice is one thing a page's floating button adds, in the sheet Sheet, titled Title
// and drawn as Icon. Src is the fragment that sheet's SheetBody loads as it opens, and
// Href the page of it without htmx; a sheet that already holds its body has neither. One
// with no Sheet is a link to the page Href, for a form too long for a sheet.
type AddChoice struct {
	Sheet, Title, Icon string
	Href, Src          templ.SafeURL
}

// AddButton is a page's primary add action: a square + that opens the sheet of the first
// of `choices`. With more than one, the + shows the icon of what it adds, and a chevron
// beside it chooses another: choosing changes what the + adds and opens nothing, and a
// new page starts on the first again.
templ AddButton(choices []AddChoice) {
	<div class="fab-group">
		for _, c := range choices {
			if c.Sheet == "" {
				<a class="fab fab-choice" href={ c.Href } aria-label={ c.Title }>
					@addFace(c, len(choices) > 1)
				</a>
			} else if c.Src == "" {
				<button class="fab fab-choice" type="button" commandfor={ c.Sheet } command="show-modal" aria-label={ c.Title }>
					@addFace(c, len(choices) > 1)
				</button>
			} else {
				@sheetLink("fab fab-choice", c.Sheet, c.Href, c.Src, templ.Attributes{"aria-label": c.Title}) {
					@addFace(c, len(choices) > 1)
				}
			}
		}
		if len(choices) > 1 {
			<button class="fab fab-more" type="button" popovertarget="add-choices" aria-label={ T(ctx, msgChooseAdd) }>
				@Icon("chevron-down")
			</button>
		}
	</div>
	if len(choices) > 1 {
		<div id="add-choices" class="fab-menu" popover { choosesAdd... }>
			for i, c := range choices {
				<label class="fab-option">
					<input type="radio" name="add-choice" autocomplete="off" checked?={ i == 0 }/>
					@Icon(c.Icon)
					{ c.Title }
				</label>
			}
		</div>
	}
}

// addFace is what the + of `c` shows: with others to choose from, the icon of what
// it adds.
templ addFace(c AddChoice, chosen bool) {
	@Icon("plus")
	if chosen {
		@Icon(c.Icon)
	}
}

// choosesAdd closes the menu of choices on a choice and leaves focus on the + it made,
// which sits in the fab-group at the same place as its option in the menu.
var choosesAdd = templ.Attributes{
	"hx-on:change": "this.hidePopover(); this.previousElementSibling.children[[...this.children].indexOf(event.target.closest('label'))].focus()",
}

// AddSheet is the sheet of an add form, the children: from the bottom on a phone, centred
// on desktop. An AddButton opens it. `open` shows it already open, for a rejected
// submission, with focus on the first rejected field.
templ AddSheet(id, title string, open bool) {
	@sheet(id, "sheet", title, open) {
		{ children... }
	}
	if open {
		<script>
			for (const sheet of document.querySelectorAll(".sheet[data-open]")) {
				sheet.showModal();
				sheet.querySelector("[aria-invalid=true]")?.focus();
			}
		</script>
	}
}

// SideSheet is a sheet of content any page can open without leaving it, over the veil:
// from the right on desktop, from the bottom on a phone. Its body is empty until a
// SideSheetLink loads it.
templ SideSheet(id, title string) {
	@sheet(id, "sheet side-sheet", title, false) {
		@SheetBody(id)
	}
}

// sheet is a modal dialog of `class` titled `title`, the children under its head: the
// page behind it is inert, and a tap on the veil or Esc closes it, the top one of
// several. closedby="any" closes it on the veil where the browser knows it; where it
// doesn't, a press that both starts and ends on the veil does, so dragging out of a field
// doesn't close it. Once its form is changed the veil no longer closes it (see
// keepsChanges). `open` marks it to open as the page loads.
templ sheet(id, class, title string, open bool) {
	<dialog
		id={ id }
		class={ class }
		closedby="any"
		aria-labelledby={ id + "-title" }
		data-open?={ open }
		{ veilCloses... }
		{ closesOnDone... }
		{ keepsChanges... }
	>
		<div class="sheet-head">
			<h2 id={ id + "-title" }>{ title }</h2>
			<button type="button" class="btn-text" commandfor={ id } command="close">{ T(ctx, msgClose) }</button>
		</div>
		{ children... }
	</dialog>
}

// veilCloses closes a sheet on a press that starts and ends on its veil, for a browser
// that doesn't know closedby.
var veilCloses = templ.Attributes{
	"hx-on:pointerdown": "this.veilPressed = !('closedBy' in this) && !this.changed && " + onVeil,
	"hx-on:click":       "if (this.veilPressed && " + onVeil + ") this.close()",
}

// keepsChanges keeps a sheet open on the veil once the User types or chooses in its form,
// a search aside, until it closes or a form in it saves: Esc and Close still close it. It
// sets the attribute: setting closedBy would add the property veilCloses checks.
var keepsChanges = templ.Attributes{
	"hx-on:input":              "if (!event.target.closest('[role=search]')) " + sheetChanged(true),
	"hx-on:close":              sheetChanged(false),
	"hx-on:htmx:after:request": "if (event.detail.ctx.request.method === 'POST' && event.detail.ctx.response?.status < 400) " + sheetChanged(false),
}

// sheetChanged is the script that marks a sheet's form `changed`, or not.
func sheetChanged(changed bool) string {
	return "{ this.changed = " + fmt.Sprint(changed) + "; this.setAttribute('closedby', this.changed ? 'closerequest' : 'any') }"
}

// CloseSheet is the event an answer to a form in a sheet triggers, with HX-Trigger, to
// close that sheet: the form's work is done, and a floating Notice says so.
const CloseSheet = "close-sheet"

// closesOnDone closes a sheet when the answer to a form in it triggers CloseSheet, and
// only that sheet, not one open beneath it.
var closesOnDone = templ.Attributes{
	"hx-on:" + CloseSheet: "event.stopPropagation(); this.close()",
}

// onVeil is whether the pointer event, on a sheet, is outside its box: on its backdrop.
const onVeil = `event.target === this && ((r) => event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)(this.getBoundingClientRect())`

// SheetBody is the body of the sheet `id`, an AddSheet's or a SideSheet's, for one whose
// content swaps in place; the children are what it starts with. Each swap into it opens
// the sheet, if it isn't open, and focuses the first field marked aria-invalid, or else
// marked autofocus, so a rejected form in it is shown again in place. A swap into part of
// the body, such as a search's results, leaves the focus where it is.
templ SheetBody(id string) {
	<div
		id={ SideSheetBody(id) }
		class="sheet-body"
		hx-on:htmx:after:swap="if (event.detail.ctx.target !== this) return; const s = this.closest('.sheet'); if (!s.open) s.showModal(); (this.querySelector('[aria-invalid=true]') ?? this.querySelector('[autofocus]'))?.focus()"
	>
		{ children... }
	</div>
}

// SectionBody is a section of a page whose form swaps it in place, the form being the
// children, as each of the Profile's does. A swap into it that comes back rejected
// focuses its first field marked aria-invalid.
templ SectionBody(id string) {
	<div
		id={ id }
		hx-on:htmx:after:swap="if (event.detail.ctx.target === this) this.querySelector('[aria-invalid=true]')?.focus()"
	>
		{ children... }
	</div>
}

// SideSheetBody is the id of the SheetBody of the sheet `id`, which a form in it targets.
func SideSheetBody(id string) string { return id + "-body" }

// SideSheetLink opens the sheet `id` with its SheetBody loaded from `src`, a fragment,
// and focuses its field marked autofocus, or else its first shown, not in a closed
// Disclosure. Without htmx it is a plain link to `href`, a page of the same content. htmx
// tells the swap to the link, so the link opens the sheet; a form in the body, swapped
// away, has htmx tell the body instead. The link is the sheet's source, so one inside
// another sheet opens over it and leaves it open.
templ SideSheetLink(id string, href, src templ.SafeURL) {
	@SideSheetLinkWith(id, href, src, nil) {
		{ children... }
	}
}

// SideSheetLinkWith is a SideSheetLink with more `attrs`, such as an hx-include that adds
// to `src` what the page around it says at that moment.
templ SideSheetLinkWith(id string, href, src templ.SafeURL, attrs templ.Attributes) {
	@sheetLink("sheet-link", id, href, src, attrs) {
		{ children... }
	}
}

// sheetLink is a link of `class` that opens the sheet `id`, as SideSheetLink does.
templ sheetLink(class, id string, href, src templ.SafeURL, attrs templ.Attributes) {
	<a
		class={ class }
		href={ href }
		hx-get={ string(src) }
		hx-target={ "#" + SideSheetBody(id) }
		hx-swap="innerHTML"
		data-sheet={ id }
		hx-on:htmx:after:swap="const s = document.getElementById(this.dataset.sheet); if (!s.open) s.showModal(); (s.querySelector('.sheet-body [autofocus]') ?? s.querySelector('.sheet-body :is(input:not([type=hidden]), select, textarea):not(details:not([open]) *)'))?.focus()"
		{ attrs... }
	>
		{ children... }
	</a>
}

// LanguageSwitch switches the pages before signing in between Languages, each named in
// itself, staying on the page at `u`. The one they speak is marked current.
templ LanguageSwitch(u *url.URL) {
	<nav class="lang-switch" aria-label={ T(ctx, msgLanguageSwitch) }>
		for i, l := range domain.Languages {
			if i > 0 {
				<span aria-hidden="true">·</span>
			}
			<a
				href={ switchURL(u, l) }
				lang={ string(l) }
				if l == LanguageOf(ctx) {
					aria-current="true"
				}
			>{ T(ctx, LanguageNames[l]) }</a>
		}
	</nav>
}
