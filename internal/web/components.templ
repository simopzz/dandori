package web

import (
	"fmt"
	"net/url"
	"time"

	"github.com/simopzz/dandori/internal/domain"
)

// The shared components every page is built from. docs/design.md says when
// to use each; app.css styles them.

// PageHeader opens a page: an eyebrow with the page's Japanese name and
// today's date, then the title. Children, if any, are a lede below it.
templ PageHeader(ja, title string, today time.Time) {
	<header class="page-header">
		<p class="eyebrow"><span lang="ja">{ ja }</span> · { Date(ctx, today) }</p>
		<h1>{ title }</h1>
		{ children... }
	</header>
}

// Section is a numbered group of a page's content under a heading; num 0 marks it
// instead, for a group that isn't one of a page's, such as a side sheet's.
templ Section(num int, title string) {
	<section class="section">
		<h2 class="section-heading">
			@number(num)
			{ title }
		</h2>
		{ children... }
	</section>
}

// FieldGroup is a Section of a form: its fields under a numbered legend.
templ FieldGroup(num int, legend string) {
	<fieldset class="section">
		<legend class="section-heading">
			@number(num)
			{ legend }
		</legend>
		{ children... }
	</fieldset>
}

// FieldGroupAction is a FieldGroup with action beside its legend, for a secondary action
// on what the legend names. id is the legend text's: it alone names the group, leaving
// the action out.
templ FieldGroupAction(id string, num int, legend string, action templ.Component) {
	<fieldset class="section" aria-labelledby={ id }>
		<legend class="section-heading">
			@number(num)
			<span id={ id }>{ legend }</span>
			<span class="heading-action">
				@action
			</span>
		</legend>
		{ children... }
	</fieldset>
}

// number is a Section's number, or for 0, a small mark in its place.
templ number(n int) {
	if n == 0 {
		<span class="mark" aria-hidden="true"></span>
	} else {
		<span class="num">{ fmt.Sprintf("%02d", n) }</span>
	}
}

// Hint is a quiet paragraph explaining what follows.
templ Hint() {
	<p class="hint">{ children... }</p>
}

// Empty says a list has nothing in it yet.
templ Empty() {
	<p class="empty">{ children... }</p>
}

// Disclosure is a group of a page's content a click away, under summary: closed until the
// User opens it.
templ Disclosure(summary string) {
	<details class="disclosure section">
		<summary>
			<span>{ summary }</span>
			@Icon("chevron-down")
		</summary>
		{ children... }
	</details>
}

// Fold is a line, summary, that opens in place to show what it holds, the children: its
// chevron points right while closed and down while open, and it starts closed. Without
// holds it is the line alone, the chevron's room kept, so a list of Folds stays aligned.
templ Fold(summary templ.Component, holds bool) {
	if holds {
		<details class="fold">
			<summary>
				@Icon("chevron-down")
				@summary
			</summary>
			<div class="fold-body">
				{ children... }
			</div>
		</details>
	} else {
		<div class="fold fold-line">
			<span class="icon"></span>
			@summary
		</div>
	}
}

// Rows is a list of Rows or EditRows.
templ Rows() {
	<ul class="rows">
		{ children... }
	</ul>
}

// Row is one line of a list. Lay it out with a row-title, a row-figure,
// row-meta and a row-action.
templ Row() {
	<li class="row row-static">
		{ children... }
	</li>
}

// Seal marks an urgent Row with the pixel sun, before its row-title. It is decorative:
// the row's text, such as an accent Tag, says why it is urgent.
templ Seal() {
	<span class="seal">
		@templ.Raw(sunArt)
	</span>
}

// EditRow is one line of a list that opens in place to edit: summary is
// the line, the children are what it opens to.
templ EditRow(open bool, summary templ.Component) {
	@EditRowIn("", open, summary) {
		{ children... }
	}
}

// EditRowIn is an EditRow one of group, e.g. the Slots of a day: opening
// it closes the group's open one.
templ EditRowIn(group string, open bool, summary templ.Component) {
	<li class="row">
		<details { detailsAttributes(group, open)... }>
			<summary>
				@summary
				<span class="row-edit">
					@Icon("chevron-down")
					<span class="sr-only">{ T(ctx, msgChange) }</span>
				</span>
			</summary>
			<div class="row-body">
				{ children... }
			</div>
		</details>
	</li>
}

// detailsAttributes are an EditRow's <details> attributes: open, and the
// name of its group when it has one.
func detailsAttributes(group string, open bool) templ.Attributes {
	a := templ.Attributes{"open": open}
	if group != "" {
		a["name"] = group
	}
	return a
}

// Field is a labelled form control: the control is the children. hint, when set,
// follows the label (e.g. "optional"); err is why the value was rejected.
templ Field(label, hint, err string) {
	<label class="field">
		<span class="field-label">
			{ label }
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</span>
		{ children... }
		@FieldError(err)
	</label>
}

// SearchField is the search box over a list: the input is the children, with the
// magnifying glass inside it. label names it for a screen reader; the input's placeholder
// says it on screen.
templ SearchField(label string) {
	<label class="search-field">
		<span class="sr-only">{ label }</span>
		@Icon("search")
		{ children... }
	</label>
}

// ListSearch searches a list as the User types, swapping listURL's answer into the
// element listID alone when htmx sends it, so the field keeps its focus; without htmx it
// opens action searched. The children are the input of its SearchField, named by label.
templ ListSearch(id, action, listURL, listID, label string) {
	<form
		id={ id }
		role="search"
		method="get"
		action={ templ.SafeURL(action) }
		hx-get={ listURL }
		hx-trigger="submit, input delay:300ms"
		hx-target={ "#" + listID }
		hx-swap="innerHTML"
	>
		@SearchField(label) {
			{ children... }
		}
	</form>
}

// TimeField is a Field for a time of day, HH:MM, holding value.
templ TimeField(label, name, value, err string) {
	@Field(label, "", err) {
		<input type="time" required name={ name } value={ value }
			if err != "" {
				aria-invalid="true"
			}
		/>
	}
}

// CellField is a Field in a grid whose column heads name it, so its label
// is shown only on a phone, where the heads are hidden.
templ CellField(label, err string) {
	<label class="field">
		<span class="field-label cell-label">{ label }</span>
		{ children... }
		@FieldError(err)
	</label>
}

// Check is a checkbox, the child, before its label; hint, when set, follows the label.
templ Check(label, hint string) {
	<label class="check">
		{ children... }
		<span>
			{ label }
			if hint != "" {
				<span class="field-hint">({ hint })</span>
			}
		</span>
	</label>
}

// FieldError is why a value was rejected, or nothing.
templ FieldError(err string) {
	if err != "" {
		<span class="field-error">{ err }</span>
	}
}

// FieldRow lays a few short Fields side by side, wrapping on a phone.
templ FieldRow() {
	<div class="field-row">
		{ children... }
	</div>
}

// Actions is the row of buttons that ends a form.
templ Actions() {
	<div class="actions">
		{ children... }
	</div>
}

// ActionsApart is Actions for a row ending a form with one more action that isn't part
// of it: the primary one first, the other at the far end.
templ ActionsApart() {
	<div class="actions actions-apart">
		{ children... }
	</div>
}

// Button is the primary action, in ink. attrs must give its type.
templ Button(attrs templ.Attributes) {
	<button class="btn" { attrs... }>
		{ children... }
	</button>
}

// ButtonLink is a link that looks like a Button.
templ ButtonLink(href templ.SafeURL) {
	<a class="btn" href={ href }>
		{ children... }
	</a>
}

// TextButton is a secondary action. attrs must give its type.
templ TextButton(attrs templ.Attributes) {
	<button class="btn-text" { attrs... }>
		{ children... }
	</button>
}

// TextLink is a secondary action that writes nothing, looking as a TextButton does.
// attrs must give its href.
templ TextLink(attrs templ.Attributes) {
	<a class="btn-text" { attrs... }>
		{ children... }
	</a>
}

// DestructiveButton removes or discards something. attrs must give its type.
templ DestructiveButton(attrs templ.Attributes) {
	<button class="btn-text btn-danger" { attrs... }>
		{ children... }
	</button>
}

// Choice is one option of a Segmented choice.
type Choice struct {
	Value string
	Label string
}

// Segmented chooses one of a few options with square toggles. selected
// is the chosen Value; err is why a choice was rejected.
templ Segmented(legend, name string, choices []Choice, selected, err string) {
	<fieldset
		class="seg"
		if err != "" {
			aria-invalid="true"
			tabindex="-1"
		}
	>
		<legend class="sr-only">{ legend }</legend>
		for _, c := range choices {
			<label><input type="radio" name={ name } value={ c.Value } required checked?={ selected == c.Value }/><span>{ c.Label }</span></label>
		}
	</fieldset>
	@FieldError(err)
}

// SegmentedLinks is Segmented for options that each open something rather than fill in a
// form, so the one shown is reachable from the others: its children are SegmentLinks.
// label is for a screen reader.
templ SegmentedLinks(label string) {
	<nav class="seg seg-links" aria-label={ label }>
		{ children... }
	</nav>
}

// SegmentLink is one option of SegmentedLinks, shown as chosen when current. attrs must
// give its href.
templ SegmentLink(current bool, attrs templ.Attributes) {
	<a
		if current {
			aria-current="true"
		}
		{ attrs... }
	><span>{ children... }</span></a>
}

// Alert says something went wrong, on the accent wash.
templ Alert() {
	<div class="alert" role="alert">
		{ children... }
	</div>
}

// notices is where floating Notices show, at the top of the screen: text, when set, is
// the one the page shows as it loads. It is shown without JS; Layout's showNotices only
// raises it into the top layer, over an open sheet, as a popover.
templ notices(text string) {
	<div id="notices" class="notices" popover="manual" role="status">
		if text != "" {
			@notice(text)
		}
	</div>
}

// notice says text happened as asked, until its time runs out, which its line tells,
// or Close closes it; hovering or focusing it stops its time.
templ notice(text string) {
	<div class="notice">
		<svg class="notice-timer" aria-hidden="true"><rect pathLength="100"></rect></svg>
		@Icon("check")
		<p class="notice-text">{ text }</p>
		<button type="button" class="btn-text notice-close" aria-label={ T(ctx, msgCloseNotice) }>{ T(ctx, msgClose) }</button>
	</div>
}

// noticePartial adds a floating Notice saying text, newest first, from a fragment
// htmx swaps.
templ noticePartial(text string) {
	<hx-partial hx-target="#notices" hx-swap="afterbegin">
		@notice(text)
	</hx-partial>
}

// Tag is a short label on a row or field. accent marks one that needs
// attention; its text must say why.
templ Tag(accent bool, title string) {
	<span
		class={ "tag", templ.KV("tag-accent", accent) }
		if title != "" {
			title={ title }
		}
	>
		{ children... }
	</span>
}

// AddChoice is one thing a page's floating button adds, in the sheet Sheet, titled Title
// and drawn as Icon. Src is the fragment that sheet's SheetBody loads as it opens, and
// Href the page of it without htmx; a sheet that already holds its body has neither. One
// with no Sheet is a link to the page Href, for a form too long for a sheet.
type AddChoice struct {
	Sheet, Title, Icon string
	Href, Src          templ.SafeURL
}

// AddButton is a page's primary add action: a square + that opens the sheet of the first
// of choices. With more than one, the + shows the icon of what it adds, and a chevron
// beside it chooses another: choosing changes what the + adds and opens nothing, and a
// new page starts on the first again.
templ AddButton(choices []AddChoice) {
	<div class="fab-group">
		for _, c := range choices {
			if c.Sheet == "" {
				<a class="fab fab-choice" href={ c.Href } aria-label={ c.Title }>
					@addFace(c, len(choices) > 1)
				</a>
			} else if c.Src == "" {
				<button class="fab fab-choice" type="button" commandfor={ c.Sheet } command="show-modal" aria-label={ c.Title }>
					@addFace(c, len(choices) > 1)
				</button>
			} else {
				@sheetLink("fab fab-choice", c.Sheet, c.Href, c.Src, templ.Attributes{"aria-label": c.Title}) {
					@addFace(c, len(choices) > 1)
				}
			}
		}
		if len(choices) > 1 {
			<button class="fab fab-more" type="button" popovertarget="add-choices" aria-label={ T(ctx, msgChooseAdd) }>
				@Icon("chevron-down")
			</button>
		}
	</div>
	if len(choices) > 1 {
		<div id="add-choices" class="fab-menu" popover { choosesAdd... }>
			for i, c := range choices {
				<label class="fab-option">
					<input type="radio" name="add-choice" autocomplete="off" checked?={ i == 0 }/>
					@Icon(c.Icon)
					{ c.Title }
				</label>
			}
		</div>
	}
}

// addFace is what the + of c shows: with others to choose from, the icon of what it adds.
templ addFace(c AddChoice, chosen bool) {
	@Icon("plus")
	if chosen {
		@Icon(c.Icon)
	}
}

// choosesAdd closes the menu of choices on a choice and leaves focus on the + it made,
// which sits in the fab-group at the same place as its option in the menu.
var choosesAdd = templ.Attributes{
	"hx-on:change": "this.hidePopover(); this.previousElementSibling.children[[...this.children].indexOf(event.target.closest('label'))].focus()",
}

// AddSheet is the sheet of an add form, the children: from the bottom on a phone, centred
// on desktop. An AddButton opens it. open shows it already open, for a rejected
// submission, with focus on the first rejected field.
templ AddSheet(id, title string, open bool) {
	@sheet(id, "sheet", title, open) {
		{ children... }
	}
	if open {
		<script>
			for (const sheet of document.querySelectorAll(".sheet[data-open]")) {
				sheet.showModal();
				sheet.querySelector("[aria-invalid=true]")?.focus();
			}
		</script>
	}
}

// SideSheet is a sheet of content any page can open without leaving it, over the veil:
// from the right on desktop, from the bottom on a phone. Its body is empty until a
// SideSheetLink loads it.
templ SideSheet(id, title string) {
	@sheet(id, "sheet side-sheet", title, false) {
		@SheetBody(id)
	}
}

// sheet is a modal dialog of class titled title, the children under its head: the page
// behind it is inert, and a tap on the veil or Esc closes it, the top one of several.
// closedby="any" closes it on the veil where the browser knows it; where it doesn't, a
// press that both starts and ends on the veil does, so dragging out of a field doesn't
// close it. open marks it to open as the page loads.
templ sheet(id, class, title string, open bool) {
	<dialog
		id={ id }
		class={ class }
		closedby="any"
		aria-labelledby={ id + "-title" }
		data-open?={ open }
		{ veilCloses... }
		{ closesOnDone... }
	>
		<div class="sheet-head">
			<h2 id={ id + "-title" }>{ title }</h2>
			<button type="button" class="btn-text" commandfor={ id } command="close">{ T(ctx, msgClose) }</button>
		</div>
		{ children... }
	</dialog>
}

// veilCloses closes a sheet on a press that starts and ends on its veil, for a browser
// that doesn't know closedby.
var veilCloses = templ.Attributes{
	"hx-on:pointerdown": "this.veilPressed = !('closedBy' in this) && " + onVeil,
	"hx-on:click":       "if (this.veilPressed && " + onVeil + ") this.close()",
}

// CloseSheet is the event an answer to a form in a sheet triggers, with HX-Trigger, to
// close that sheet: the form's work is done, and a floating Notice says so.
const CloseSheet = "close-sheet"

// closesOnDone closes a sheet when the answer to a form in it triggers CloseSheet, and
// only that sheet, not one open beneath it.
var closesOnDone = templ.Attributes{
	"hx-on:" + CloseSheet: "event.stopPropagation(); this.close()",
}

// onVeil is whether the pointer event, on a sheet, is outside its box: on its backdrop.
const onVeil = `event.target === this && ((r) => event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)(this.getBoundingClientRect())`

// SheetBody is the body of the sheet id, an AddSheet's or a SideSheet's, for one whose
// content swaps in place; the children are what it starts with. Each swap into it opens
// the sheet, if it isn't open, and focuses the first field marked aria-invalid, or else
// marked autofocus, so a rejected form in it is shown again in place. A swap into part
// of the body, such as a search's results, leaves the focus where it is.
templ SheetBody(id string) {
	<div
		id={ SideSheetBody(id) }
		class="sheet-body"
		hx-on:htmx:after:swap="if (event.detail.ctx.target !== this) return; const s = this.closest('.sheet'); if (!s.open) s.showModal(); (this.querySelector('[aria-invalid=true]') ?? this.querySelector('[autofocus]'))?.focus()"
	>
		{ children... }
	</div>
}

// SideSheetBody is the id of the SheetBody of the sheet id, which a form in it targets.
func SideSheetBody(id string) string { return id + "-body" }

// SideSheetLink opens the sheet id with its SheetBody loaded from src, a fragment, and
// focuses its field marked autofocus, or else its first. Without htmx it is a plain link
// to href, a page of the same content. htmx tells the swap to the link, so the link opens
// the sheet; a form in the body, swapped away, has htmx tell the body instead. The link
// is the sheet's source, so one inside another sheet opens over it and leaves it open.
templ SideSheetLink(id string, href, src templ.SafeURL) {
	@SideSheetLinkWith(id, href, src, nil) {
		{ children... }
	}
}

// SideSheetLinkWith is a SideSheetLink with more attrs, such as an hx-include that adds
// to src what the page around it says at that moment.
templ SideSheetLinkWith(id string, href, src templ.SafeURL, attrs templ.Attributes) {
	@sheetLink("sheet-link", id, href, src, attrs) {
		{ children... }
	}
}

// sheetLink is a link of class that opens the sheet id, as SideSheetLink does.
templ sheetLink(class, id string, href, src templ.SafeURL, attrs templ.Attributes) {
	<a
		class={ class }
		href={ href }
		hx-get={ string(src) }
		hx-target={ "#" + SideSheetBody(id) }
		hx-swap="innerHTML"
		data-sheet={ id }
		hx-on:htmx:after:swap="const s = document.getElementById(this.dataset.sheet); if (!s.open) s.showModal(); (s.querySelector('.sheet-body [autofocus]') ?? s.querySelector('.sheet-body input, .sheet-body select, .sheet-body textarea'))?.focus()"
		{ attrs... }
	>
		{ children... }
	</a>
}

// LanguageSwitch switches the pages before signing in between Languages, each named in
// itself, staying on the page at u. The one they speak is marked current.
templ LanguageSwitch(u *url.URL) {
	<nav class="lang-switch" aria-label={ T(ctx, msgLanguageSwitch) }>
		for i, l := range domain.Languages {
			if i > 0 {
				<span aria-hidden="true">·</span>
			}
			<a
				href={ switchURL(u, l) }
				lang={ string(l) }
				if l == LanguageOf(ctx) {
					aria-current="true"
				}
			>{ T(ctx, LanguageNames[l]) }</a>
		}
	</nav>
}
