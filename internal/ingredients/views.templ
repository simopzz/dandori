package ingredients

import (
	"cmp"
	"net/url"
	"strconv"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// SheetID is the Ingredients side sheet's id, which a page refreshing what it shows when
// the sheet closes listens on.
const SheetID = "ingredients"

// Sheet is the Ingredients side sheet, closed and empty until a SheetLink opens it. A
// page that shows a SheetLink renders it once.
templ Sheet() {
	@web.SideSheet(SheetID, web.T(ctx, msgIngredients))
}

// SheetLink opens the Ingredients side sheet; without htmx it goes to the
// Ingredients page.
templ SheetLink() {
	@web.SideSheetLink(SheetID, "/ingredients", "/ingredients/sheet") {
		{ web.T(ctx, msgIngredients) }
	}
}

// AddLink opens the Ingredients side sheet to add an Ingredient to count, its add form
// started on name, which a search found nothing for, or blank; without htmx it goes to
// the Ingredients page.
templ AddLink(name string) {
	@web.SideSheetLink(SheetID, templ.SafeURL("/ingredients?counting=1&name="+url.QueryEscape(name)), templ.SafeURL("/ingredients/sheet?counting=1&name="+url.QueryEscape(name))) {
		if name == "" {
			{ web.T(ctx, msgAddIngredient) }
		} else {
			{ web.Tf(ctx, msgAddNamed, name) }
		}
	}
}

// page is the Ingredients as a page of their own, for a browser without htmx: the side
// sheet's body, under the page's header.
templ page(today time.Time, ings []domain.Ingredient, view sheetView) {
	@web.Layout(web.T(ctx, msgIngredientsTitle), web.KitchenTab) {
		@web.PageHeader("食材", web.T(ctx, msgIngredients), today)
		<div id={ web.SideSheetBody(SheetID) }>
			@sheetBody(ings, view)
		</div>
	}
}

// sheetBody is what the Ingredients side sheet shows: view's add form, and the search of
// the User's Ingredients for its Q.
templ sheetBody(ings []domain.Ingredient, view sheetView) {
	@addForm(view.Add)
	@web.Section(0, web.T(ctx, msgYourIngredients)) {
		@searchForm(view.Q)
		<div id={ listID }>
			@list(ings, view)
		</div>
	}
}

// listID is the id of the list a search swaps.
const listID = "ingredient-list"

// searchForm searches the User's Ingredients as they type, swapping the list alone when
// htmx sends it, so the field keeps its focus; without htmx it opens the page searched.
templ searchForm(q string) {
	<form
		id="ingredient-search"
		role="search"
		method="get"
		action="/ingredients"
		hx-get="/ingredients/list"
		hx-trigger="submit, input delay:300ms"
		hx-target={ "#" + listID }
		hx-swap="innerHTML"
	>
		@web.SearchField(web.T(ctx, msgSearch)) {
			<input type="search" name="q" value={ q } placeholder={ web.T(ctx, msgSearch) } autocomplete="off"/>
		}
	</form>
}

// list is the User's Ingredients a search for view's Q found, Staples marked, or why
// there are none. Each opens in place to edit it, and view's Edit is open with why it
// was refused.
templ list(ings []domain.Ingredient, view sheetView) {
	if len(ings) == 0 {
		@web.Empty() {
			if view.Q == "" {
				{ web.T(ctx, msgNoIngredients) }
			} else {
				{ web.Tf(ctx, msgNoMatch, view.Q) }
			}
		}
	} else {
		@web.Rows() {
			for _, ing := range ings {
				@web.EditRow(view.Edit.ID == ing.ID, rowSummary(ing)) {
					@editForm(ing, editing(ing, view.Edit), view.Q, view.Moved[ing.ID])
				}
			}
		}
	}
}

// rowSummary is ing's line in the list: its name, Staple marked, where it is usually kept
// and its nutritional values.
templ rowSummary(ing domain.Ingredient) {
	<span class="row-title">{ ing.Name }</span>
	if ing.Staple {
		@web.Tag(false, "") {
			{ web.T(ctx, msgStaple) }
		}
	}
	<span class="row-meta">
		<span>{ web.T(ctx, StorageLocationNames[ing.Usual]) }</span>
		@nutritionFacts(ing)
	</span>
}

// editing is the edit form of ing: edit as typed when it was refused, else ing as it is.
func editing(ing domain.Ingredient, edit EditForm) EditForm {
	if edit.ID != ing.ID {
		return editFormOf(ing)
	}
	if edit.Values == nil {
		edit.AddForm = editFormOf(ing).AddForm
	}
	return edit
}

// editForm edits ing, posted from its row, swapping the side sheet's body when htmx posts
// it, searched for q as it was. Its Delete belongs to the delete form beside it, as forms
// don't nest, so Enter still saves. Once moved, some Movement refers to it, and a link
// opens its Movements in its usual Storage Location, which reach the other two: the only
// way to them for a Staple, which no Stock Item holds.
templ editForm(ing domain.Ingredient, f EditForm, q string, moved bool) {
	<form
		id={ editFormID(ing.ID) }
		method="post"
		action={ templ.SafeURL(ingredientURL(ing.ID, "")) }
		hx-post={ ingredientURL(ing.ID, "") }
		hx-target={ "#" + web.SideSheetBody(SheetID) }
		hx-swap="innerHTML"
	>
		<input type="hidden" name="q" value={ q }/>
		<div class="stack">
			<div>
				@web.Field(web.T(ctx, msgName), "", f.Errs["name"]) {
					<input
						name="name"
						value={ f.Name }
						required
						autocomplete="off"
						{ Invalid(cmp.Or(f.Errs["name"], f.Suggested))... }
					/>
				}
				if f.Suggested != "" {
					<input type="hidden" name="confirm" value={ f.Name }/>
					@web.FieldError(web.Tf(ctx, msgDidYouMean, f.Suggested))
				}
			</div>
			@ingredientFields(f.AddForm)
			@stapleCheck(f.Staple)
			if moved {
				@web.TextLink(templ.Attributes{"href": movementsURL(ing)}) {
					{ web.T(ctx, msgMovements) }
				}
			}
			@web.ActionsApart() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgSave) }
				}
				@web.DestructiveButton(templ.Attributes{"type": "submit", "form": deleteFormID(ing.ID)}) {
					{ web.T(ctx, msgDelete) }
				}
			}
			@web.FieldError(f.DeleteErr)
		</div>
	</form>
	<form
		id={ deleteFormID(ing.ID) }
		method="post"
		action={ templ.SafeURL(ingredientURL(ing.ID, "/delete")) }
		hx-post={ ingredientURL(ing.ID, "/delete") }
		hx-target={ "#" + web.SideSheetBody(SheetID) }
		hx-swap="innerHTML"
	>
		<input type="hidden" name="q" value={ q }/>
	</form>
}

// stapleCheck marks an Ingredient a Staple, checked when staple says it is one.
templ stapleCheck(staple bool) {
	@web.Check(web.T(ctx, msgStaple), web.T(ctx, msgStapleHint)) {
		<input type="checkbox" name="staple" value="on" checked?={ staple }/>
	}
}

// movementsURL is the page of ing's Movements in its usual Storage Location.
func movementsURL(ing domain.Ingredient) string {
	query := url.Values{"ingredient": {strconv.FormatInt(ing.ID, 10)}, "location": {string(ing.Usual)}}
	return "/kitchen/movements?" + query.Encode()
}

// ingredientURL is the path of the Ingredient id, then rest.
func ingredientURL(id int64, rest string) string {
	return "/ingredients/" + strconv.FormatInt(id, 10) + rest
}

// editFormID is the id of the form editing the Ingredient id.
func editFormID(id int64) string { return "ingredient-edit-" + strconv.FormatInt(id, 10) }

// deleteFormID is the id of the form deleting the Ingredient id.
func deleteFormID(id int64) string { return "ingredient-delete-" + strconv.FormatInt(id, 10) }

// addForm adds an Ingredient, swapping the side sheet's body when htmx posts it. Added to
// count, the answer swaps the sheet under this one instead, leaving this form in place
// for htmx to tell, which is the one time it does: it closes its sheet and hands the
// focus to the sheet left open.
templ addForm(f AddForm) {
	<form
		id="ingredient-add"
		method="post"
		action="/ingredients"
		hx-post="/ingredients"
		hx-target={ "#" + web.SideSheetBody(SheetID) }
		hx-swap="innerHTML"
		if f.Counting {
			hx-on:htmx:after:swap="if (event.target !== this) return; this.closest('.sheet')?.close(); document.querySelector('.sheet:modal [autofocus]')?.focus()"
		}
	>
		if f.Counting {
			<input type="hidden" name="counting" value="1"/>
		}
		@web.FieldGroup(0, web.T(ctx, msgAddIngredient)) {
			<div class="stack">
				<div>
					@web.Field(web.T(ctx, msgName), "", f.Errs["name"]) {
						<input
							name="name"
							value={ f.Name }
							required
							autocomplete="off"
							hx-get="/ingredients/suggestion"
							hx-trigger="change"
							hx-target={ "#" + suggestionID }
							hx-swap="innerHTML"
							{ Invalid(cmp.Or(f.Errs["name"], f.Suggested))... }
						/>
					}
					<div id={ suggestionID }>
						@suggestion(f.Name, f.Suggested)
					</div>
				</div>
				@ingredientFields(f)
				@stapleCheck(f.Staple)
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgAdd) }
					}
				}
			</div>
		}
	</form>
}

// ingredientFields are the fields the add and edit forms share, after the name: the unit,
// where it is usually kept and the nutritional values, as f has them.
templ ingredientFields(f AddForm) {
	@web.FieldRow() {
		@web.Field(web.T(ctx, msgUnit), "", f.Errs["unit"]) {
			<select name="unit" required { Invalid(f.Errs["unit"])... }>
				<option value="">{ web.T(ctx, msgChoose) }</option>
				for _, u := range domain.Units {
					<option value={ string(u) } selected?={ f.Unit == string(u) }>{ web.T(ctx, unitNames[u]) }</option>
				}
			</select>
		}
		@web.Field(web.T(ctx, msgUsual), "", f.Errs["usual"]) {
			<select name="usual" required { Invalid(f.Errs["usual"])... }>
				<option value="">{ web.T(ctx, msgChoose) }</option>
				for _, l := range domain.StorageLocations {
					<option value={ string(l) } selected?={ f.Usual == string(l) }>{ web.T(ctx, StorageLocationNames[l]) }</option>
				}
			</select>
		}
	}
	@web.Hint() {
		{ web.T(ctx, msgNutritionHint) }
	}
	@web.FieldRow() {
		for _, n := range nutrients {
			@web.Field(web.T(ctx, nutrientNames[n]), "", f.Errs[n]) {
				<input
					type="number"
					inputmode="decimal"
					step="0.1"
					min="0"
					name={ n }
					value={ f.Values[n] }
					required?={ n != "fibre" && n != "sugar" }
					{ Invalid(f.Errs[n])... }
				/>
			}
		}
	}
}

// suggestionID is the id of where the add form says what the name may have meant.
const suggestionID = "ingredient-suggestion"

// suggestion says closest is what name may have meant, if it isn't blank, and confirms
// name, so Add means the name typed. Picking closest adds nothing, so it is a link, which
// the form's other fields don't hold up and Enter doesn't press.
templ suggestion(name, closest string) {
	if closest != "" {
		<input type="hidden" name="confirm" value={ name }/>
		@web.FieldError(web.Tf(ctx, msgDidYouMean, closest))
		@web.TextLink(pickLink(closest)) {
			{ web.Tf(ctx, msgPick, closest) }
		}
	}
}

// pickLink picks name, swapping the side sheet's body; without htmx it opens the page
// searched for it.
func pickLink(name string) templ.Attributes {
	picked := "?picked=" + url.QueryEscape(name)
	return templ.Attributes{
		"href":      "/ingredients" + picked,
		"hx-get":    "/ingredients/sheet" + picked,
		"hx-target": "#" + web.SideSheetBody(SheetID),
		"hx-swap":   "innerHTML",
	}
}

// nutrientNames name the add form's nutritional value fields.
var nutrientNames = map[string]web.Message{
	"kcal": msgKcal, "protein": msgProtein, "carbs": msgCarbs, "fat": msgFat, "fibre": msgFibre, "sugar": msgSugar,
}

// Invalid marks a control aria-invalid when err says why its value was refused.
func Invalid(err string) templ.Attributes {
	if err == "" {
		return nil
	}
	return templ.Attributes{"aria-invalid": "true"}
}

// nutritionFacts are ing's nutritional values, per its unit, one span each for a row's
// details: calories, then grams of the rest, an unknown one a dash that a screen reader
// says is unknown.
templ nutritionFacts(ing domain.Ingredient) {
	<span>{ web.T(ctx, perUnit[ing.Unit]) }: { web.Tf(ctx, msgKcalValue, web.Number(ctx, ing.Nutrition.Kcal.Value)) }</span>
	for _, g := range gramFacts(ing.Nutrition) {
		<span>
			{ web.T(ctx, g.name) + " " }
			if g.amount.Known {
				{ web.Tf(ctx, msgGrams, web.Number(ctx, g.amount.Value)) }
			} else {
				<span aria-hidden="true">–</span>
				<span class="sr-only">{ web.T(ctx, msgUnknown) }</span>
			}
		</span>
	}
}

// gramFact is one of an Ingredient's nutritional values in grams, with its name.
type gramFact struct {
	name   web.Message
	amount domain.Amount
}

// gramFacts are n's values in grams, in the order a row shows them.
func gramFacts(n domain.Nutrition) []gramFact {
	return []gramFact{
		{msgProteinShort, n.Protein}, {msgCarbsShort, n.Carbs}, {msgFatShort, n.Fat},
		{msgFibreShort, n.Fibre}, {msgSugarShort, n.Sugar},
	}
}
