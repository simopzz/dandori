package ingredients

import (
	"context"
	"strconv"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// sheetID is the Ingredients side sheet's id.
const sheetID = "ingredients"

// Sheet is the Ingredients side sheet, closed and empty until a SheetLink opens it. A
// page that shows a SheetLink renders it once.
templ Sheet() {
	@web.SideSheet(sheetID, web.T(ctx, msgIngredients))
}

// SheetLink opens the Ingredients side sheet; without htmx it goes to the Ingredients
// page.
templ SheetLink() {
	@web.SideSheetLink(sheetID, "/ingredients", "/ingredients/sheet") {
		{ web.T(ctx, msgIngredients) }
	}
}

// page is the Ingredients as a page of their own, for a browser without htmx: the side
// sheet's body, under the page's header.
templ page(today time.Time, ings []domain.Ingredient, f AddForm) {
	@web.Layout(web.T(ctx, msgIngredientsTitle), web.KitchenTab) {
		@web.PageHeader("食材", web.T(ctx, msgIngredients), today)
		<div id={ web.SideSheetBody(sheetID) }>
			@sheetBody(ings, f)
		</div>
	}
}

// sheetBody is what the Ingredients side sheet shows: the Ingredient just added, if any,
// the add form, and the User's Ingredients, Staples marked.
templ sheetBody(ings []domain.Ingredient, f AddForm) {
	if f.Added != "" {
		@web.Notice() {
			{ web.Tf(ctx, msgAdded, f.Added) }
		}
	}
	@addForm(f)
	@web.Section(0, web.T(ctx, msgYourIngredients)) {
		if len(ings) == 0 {
			@web.Empty() {
				{ web.T(ctx, msgNoIngredients) }
			}
		} else {
			@web.Rows() {
				for _, ing := range ings {
					@web.Row() {
						<span class="row-title">{ ing.Name }</span>
						if ing.Staple {
							@web.Tag(false, "") {
								{ web.T(ctx, msgStaple) }
							}
						}
						<span class="row-meta">
							<span>{ web.T(ctx, storageLocationNames[ing.Usual]) }</span>
							@nutritionFacts(ing)
						</span>
					}
				}
			}
		}
	}
}

// addForm adds an Ingredient, swapping the side sheet's body when htmx posts it.
templ addForm(f AddForm) {
	<form
		id="ingredient-add"
		method="post"
		action="/ingredients"
		hx-post="/ingredients"
		hx-target={ "#" + web.SideSheetBody(sheetID) }
		hx-swap="innerHTML"
	>
		@web.FieldGroup(0, web.T(ctx, msgAddIngredient)) {
			<div class="stack">
				@web.Field(web.T(ctx, msgName), "", f.Errs["name"]) {
					<input name="name" value={ f.Name } required autocomplete="off" { invalid(f.Errs["name"])... }/>
				}
				@web.FieldRow() {
					@web.Field(web.T(ctx, msgUnit), "", f.Errs["unit"]) {
						<select name="unit" required { invalid(f.Errs["unit"])... }>
							<option value="">{ web.T(ctx, msgChoose) }</option>
							for _, u := range domain.Units {
								<option value={ string(u) } selected?={ f.Unit == string(u) }>{ web.T(ctx, unitNames[u]) }</option>
							}
						</select>
					}
					@web.Field(web.T(ctx, msgUsual), "", f.Errs["usual"]) {
						<select name="usual" required { invalid(f.Errs["usual"])... }>
							<option value="">{ web.T(ctx, msgChoose) }</option>
							for _, l := range domain.StorageLocations {
								<option value={ string(l) } selected?={ f.Usual == string(l) }>{ web.T(ctx, storageLocationNames[l]) }</option>
							}
						</select>
					}
				}
				@web.Hint() {
					{ web.T(ctx, msgNutritionHint) }
				}
				@web.FieldRow() {
					for _, n := range nutrients {
						@web.Field(web.T(ctx, nutrientNames[n]), "", f.Errs[n]) {
							<input
								type="number"
								inputmode="decimal"
								step="0.1"
								min="0"
								name={ n }
								value={ f.Values[n] }
								required?={ n != "fibre" && n != "sugar" }
								{ invalid(f.Errs[n])... }
							/>
						}
					}
				}
				@web.Check(web.T(ctx, msgStaple), web.T(ctx, msgStapleHint)) {
					<input type="checkbox" name="staple" value="on" checked?={ f.Staple }/>
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgAdd) }
					}
				}
			</div>
		}
	</form>
}

// nutrientNames name the add form's nutritional value fields.
var nutrientNames = map[string]web.Message{
	"kcal": msgKcal, "protein": msgProtein, "carbs": msgCarbs, "fat": msgFat, "fibre": msgFibre, "sugar": msgSugar,
}

// invalid marks a control aria-invalid when err says why its value was refused.
func invalid(err string) templ.Attributes {
	if err == "" {
		return nil
	}
	return templ.Attributes{"aria-invalid": "true"}
}

// nutritionFacts are ing's nutritional values, per its unit, one span each for a row's
// details: calories, then grams of the rest, an unknown one a dash that a screen reader
// says is unknown.
templ nutritionFacts(ing domain.Ingredient) {
	<span>{ web.T(ctx, perUnit[ing.Unit]) }: { web.Tf(ctx, msgKcalValue, number(ctx, ing.Nutrition.Kcal.Value)) }</span>
	for _, g := range gramFacts(ing.Nutrition) {
		<span>
			{ web.T(ctx, g.name) + " " }
			if g.amount.Known {
				{ web.Tf(ctx, msgGrams, number(ctx, g.amount.Value)) }
			} else {
				<span aria-hidden="true">–</span>
				<span class="sr-only">{ web.T(ctx, msgUnknown) }</span>
			}
		</span>
	}
}

// gramFact is one of an Ingredient's nutritional values in grams, with its name.
type gramFact struct {
	name   web.Message
	amount domain.Amount
}

// gramFacts are n's values in grams, in the order a row shows them.
func gramFacts(n domain.Nutrition) []gramFact {
	return []gramFact{
		{msgProteinShort, n.Protein}, {msgCarbsShort, n.Carbs}, {msgFatShort, n.Fat},
		{msgFibreShort, n.Fibre}, {msgSugarShort, n.Sugar},
	}
}

// number is v as the User's Language writes it, a decimal comma in Italian.
func number(ctx context.Context, v float64) string {
	s := strconv.FormatFloat(v, 'f', -1, 64)
	if web.LanguageOf(ctx) == domain.Italian {
		s = strings.Replace(s, ".", ",", 1)
	}
	return s
}
