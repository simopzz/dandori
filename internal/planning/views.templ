package planning

import (
	"fmt"

	"github.com/simopzz/dandori/internal/web"
)

// PlanPage is the Plan page: the current Cycle and the upcoming one, each
// with its Plan and Plan Proposals, and the form to open the next Cycle.
type PlanPage struct {
	// Current is the current Cycle, or nil before the first Delivery
	// arrives; Upcoming is the upcoming one, or nil when none is.
	Current  *CycleView
	Upcoming *CycleView
	// PlanNext is the current Cycle's end date when it is time to plan the
	// next one; empty otherwise.
	PlanNext string
	// Problem is why the user's change was refused, if it was.
	Problem string
	Open    CycleForm
}

// CycleView is a Cycle as shown, with its Plan and Plan Proposals.
type CycleView struct {
	ID int64
	// Number is the number of its first Section.
	Number    int
	Delivery  string // e.g. "Mon 2 Nov 2026, 18:00–20:00"
	Ordered   bool
	Starts    string // its first Slot, e.g. "dinner on Mon 2 Nov"
	Ends      string
	NeedsPlan bool // whether its Plan needs a new Plan Proposal
	// HasPlan is whether a Plan Proposal of the Cycle was approved; Calendar
	// is its Plan.
	HasPlan   bool
	Calendar  []CalendarDay
	Proposals []ProposalRow
	// Change is the change-the-Delivery form of the upcoming Cycle.
	Change CycleForm
}

// CycleForm is a Cycle or Delivery form's raw values, so a rejected
// submission is shown back as typed, and an error per field.
type CycleForm struct {
	Values map[string]string
	Errors map[string]string
}

// CalendarDay is one day of a Cycle under a Plan.
type CalendarDay struct {
	Date  string // e.g. "Mon 2 Nov"
	Eaten string // the day's nutrition, Untracked Allowance included
	// Trailing is the trailing seven days' calories and protein, or empty
	// when they aren't checked.
	Trailing string
	Slots    []SlotRow
}

// SlotRow is a filled Slot: the eating occasion and what fills it.
type SlotRow struct {
	Kind string
	What string
}

// PrepSessionRow is one Prep Session of a Plan.
type PrepSessionRow struct {
	What      string
	At        string // e.g. "dinner on Mon 2 Nov"
	Portions  string // e.g. "3 Portions"
	Locations string // where each Portion is kept
}

// ProposalRow is a Plan Proposal in the Plan page's list.
type ProposalRow struct {
	ID     int64
	Title  string // e.g. "Initial Plan Proposal"
	Status string
}

// ProposalPage is a Plan Proposal: its Plan as a calendar of Slots and a
// list of Prep Sessions, the rules it breaks, and the approve and reject
// actions while it is pending.
type ProposalPage struct {
	ID         int64
	Title      string
	Status     string
	Note       string
	Unreadable string // why its Plan can't be read; empty when it can
	Problem    string // why the user's decision was refused, if it was
	Violations []string
	Calendar   []CalendarDay
	Sessions   []PrepSessionRow
}

templ Page(p PlanPage) {
	@web.Layout("Dandori — Plan", web.TabPlan) {
		@web.PageHeader("献立", "Plan")
		if p.Problem != "" {
			@web.Alert() {
				{ p.Problem }
			}
		}
		if p.Current == nil && p.Upcoming == nil {
			@web.Section(1, "Cycle") {
				@web.Empty() {
					No Cycle yet.
				}
				@web.Hint() {
					Open a Cycle with its Delivery to start planning.
				}
			}
		}
		if p.Current != nil {
			@cycleSections(*p.Current, "Cycle", "Plan", "Plan Proposals")
		}
		if p.PlanNext != "" {
			<div id="plan-next" class="section">
				@web.Hint() {
					This Cycle ends on { p.PlanNext }: time to plan the next one, so its Delivery can be ordered.
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "button", "popovertarget": "open-cycle-sheet"}) {
						Plan the next Cycle
					}
				}
			</div>
		}
		if p.Upcoming != nil {
			@cycleSections(*p.Upcoming, "Upcoming Cycle", "Upcoming Plan", "Upcoming Plan Proposals")
		} else {
			@openSheet(p.Open)
		}
	}
}

// cycleSections are a Cycle's dates, its Plan and its Plan Proposals, and
// for the upcoming Cycle the forms to change its Delivery and drop it.
templ cycleSections(c CycleView, cycle, plan, proposals string) {
	@web.Section(c.Number, cycle) {
		<dl>
			<dt>Delivery</dt>
			<dd>
				{ c.Delivery }
				if c.Ordered {
					@web.Tag(false, "") {
						ordered
					}
				} else {
					@web.Tag(false, "") {
						tentative
					}
				}
			</dd>
			<dt>Starts</dt>
			<dd>{ c.Starts }</dd>
			<dt>Ends</dt>
			<dd>{ c.Ends }</dd>
		</dl>
		if c.NeedsPlan {
			@web.Alert() {
				A Delivery moved: this Plan needs a new Plan Proposal.
			}
		}
		if c.Change.Values != nil {
			@deliveryForm(c)
		}
	}
	@web.Section(c.Number+1, plan) {
		if !c.HasPlan {
			@web.Empty() {
				No Plan yet: approve a Plan Proposal.
			}
		} else {
			@calendar(c.Calendar)
		}
	}
	@web.Section(c.Number+2, proposals) {
		if len(c.Proposals) == 0 {
			@web.Empty() {
				No Plan Proposals yet.
			}
		} else {
			@web.Rows() {
				for _, pr := range c.Proposals {
					@web.Row() {
						<a class="row-title" href={ templ.SafeURL(fmt.Sprintf("/plan-proposals/%d", pr.ID)) }>{ pr.Title }</a>
						@web.Tag(pr.Status == "pending", "") {
							{ pr.Status }
						}
					}
				}
			}
		}
	}
}

// deliveryForm changes the upcoming Cycle's Delivery, marks it ordered,
// or drops the Cycle while it is tentative.
templ deliveryForm(c CycleView) {
	@web.Rows() {
		@web.EditRow(len(c.Change.Errors) > 0, deliverySummary()) {
			<form id="delivery" class="stack" method="post" action={ templ.SafeURL(fmt.Sprintf("/cycles/%d/delivery", c.ID)) }>
				if len(c.Change.Errors) > 0 {
					@web.Alert() {
						The Delivery was not changed; fix the fields marked below.
					}
				}
				@deliveryFields(c.Change)
				if c.Ordered {
					@web.Hint() {
						Ordered. Moving it leaves the Plan needing a new Plan Proposal, which makes do with what is ordered.
					}
				} else {
					@web.Segmented("Delivery", "ordered", []web.Choice{{Value: "", Label: "Tentative"}, {Value: "yes", Label: "Ordered"}}, c.Change.Values["ordered"], "")
					@web.Hint() {
						Mark it ordered once you have checked out on the supermarket's site.
					}
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						Save Delivery
					}
				}
			</form>
			if !c.Ordered {
				<form id="drop" class="section" method="post" action={ templ.SafeURL(fmt.Sprintf("/cycles/%d/drop", c.ID)) }>
					@web.Hint() {
						Dropping the Cycle drops its Plan and Plan Proposals; its days become days between Cycles.
					}
					@web.Actions() {
						@web.DestructiveButton(templ.Attributes{"type": "submit"}) {
							Drop this Cycle
						}
					}
				</form>
			}
		}
	}
}

templ deliverySummary() {
	<span class="row-title">Change the Delivery</span>
}

// deliveryFields are a Delivery's date and time window.
templ deliveryFields(f CycleForm) {
	@web.Field("Delivery date", "", f.Errors["delivery_on"]) {
		<input type="date" required name="delivery_on" value={ f.Values["delivery_on"] }
			if f.Errors["delivery_on"] != "" {
				aria-invalid="true"
			}
		/>
	}
	@web.FieldRow() {
		@timeField(f, "window_from", "Window from")
		@timeField(f, "window_to", "Window to")
	}
}

templ timeField(f CycleForm, name, label string) {
	@web.Field(label, "", f.Errors[name]) {
		<input type="time" required name={ name } value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}

templ openSheet(f CycleForm) {
	@web.AddSheet("open-cycle-sheet", "Open a Cycle", len(f.Errors) > 0) {
		<form id="open-cycle" class="stack" method="post" action="/cycles">
			if len(f.Errors) > 0 {
				@web.Alert() {
					The Cycle was not opened; fix the fields marked below.
				}
			}
			@deliveryFields(f)
			@web.Field("End date", "optional, ten days later", f.Errors["ends_on"]) {
				<input type="date" name="ends_on" value={ f.Values["ends_on"] }
					if f.Errors["ends_on"] != "" {
						aria-invalid="true"
					}
				/>
			}
			@web.Hint() {
				The Cycle is upcoming until its Delivery arrives, at the end of its window. Then it starts, and the current Cycle closes: what is left of it becomes Portions without a Slot.
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					Open
				}
			}
		</form>
	}
}

// calendar is a Plan's days, each with its nutrition and filled Slots.
templ calendar(days []CalendarDay) {
	for _, d := range days {
		<h3>{ d.Date }</h3>
		@web.Hint() {
			{ d.Eaten }
			if d.Trailing != "" {
				<br/>
				Seven days: { d.Trailing }
			}
		}
		if len(d.Slots) > 0 {
			<dl>
				for _, s := range d.Slots {
					<dt>{ s.Kind }</dt>
					<dd>{ s.What }</dd>
				}
			</dl>
		}
	}
}

templ ProposalView(p ProposalPage) {
	@web.Layout("Dandori — Plan Proposal", web.TabPlan) {
		@web.PageHeader("献立案", "Plan Proposal") {
			<p class="lede">{ p.Title }</p>
		}
		if p.Problem != "" {
			@web.Alert() {
				{ p.Problem }
			}
		}
		<p>
			@web.Tag(p.Status == "pending", "") {
				{ p.Status }
			}
		</p>
		if p.Note != "" {
			@web.Notice() {
				Note: { p.Note }
			}
		}
		if len(p.Violations) > 0 {
			@web.Alert() {
				<p>This Plan Proposal breaks the rules of the Plan:</p>
				<ul>
					for _, v := range p.Violations {
						<li>{ v }</li>
					}
				</ul>
			}
		}
		if p.Unreadable != "" {
			@web.Alert() {
				This Plan Proposal can't be read: { p.Unreadable }.
			}
			if p.Status == "pending" {
				@web.Section(1, "Decide") {
					@rejectForm(p.ID)
				}
			}
		} else {
			@web.Section(1, "Slots") {
				@calendar(p.Calendar)
			}
			@web.Section(2, "Prep Sessions") {
				if len(p.Sessions) == 0 {
					@web.Empty() {
						No Prep Sessions.
					}
				} else {
					@web.Rows() {
						for _, s := range p.Sessions {
							@web.Row() {
								<span class="row-title">{ s.What }</span>
								<span class="row-meta">
									<span>{ s.At }</span>
									<span>{ s.Portions }</span>
									<span>{ s.Locations }</span>
								</span>
							}
						}
					}
				}
			}
			if p.Status == "pending" {
				@web.Section(3, "Decide") {
					<form id="approve" method="post" action={ templ.SafeURL(fmt.Sprintf("/plan-proposals/%d/approve", p.ID)) }>
						@web.Actions() {
							@web.Button(templ.Attributes{"type": "submit"}) {
								Approve
							}
						}
					</form>
					@rejectForm(p.ID)
				}
			}
		}
	}
}

templ rejectForm(id int64) {
	<form id="reject" class="stack section" method="post" action={ templ.SafeURL(fmt.Sprintf("/plan-proposals/%d/reject", id)) }>
		@web.Field("Note", "optional, for the next Plan Proposal", "") {
			<textarea name="note" rows="3"></textarea>
		}
		@web.Actions() {
			@web.DestructiveButton(templ.Attributes{"type": "submit"}) {
				Reject
			}
		}
	</form>
}
