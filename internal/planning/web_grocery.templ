package planning

import (
	"fmt"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// groceryURL is the Grocery List of the Cycle `id`.
func groceryURL(id int64) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/grocery-list", id))
}

// groceryPage is the Grocery List of the upcoming Cycle `c`, the Cycle's dates beside the
// title: 01 each line to buy, a checkbox kept only in the page before its name and
// quantity, and 02 the Staples to check the kitchen still holds. While `c` has no Plan,
// `planned` false, it says to plan it first, linking to the Cycle.
templ groceryPage(now time.Time, c Cycle, list domain.GroceryList, planned bool) {
	@web.Layout(web.T(ctx, msgGroceryListTitle), web.PlanTab) {
		@web.PageHeaderBeside("献立", web.T(ctx, msgGroceryList), dates(ctx, c), now) {
			<p class="lede">{ web.T(ctx, msgGroceryHint) }</p>
		}
		if !planned {
			<div class="section">
				@web.Empty() {
					{ web.T(ctx, msgPlanFirst) }
				}
				@web.Actions() {
					@web.ButtonLink(templ.Attributes{"href": string(cycleURL(c.ID))}) {
						{ web.T(ctx, msgSeeCycle) }
					}
				}
			</div>
		} else {
			@web.Section(1, web.T(ctx, msgToBuy)) {
				if len(list.Lines) == 0 {
					@web.Empty() {
						{ web.T(ctx, msgNothingToBuy) }
					}
				} else {
					@web.Rows() {
						for _, ri := range list.Lines {
							@web.Row() {
								@web.Check(ri.Ingredient.Name, web.Quantity(ctx, ri.Quantity, ri.Ingredient.Unit)) {
									<input type="checkbox"/>
								}
							}
						}
					}
				}
			}
			if len(list.Staples) > 0 {
				@web.Section(2, web.T(ctx, msgCheckYouHave)) {
					@web.Rows() {
						for _, ing := range list.Staples {
							@web.Row() {
								@web.RowTitle(ing.Name, false, "", false)
							}
						}
					}
				}
			}
		}
	}
}
