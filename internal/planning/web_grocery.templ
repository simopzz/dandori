package planning

import (
	"fmt"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/web"
)

// groceryURL is the Grocery List of the Cycle `id`.
func groceryURL(id int64) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/grocery-list", id))
}

// orderedURL is marking the Delivery of the Cycle `id` ordered, and tentativeURL
// undoing that.
func orderedURL(id int64) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/ordered", id))
}

func tentativeURL(id int64) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/tentative", id))
}

// groceryPage is the Grocery List of the upcoming or current Cycle `c`, the Cycle's dates
// beside the title, its Delivery, tentative, ordered or delivered, and a link back to the
// Cycle under it; why marking it ordered was refused, if it was: 01 each line to buy, a
// checkbox kept only in the page before its name and quantity, 02 the Staples to check
// the kitchen still holds, then, until the Delivery arrives, marking it ordered or, once
// it is, undoing that. While `c` has no Plan, `list` nil, it says to plan it first.
templ groceryPage(now time.Time, c Cycle, list *domain.GroceryList, refusal error) {
	@web.Layout(web.T(ctx, msgGroceryListTitle), web.PlanTab) {
		@web.PageHeaderBeside("献立", web.T(ctx, msgGroceryList), dates(ctx, c), now) {
			@deliveryLine(c, nil)
			<p class="lede">{ web.T(ctx, msgGroceryHint) }</p>
			<p class="lede">
				@web.TextLink(templ.Attributes{"href": string(cycleURL(c.ID))}) {
					{ web.T(ctx, msgBackToTheCycle) }
				}
			</p>
		}
		@decisionAlert(refusal)
		if list == nil {
			<div class="section">
				@web.Empty() {
					{ web.T(ctx, msgPlanFirst) }
				}
			</div>
		} else {
			@web.Section(1, web.T(ctx, msgToBuy)) {
				if len(list.Lines) == 0 {
					@web.Empty() {
						{ web.T(ctx, msgNothingToBuy) }
					}
				} else {
					@web.Rows() {
						for _, line := range list.Lines {
							@web.Row() {
								@web.Check(line.Ingredient.Name, web.Quantity(ctx, line.Quantity, line.Ingredient.Unit)) {
									<input type="checkbox"/>
								}
							}
						}
					}
				}
			}
			if len(list.Staples) > 0 {
				@web.Section(2, web.T(ctx, msgCheckYouHave)) {
					@web.Rows() {
						for _, ing := range list.Staples {
							@web.Row() {
								@web.RowTitle(ing.Name, false, "", false)
							}
						}
					}
				}
			}
			if c.Delivery.State != domain.Arrived {
				@orderForm(c)
			}
		}
	}
}

// orderForm marks `c`'s Delivery ordered while it is tentative, and undoes that once it
// is ordered, each with a hint of what it does.
templ orderForm(c Cycle) {
	<div class="section">
		if c.Delivery.State == domain.Ordered {
			<form novalidate id="undo-ordered" class="stack" method="post" action={ tentativeURL(c.ID) }>
				@web.Hint() {
					{ web.T(ctx, msgUndoOrderedHint) }
				}
				@web.Actions() {
					@web.TextButton(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgUndoOrdered) }
					}
				}
			</form>
		} else {
			<form novalidate id="mark-ordered" class="stack" method="post" action={ orderedURL(c.ID) }>
				@web.Hint() {
					{ web.T(ctx, msgMarkOrderedHint) }
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgMarkOrdered) }
					}
				}
			</form>
		}
	</div>
}
