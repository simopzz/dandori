package planning

import (
	"context"
	"errors"
	"fmt"
	"math"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/kitchen"
	"github.com/simopzz/dandori/internal/recipes"
	"github.com/simopzz/dandori/internal/web"
)

// OpenForm is the form opening a Cycle as shown: what was typed and why each field was
// refused, by field, and why opening is refused as a whole, if it is.
type OpenForm struct {
	Values, Errs map[string]string
	Refusal      error
}

// dropSheetID is the id of the sheet asking before dropping the upcoming Cycle.
const dropSheetID = "drop-cycle"

// dropURL is the step asking before dropping the Cycle id.
func dropURL(id int64) templ.SafeURL { return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/drop", id)) }

// window is d's date and window as the Language writes them.
func window(ctx context.Context, d domain.Delivery) string {
	return web.Tf(ctx, msgWindow, web.Date(ctx, d.On), web.TimeOfDay(ctx, d.From), web.TimeOfDay(ctx, d.To))
}

// cycleView is what the Cycle page shows: the Cycle, nil when there's none, upcoming or
// current, how planning it stands, why its latest planning Run failed, if it did, why
// a decision or planning was refused, if one was, and the Planning Note typed with it.
type cycleView struct {
	Cycle    *Cycle
	Upcoming bool
	Planning Planning
	Failure  string
	Refusal  error
	Note     string
}

// cyclePage is the Cycle page: with a Plan Proposal pending, the Plan Proposal verdict
// first; with a Plan approved, the Plan from today; otherwise the Cycle as it stands.
templ cyclePage(now time.Time, v cycleView) {
	@web.Layout(web.T(ctx, msgCycleTitle), web.PlanTab) {
		if v.Cycle != nil && v.Planning.Proposal != nil {
			@proposalPage(now, v)
		} else if v.Cycle != nil && v.Planning.Plan != nil {
			@planPage(now, v)
		} else {
			@cycleBody(now, v)
		}
	}
}

// cycleBody is the Cycle page without a Plan Proposal or a Plan: with a Cycle, its dates
// and Delivery under the title, why planning failed, if it did, and its one step forward,
// a filled button: plan it, see it being planned, or plan it again; dropping it, while
// upcoming, sits apart at the end. With none, a button to open one.
templ cycleBody(now time.Time, v cycleView) {
	if v.Cycle == nil {
		@web.PageHeader("献立", web.T(ctx, msgCycle), now)
		<div class="section">
			@web.Empty() {
				{ web.T(ctx, msgNoCycle) }
			}
			@web.Actions() {
				@web.ButtonLink(templ.Attributes{"href": "/plan/open"}) {
					{ web.T(ctx, msgOpenCycle) }
				}
			}
		</div>
	} else {
		{{ c, p := *v.Cycle, v.Planning }}
		@cycleHeader(now, c, v.Upcoming, nil)
		@decisionAlert(v.Refusal)
		<div class="section">
			if p.Failed != nil && p.Going == 0 && p.Proposal == nil && p.Plan == nil {
				@web.Alert() {
					<p>{ web.Tf(ctx, msgFailed, v.Failure) }</p>
					<a href={ templ.SafeURL(fmt.Sprintf("/runs/%d", p.Failed.ID)) }>{ web.T(ctx, msgSeeTrace) }</a>
				}
			}
			@web.ActionsApart() {
				<div class="actions">
					if p.Going != 0 {
						@web.ToneTag(web.Going) {
							{ web.T(ctx, msgBeingPlannedTag) }
						}
						@web.TextLink(templ.Attributes{"href": fmt.Sprintf("/runs/%d", p.Going)}) {
							{ web.T(ctx, msgSeeProgress) }
						}
					} else if p.Proposal == nil && p.Plan == nil {
						if p.Failed != nil {
							@planAgain(c.ID, v.Note, v.Note != "" || v.Refusal != nil)
							@web.TextLink(templ.Attributes{"href": string(checkURL(c.ID))}) {
								{ web.T(ctx, msgCheckKitchenFirst) }
							}
						} else {
							@web.ButtonLink(templ.Attributes{"href": string(checkURL(c.ID))}) {
								{ web.T(ctx, msgPlanCycle) }
							}
						}
					}
				</div>
				if v.Upcoming {
					@web.RemoveLink(dropSheetID, dropURL(c.ID), dropURL(c.ID)+"/sheet") {
						{ web.T(ctx, msgDropCycle) }
					}
				}
			}
		</div>
		if v.Upcoming {
			@web.SideSheet(dropSheetID, web.T(ctx, msgDropCycle))
		}
	}
}

// runAbout is what a planning Run's page tells of its Cycle c: a line naming it, linking
// to the Cycle page, and, after a failed Run, Plan again.
templ runAbout(c Cycle, again bool) {
	<p class="lede">
		@web.TextLink(templ.Attributes{"href": "/plan"}) {
			{ web.Tf(ctx, msgPlanningCycle, web.Tf(ctx, msgDates, web.ShortDate(ctx, c.Delivery.On), web.ShortDate(ctx, c.Ends))) }
		}
	</p>
	if again {
		@web.Actions() {
			@planAgain(c.ID, "", false)
		}
	}
}

// planAgain is the step forward after a failed planning Run of the Cycle id: Plan again,
// a ButtonFold, which opens in place to the line saying what a Planning Note does, the
// note as typed and its own button, as Reject does; open when the User is at it.
templ planAgain(id int64, note string, open bool) {
	@web.ButtonFold(web.T(ctx, msgPlanAgain), open) {
		<form novalidate id="plan-again" class="stack" method="post" action={ templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/again", id)) }>
			@web.Hint() {
				{ web.T(ctx, msgPlanAgainHint) }
			}
			@web.Field(web.T(ctx, msgPlanningNote), web.T(ctx, msgOptional), "") {
				<textarea name="note" rows="3">{ note }</textarea>
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgPlanAgain) }
				}
			}
		</form>
	}
}

// decisionAlert says why deciding on a Plan Proposal or planning was refused, if it was.
templ decisionAlert(err error) {
	if clash, ok := errors.AsType[*recipes.ClashError](err); ok {
		@web.Alert() {
			<p>{ web.Tf(ctx, msgClash, clash.Name) }</p>
		}
	}
	if msg, ok := refusalOf(err); ok {
		@web.Alert() {
			<p>{ web.T(ctx, msg) }</p>
		}
	}
}

// refusalOf says why err refused deciding or planning, ok false when it didn't.
func refusalOf(err error) (msg web.Message, ok bool) {
	switch {
	case errors.Is(err, ErrStartsInThePast):
		return msgStartsInThePast, true
	case errors.Is(err, ErrBusy):
		return msgBusy, true
	case errors.Is(err, ErrPlanned):
		return msgPlanned, true
	case errors.Is(err, ErrNothingLeft):
		return msgNothingLeft, true
	}
	return web.Message{}, false
}

// draftSheetID is the id of the sheet a Plan Proposal's Recipe Draft opens in.
const draftSheetID = "recipe-draft"

// draftURL is the page of the planner's Recipe Draft id.
func draftURL(id int64) templ.SafeURL { return templ.SafeURL(fmt.Sprintf("/plan/drafts/%d", id)) }

// clashed is whether err refused approving because a Recipe Draft clashes.
func clashed(err error) bool {
	_, ok := errors.AsType[*recipes.ClashError](err)
	return ok
}

// checkURL is the Kitchen Check before planning the Cycle id.
func checkURL(id int64) templ.SafeURL { return templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/check", id)) }

// checkPage is the Kitchen Check before planning c: why planning is refused, if it is,
// what the kitchen holds today with a Count for each, and one button that confirms it
// and starts planning.
templ checkPage(now time.Time, c Cycle, contents kitchen.Contents, refusal error) {
	@web.Layout(web.T(ctx, msgCheckTitle), web.PlanTab) {
		@web.PageHeader("献立", web.T(ctx, msgKitchenCheck), now) {
			<p class="lede">{ web.Tf(ctx, msgCheckHint, web.Date(ctx, c.Delivery.On)) }</p>
		}
		if errors.Is(refusal, ErrBusy) {
			@web.Alert() {
				<p>{ web.T(ctx, msgBusy) }</p>
				<a href="/plan">{ web.T(ctx, msgSeeCycle) }</a>
			}
		}
		@kitchen.Check(now, contents)
		<form novalidate id="plan-cycle" class="section" method="post" action={ templ.SafeURL(fmt.Sprintf("/plan/cycles/%d/plan", c.ID)) }>
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgConfirmAndPlan) }
				}
			}
		</form>
	}
}

// kcalProtein is n's calories and protein, whole, as a Slot's row shows them.
templ kcalProtein(n domain.PortionNutrition) {
	{{ kcal, _ := n.Of(domain.TargetKcal) }}
	{{ protein, floor := n.Of(domain.TargetProtein) }}
	{{ kcal.Value, protein.Value = math.Round(kcal.Value), math.Round(protein.Value) }}
	@web.Amount(kcal, false, web.T(ctx, msgKcalUnit))
	{ " · " }
	@web.Amount(protein, floor, web.T(ctx, msgGramsUnit))
	{ " " + web.T(ctx, msgProteinWord) }
}

// prepSession is ps as a row that opens to read it: how many Portions at what size and
// its minutes, then its Ingredients scaled and where each Portion goes.
templ prepSession(ps domain.PrepSession) {
	@web.FoldRow(prepSessionLine(ps)) {
		@web.RowsHead(web.T(ctx, msgIngredients))
		@web.IngredientRows(ps.Ingredients())
		@web.RowsHead(web.T(ctx, msgPortionsHead))
		@web.Rows() {
			for _, pp := range ps.Portions {
				@web.Row() {
					<span class="row-title">{ eatenAt(ctx, pp.EatAt) }</span>
					<span class="row-meta">{ web.Capitalised(web.T(ctx, web.InLocations[pp.Location])) }</span>
				}
			}
		}
	}
}

// prepSessionLine is the line ps folds to: how many Portions at what size, and its
// minutes for a Recipe.
templ prepSessionLine(ps domain.PrepSession) {
	<span class="row-title">{ portionsOf(ctx, ps) }</span>
	if ps.Recipe != nil {
		<span class="row-meta">{ web.Tf(ctx, msgMinutes, ps.Recipe.ActiveMinutes, ps.Recipe.TotalMinutes) }</span>
	}
}

// sizeOf is a Portion size as SlotRow shows it: none for 0, a Portion not made by a
// Prep Session of a Recipe.
func sizeOf(ctx context.Context, s float64) string {
	if s == 0 {
		return ""
	}
	return size(ctx, s)
}

// size is a Portion size as the Language writes it: "1.25×".
func size(ctx context.Context, s float64) string { return web.Tf(ctx, msgSize, web.Number(ctx, s)) }

// portionsOf is ps's name with how many Portions it yields, and their size for a Recipe.
func portionsOf(ctx context.Context, ps domain.PrepSession) string {
	n := len(ps.Portions)
	switch {
	case ps.Recipe == nil && n == 1:
		return web.Tf(ctx, msgOnePortion, ps.Name())
	case ps.Recipe == nil:
		return web.Tf(ctx, msgPortions, ps.Name(), n)
	case n == 1:
		return web.Tf(ctx, msgOnePortionAt, ps.Name(), size(ctx, ps.Size))
	}
	return web.Tf(ctx, msgPortionsAt, ps.Name(), n, size(ctx, ps.Size))
}

// eatenAt is the Slot a Portion is eaten at, or that it has none.
func eatenAt(ctx context.Context, s *domain.Slot) string {
	if s == nil {
		return web.T(ctx, msgNoSlot)
	}
	return web.Tf(ctx, msgSlotOn, web.Capitalised(web.T(ctx, web.SlotKindNames[s.Kind])), web.Date(ctx, s.On))
}

// filledSlot is a Slot of a Plan Proposal with the Portion filling it: its name, its
// size when a Prep Session of a Recipe yields it, its nutrition, and the Prep Session it
// comes from, nil for a Portion already in the kitchen, with where it is kept.
type filledSlot struct {
	kind      domain.SlotKind
	name      string
	size      float64
	nutrition domain.PortionNutrition
	from      *domain.PrepSession
	location  domain.StorageLocation
}

// planDay is one day of a Plan Proposal: its Slots filled, and its Prep Sessions.
type planDay struct {
	on       time.Time
	filled   []filledSlot
	sessions []domain.PrepSession
	// splits are the Plan's freezer splits, on its Delivery's day only.
	splits []domain.RecipeIngredient
}

// days are the days of c that p fills a Slot or prepares food on, in order, each's Slots
// in the order of the day.
func days(c Cycle, p Proposal) []planDay {
	var out []planDay
	for on := c.Delivery.On; !on.After(c.Ends); on = on.AddDate(0, 0, 1) {
		d := planDay{on: on}
		for _, k := range domain.SlotKinds {
			at := domain.Slot{On: on, Kind: k}
			for i, ps := range p.Plan.PrepSessions {
				for _, pp := range ps.Portions {
					if pp.EatAt != nil && pp.EatAt.Equal(at) {
						d.filled = append(d.filled, filledSlot{kind: k, name: ps.Name(), size: ps.Size, nutrition: ps.NutritionPerPortion(),
							from: &p.Plan.PrepSessions[i], location: pp.Location})
					}
				}
				if ps.At.Equal(at) {
					d.sessions = append(d.sessions, ps)
				}
			}
			for _, kept := range p.Plan.Kept {
				if kept.At.Equal(at) {
					portion := p.Kept[kept.Portion]
					d.filled = append(d.filled, filledSlot{kind: k, name: portion.Name, nutrition: domain.PortionNutrition{Nutrition: portion.Nutrition}})
				}
			}
		}
		if len(d.filled) > 0 || len(d.sessions) > 0 {
			out = append(out, d)
		}
	}
	return out
}

// openPage is the form opening a Cycle, f: why it is refused as a whole first, if it is,
// then its Delivery's date and window, and its end date, which may be left blank.
templ openPage(now time.Time, f OpenForm) {
	@web.Layout(web.T(ctx, msgOpenCycleTitle), web.PlanTab) {
		@web.PageHeader("献立", web.T(ctx, msgOpenCycle), now)
		<form novalidate id="open-cycle" class="stack section" method="post" action="/plan">
			@refusalAlert(f.Refusal)
			@web.Hint() {
				{ web.T(ctx, msgOpenHint) }
			}
			@web.DateField(web.T(ctx, msgDeliveryDate), "", domain.CycleDelivery, f.Values[domain.CycleDelivery], f.Errs[domain.CycleDelivery])
			@web.FieldRow() {
				@web.TimeField(web.T(ctx, msgWindowFrom), domain.CycleFrom, f.Values[domain.CycleFrom], f.Errs[domain.CycleFrom])
				@web.TimeField(web.T(ctx, msgWindowTo), domain.CycleTo, f.Values[domain.CycleTo], f.Errs[domain.CycleTo])
			}
			@web.DateField(web.T(ctx, msgEndDate), web.T(ctx, msgOptional), domain.CycleEnds, f.Values[domain.CycleEnds], f.Errs[domain.CycleEnds])
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ web.T(ctx, msgOpen) }
				}
			}
		</form>
	}
}

// refusalAlert says why opening a Cycle is refused as a whole, linking to what to do
// about it, or is nothing.
templ refusalAlert(err error) {
	if errors.Is(err, ErrUpcoming) {
		@web.Alert() {
			<p>{ web.T(ctx, msgUpcoming) }</p>
			<a href="/plan">{ web.T(ctx, msgSeeUpcoming) }</a>
		}
	} else if errors.Is(err, ErrNoTargets) {
		@web.Alert() {
			<p>{ web.T(ctx, msgNoTargets) }</p>
			<a href="/profile#targets">{ web.T(ctx, msgSetTargets) }</a>
		}
	}
}

// dropPage is the step asking before dropping c as a page of its own, for a browser
// without htmx.
templ dropPage(now time.Time, c Cycle) {
	@web.Layout(web.T(ctx, msgCycleTitle), web.PlanTab) {
		@web.PageHeader("献立", web.T(ctx, msgDropCycle), now)
		@dropStep(c, "/plan")
	}
}

// dropStep asks before dropping c, with a link back unless back is "", as in its sheet.
templ dropStep(c Cycle, back templ.SafeURL) {
	@web.RemoveStep(web.Tf(ctx, msgDropAsk, web.Date(ctx, c.Delivery.On)), web.T(ctx, msgDrop), dropURL(c.ID), back, nil)
}

// bounds are what t allows a day of target, as a column's head shows them: calories'
// range, a floor as ≥ and a ceiling as ≤, each said in words to a screen reader.
templ bounds(t domain.Targets, target domain.Target) {
	switch target {
		case domain.TargetKcal:
			{{ lo, hi := t.Bounds(target) }}
			{ web.Tf(ctx, msgRange, whole(ctx, lo), whole(ctx, hi)) }
		case domain.TargetSugar:
			<span aria-hidden="true">≤</span>
			<span class="sr-only">{ web.T(ctx, msgAtMost) + " " }</span>
			{ web.Number(ctx, float64(t.Aim(target))) }
		default:
			<span aria-hidden="true">≥</span>
			<span class="sr-only">{ web.T(ctx, msgAtLeast) + " " }</span>
			{ web.Number(ctx, float64(t.Aim(target))) }
	}
}

// worthWeighing marks the children, a value, as a soft miss to weigh: a cream Tag with
// ▼ under its Target or ▲ over it, said in words to a screen reader.
templ worthWeighing(under bool) {
	@web.Tag(false, "") {
		{ children... }
		if under {
			@web.Icon("under")
			<span class="sr-only">{ web.T(ctx, msgUnderWord) }</span>
		} else {
			@web.Icon("over")
			<span class="sr-only">{ web.T(ctx, msgOverWord) }</span>
		}
	}
}

// targetMessages head the day table's column of each Target, and name it in a line.
var targetMessages = map[domain.Target]struct{ head, word web.Message }{
	domain.TargetKcal:    {msgCalories, msgCaloriesWord},
	domain.TargetProtein: {msgProtein, msgProteinWord},
	domain.TargetFibre:   {msgFibre, msgFibreWord},
	domain.TargetSugar:   {msgSugar, msgSugarWord},
}

// whole is v rounded to whole, as the Language writes it.
func whole(ctx context.Context, v float64) string { return web.Number(ctx, math.Round(v)) }

