package planning

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/simopzz/dandori/internal/web"
)

// planPage is the Cycle page with a Plan approved, laid out as its Plan Proposal was: the
// Cycle's dates beside the title and its Delivery under it; why a decision was refused,
// if one was; 01 the Plan, the averages and soft misses it was approved with, beside 02
// its days from today, today marked and open and the days past folded into one line; and
// 03 the Plan's actions, apart at the end: asking for changes and dropping the Cycle.
templ planPage(now time.Time, v cycleView) {
	{{ c, p := *v.Cycle, *v.Planning.Plan }}
	{{ ds := proposalDays(c, p) }}
	{{ past, ahead := splitPast(ds, now) }}
	@cycleHeader(now, v, ds)
	@decisionAlert(v.Refusal)
	@web.SideColumn(planSection(p)) {
		@web.Section(2, web.T(ctx, msgDays)) {
			@figureHeads(p.Targets)
			@pastFold(p, past)
			for _, d := range ahead {
				@web.Group(dayTitle(ctx, d), planDayLine(p, d, now), isToday(d, now)) {
					@dayBody(d)
				}
			}
		}
		@planActions(v)
	}
	if v.droppable() {
		@web.SideSheet(dropSheetID, web.T(ctx, msgDropCycle))
	}
}

// planActions is Section 03, the Plan's actions apart at the end: while the Cycle is
// planned again, saying so with a link to the Run; once that Run failed, why, with its
// Trace, and Plan again; otherwise asking for changes, while no planning Run is going nor
// Plan Proposal pending for any Cycle. Dropping the Cycle sits beside them, while it can
// be dropped; nothing when it has none of them.
templ planActions(v cycleView) {
	{{ c, p := *v.Cycle, v.Planning }}
	{{ ask := !p.Busy && p.Failed == nil }}
	if p.Going != 0 || p.Failed != nil || ask || v.droppable() {
		@web.Section(3, sectionTitle(ctx, v.Upcoming)) {
			if p.Failed != nil {
				@failedAlert(p.Failed.ID, v.Failure)
			}
			@web.ActionsApart() {
				if p.Going != 0 {
					<div class="actions">
						@beingPlanned(p.Going)
					</div>
				} else if p.Failed != nil {
					@planAgain(c.ID, v.Note, v.Note != "" || v.Refusal != nil)
				} else if ask {
					@askForChanges(c.ID, p.Notes, v.Note, noteError(ctx, v.Refusal), v.Note != "" || v.Refusal != nil)
				}
				if v.droppable() {
					@web.RemoveLink(dropSheetID, dropURL(c.ID), dropURL(c.ID)+"/sheet") {
						{ web.T(ctx, msgDropCycle) }
					}
				}
			}
		}
	}
}

// sectionTitle names the Cycle's own Section: Upcoming Cycle, or Current Cycle.
func sectionTitle(ctx context.Context, upcoming bool) string {
	if upcoming {
		return web.T(ctx, msgUpcomingCycle)
	}
	return web.T(ctx, msgCurrentCycle)
}

// noteError is why `err` refused a Planning Note on its field, or "".
func noteError(ctx context.Context, err error) string {
	if errors.Is(err, ErrNoNote) {
		return web.T(ctx, msgNoNote)
	}
	return ""
}

// askForChanges is Ask for changes to the Plan of the Cycle `id`, a TextButtonFold that
// opens in place, as Reject does, to the Cycle's earlier Planning Notes, `notes`, newest
// first, the line saying what asking does, and the `note` it needs, as typed, refused
// with `err` if not "": open when `open` says the User is at it.
templ askForChanges(id int64, notes []string, note, err string, open bool) {
	@web.TextButtonFold(web.T(ctx, msgAskForChanges), open) {
		@earlierNotes(notes)
		@noteForm("ask-for-changes", fmt.Sprintf("/plan/cycles/%d/changes", id), msgAskHint, msgAskForChanges, note, true, err)
	}
}

// planSection is the Plan `p` as Section 01: the averages and the soft misses it was
// approved with.
templ planSection(p Proposal) {
	@web.Section(1, web.T(ctx, msgPlan)) {
		@averages(p)
		@missRows(p)
	}
}

// planDayLine is `d`'s line under its date, marked Today when it is.
templ planDayLine(p Proposal, d proposalDay, now time.Time) {
	if isToday(d, now) {
		<span>
			@web.Tag(false, "") {
				{ web.T(ctx, msgToday) }
			}
		</span>
	}
	@dayLine(p.Targets, d)
}

// pastFold is the days `past`, folded into one Group, each a row with its figures;
// nothing when none is past.
templ pastFold(p Proposal, past []proposalDay) {
	if len(past) > 0 {
		@web.Group(daysPastTitle(ctx, len(past)), nil, false) {
			@web.Rows() {
				for _, d := range past {
					@web.Row() {
						<span class="row-title">{ web.ShortDate(ctx, d.On) }</span>
						@figureLine(d.Nutrition, dayMissed(p.Targets, d.Day))
					}
				}
			}
		}
	}
}

// daysPastTitle says `n` days are past.
func daysPastTitle(ctx context.Context, n int) string {
	if n == 1 {
		return web.T(ctx, msgOneDayPast)
	}
	return web.Tf(ctx, msgDaysPast, n)
}

// splitPast splits `ds` into the days before today, at `now`, that fill a Slot, and those
// from it on: a Delivery's day past with only its freezer splits has nothing left to do.
func splitPast(ds []proposalDay, now time.Time) (past, ahead []proposalDay) {
	for i, d := range ds {
		if !d.On.Before(startOfDay(now)) {
			return past, ds[i:]
		}
		if len(d.filled) > 0 {
			past = append(past, d)
		}
	}
	return past, nil
}

// isToday is whether `d` is the day of `now`.
func isToday(d proposalDay, now time.Time) bool { return d.On.Equal(startOfDay(now)) }

// startOfDay is midnight of the day of `t`, in its zone.
func startOfDay(t time.Time) time.Time {
	y, m, d := t.Date()
	return time.Date(y, m, d, 0, 0, 0, 0, t.Location())
}
