package planning

import (
	"context"
	"errors"
	"fmt"
	"math"
	"slices"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/recipes"
	"github.com/simopzz/dandori/internal/web"
)

// proposalPage is the Cycle page with its Plan Proposal pending, verdict first: the
// Cycle's dates beside the title and its Delivery under it; why a decision was refused,
// if one was; 01 the Plan Proposal, to decide on, beside 02 its days, each folded to a
// row; and 03 dropping the Cycle, while it is upcoming.
templ proposalPage(now time.Time, v cycleView) {
	{{ c, p := *v.Cycle, *v.Planning.Proposal }}
	{{ ds := proposalDays(c, p) }}
	@cycleHeader(now, c, v.Upcoming, ds)
	@decisionAlert(v.Refusal)
	@web.SideColumn(proposalSection(p, ds, v.Planning.Notes, v.Note, v.Note != "" || errors.Is(v.Refusal, ErrStartsInThePast) || clashed(v.Refusal))) {
		@web.Section(2, web.T(ctx, msgDays)) {
			@figureHeads(p.Targets)
			@daysBefore(p.Trailing)
			for _, d := range ds {
				@web.Group(dayTitle(ctx, d), dayLine(p.Targets, d), false) {
					@dayBody(d)
				}
			}
		}
		@dropSection(c, v.Upcoming)
	}
	if v.Upcoming {
		@web.SideSheet(dropSheetID, web.T(ctx, msgDropCycle))
	}
	@web.SideSheet(draftSheetID, web.T(ctx, msgNewRecipe))
}

// cycleHeader is the head of the Cycle page with a Plan: the Cycle's dates beside the
// title, and its Delivery under it.
templ cycleHeader(now time.Time, c Cycle, upcoming bool, ds []proposalDay) {
	@web.PageHeaderBeside("献立", web.T(ctx, msgCycle), dates(ctx, c), now) {
		@deliveryLine(c, upcoming, ds)
	}
}

// dropSection is Section 03, dropping the Cycle c, apart at the end, only while upcoming.
templ dropSection(c Cycle, upcoming bool) {
	if upcoming {
		@web.Section(3, web.T(ctx, msgUpcomingCycle)) {
			@web.Actions() {
				@web.RemoveLink(dropSheetID, dropURL(c.ID), dropURL(c.ID)+"/sheet") {
					{ web.T(ctx, msgDropCycle) }
				}
			}
		}
	}
}

// deliveryLine is the soft line under the Cycle's title: its Delivery's day and window,
// Tentative while upcoming, and the Slot the first day is planned from when it is
// planned only partly.
templ deliveryLine(c Cycle, upcoming bool, ds []proposalDay) {
	<p class="lede">
		{ web.T(ctx, msgDelivery) + " " + web.Tf(ctx, msgWindow, web.ShortDate(ctx, c.Delivery.On), web.TimeOfDay(ctx, c.Delivery.From), web.TimeOfDay(ctx, c.Delivery.To)) }
		if upcoming {
			{ " " }
			@web.Tag(false, "") {
				{ web.T(ctx, msgTentative) }
			}
			{ " " }
			// A span: web.Hint is a <p>, which can't sit in the lede.
			<span class="hint">{ web.T(ctx, msgTentativeHint) }</span>
		}
		{{ first := firstFilled(ds) }}
		if from, partly := first.plannedFrom(); partly {
			{ " · " + web.Tf(ctx, msgPlannedFrom, web.ShortDate(ctx, first.On), web.T(ctx, web.SlotKindNames[from])) }
		}
	</p>
}

// proposalSection is the Plan Proposal p as Section 01, all deciding on it needs: the
// planner's summary, the averages against the Targets, the days of `ds` it changes, the
// soft misses grouped by kind, the Recipe Drafts it prepares, then approving it or
// rejecting it, `notes` being the Cycle's Planning Notes, newest first, and `note` the
// one typed; rejecting is open when `reject` says to.
templ proposalSection(p Proposal, ds []proposalDay, notes []string, note string, reject bool) {
	@web.Section(1, web.T(ctx, msgPlanProposal)) {
		@web.Markdown(p.Summary)
		@averages(p)
		@changedRow(ds)
		@missRows(p)
		@draftedRows(p.Drafted)
		@decision(p, notes, note, reject)
	}
}

// averages are p's average over the days it judges against each Target, under heads
// naming each Target's unit and bounds, those missed marked, and the line saying when a
// figure is marked; nothing when no day is judged.
templ averages(p Proposal) {
	if judged := domain.Judged(p.Days); len(judged) > 0 {
		{{ avg := domain.Average(judged) }}
		@web.RowsHead(web.T(ctx, msgAverage))
		@figureHeads(p.Targets)
		@figureLine(avg, averageMissed(p.Targets, avg))
		@web.Hint() {
			{ web.Tf(ctx, msgMarkRule) }
		}
	}
}

// figureHeads head the four Targets' columns: each names its Target with the unit, then
// gives the bounds.
templ figureHeads(t domain.Targets) {
	<span class="figures figures-head">
		for _, target := range domain.Aimed {
			<span>
				<span>{ web.T(ctx, targetMessages[target].head) }</span>
				<span>
					@bounds(t, target)
				</span>
			</span>
		}
	</span>
}

// figureLine is n's values of what the Targets aim at, whole, a column each, named for a
// screen reader, those missed marked worth weighing, under or over, if missed says.
templ figureLine(n domain.PortionNutrition, missed func(domain.Target) (bool, bool)) {
	@web.Figures() {
		for _, target := range domain.Aimed {
			{{ a, floor := n.Of(target) }}
			{{ a.Value = math.Round(a.Value) }}
			<span>
				<span class="sr-only">{ web.T(ctx, targetMessages[target].word) + " " }</span>
				if off, under := missOf(missed, target); off {
					@worthWeighing(under) {
						@web.Amount(a, floor, "")
					}
				} else {
					@web.Amount(a, floor, "")
				}
			</span>
		}
	}
}

// changedRow is the line saying which of its days `ds` a Plan Proposal changes of the
// Plan it replaces, led by the changed icon: nothing when it replaces none, or
// changes nothing.
templ changedRow(ds []proposalDay) {
	if first, last, ok := changedDays(ds); ok {
		@web.Rows() {
			@web.Row() {
				@web.Icon("changed")
				<span class="row-title">{ web.Tf(ctx, msgChangesFrom, dayRange(ctx, changedRange(first, last))) }</span>
			}
		}
	}
}

// changedRange is the days from first to last as dayRange reads them: one when they
// are the same.
func changedRange(first, last time.Time) []domain.Day {
	if first.Equal(last) {
		return []domain.Day{{On: first}}
	}
	return []domain.Day{{On: first}, {On: last}}
}

// changedDays are the first and last of `ds`, in order, marked changed, `ok` false when
// none is.
func changedDays(ds []proposalDay) (first, last time.Time, ok bool) {
	for _, d := range ds {
		if d.changed {
			if !ok {
				first = d.On
			}
			last, ok = d.On, true
		}
	}
	return first, last, ok
}

// missRows are p's soft misses beside the averages, a line per kind, each led by its
// icon: the days more than 25% off a Target, each with the Targets it misses; each
// Portion eaten back to back; the Portions carried in left unused; then, as
// information, the Portions made for after the Cycle.
templ missRows(p Proposal) {
	{{ off := daysOff(p.Misses) }}
	{{ after := p.Plan.MadeForAfter() }}
	if len(off) > 0 || slices.ContainsFunc(p.Misses, notTargets) || len(after) > 0 {
		@web.Rows() {
			if len(off) > 0 {
				@web.Row() {
					@web.Icon("scale")
					<span class="row-title">{ daysOffTitle(ctx, len(off)) }</span>
					<span class="row-meta">
						for _, d := range off {
							<span>
								{ web.ShortDate(ctx, d[0].On) + ": " }
								for i, m := range d {
									if i > 0 {
										{ " " }
									}
									@worthWeighing(m.Under) {
										{ web.T(ctx, targetMessages[m.Target].word) }
									}
								}
							</span>
						}
					</span>
				}
			}
			for _, m := range p.Misses {
				if m.Rule == domain.RuleBackToBack {
					@web.Row() {
						@web.Icon("repeat")
						<span class="row-title">{ backToBack(ctx, m) }</span>
					}
				}
			}
			for _, m := range p.Misses {
				if m.Rule == domain.RuleUnusedPortion {
					@web.Row() {
						@web.Icon("package")
						<span class="row-title">{ web.Tf(ctx, msgUnused, m.Name, m.Count, m.Held, web.T(ctx, web.InLocations[m.Location])) }</span>
					}
				}
			}
			for _, m := range after {
				@web.Row() {
					@web.Icon("snowflake")
					<span class="row-title hint">{ web.Tf(ctx, msgMadeForAfter, m.Name, m.Portions, web.T(ctx, web.InLocations[m.Location])) }</span>
				}
			}
		}
	}
}

// draftedRows are the Recipe Drafts a Plan Proposal prepares, a line each naming it and
// how many new Ingredients it has, which opens it in a sheet.
templ draftedRows(drafted []recipes.Drafted) {
	if len(drafted) > 0 {
		@web.Rows() {
			for _, d := range drafted {
				@web.Row() {
					@web.Icon("book-open")
					<span class="row-title">
						@web.SideSheetLink(draftSheetID, draftURL(d.ID), draftURL(d.ID)+"/sheet") {
							{ web.Tf(ctx, msgNewRecipeNamed, d.Recipe.Name) }
						}
					</span>
					<span class="row-meta">{ newIngredients(ctx, d.Recipe) }</span>
				}
			}
		}
	}
}

// newIngredients says how many of rec's Ingredients are new, or nothing when none is.
func newIngredients(ctx context.Context, rec domain.Recipe) string {
	n := 0
	for _, ri := range rec.Ingredients {
		if ri.Ingredient.IsNew() {
			n++
		}
	}
	switch n {
	case 0:
		return ""
	case 1:
		return web.T(ctx, msgOneNewIngredient)
	}
	return web.Tf(ctx, msgNewIngredients, n)
}

// draftPage is the planner's Recipe Draft rec as a page of its own, for a browser without
// htmx: the sheet's body, under the page's header, with a link back to the Cycle cycleID
// its Plan Proposal plans.
templ draftPage(now time.Time, rec domain.Recipe, cycleID int64) {
	@web.Layout(web.T(ctx, msgNewRecipe), web.PlanTab) {
		@web.PageHeader("献立", web.T(ctx, msgNewRecipe), now) {
			<p class="lede">
				@web.TextLink(templ.Attributes{"href": string(cycleURL(cycleID))}) {
					{ web.T(ctx, msgBackToTheProposal) }
				}
			</p>
		}
		@recipes.DraftedRecipe(rec)
	}
}

// notTargets is whether m is a miss of a rule other than the Targets'.
func notTargets(m domain.Miss) bool {
	return m.Rule == domain.RuleBackToBack || m.Rule == domain.RuleUnusedPortion
}

// daysOff are the days misses holds more than 25% off a Target, in order, each the
// misses of that day.
func daysOff(misses []domain.Miss) [][]domain.Miss {
	var off [][]domain.Miss
	for _, m := range misses {
		if m.Rule != domain.RuleDayOff {
			continue
		}
		if n := len(off); n > 0 && off[n-1][0].On.Equal(m.On) {
			off[n-1] = append(off[n-1], m)
		} else {
			off = append(off, []domain.Miss{m})
		}
	}
	return off
}

// daysOffTitle says n days are more than 25% off a Target.
func daysOffTitle(ctx context.Context, n int) string {
	if n == 1 {
		return web.Tf(ctx, msgOneDayOff)
	}
	return web.Tf(ctx, msgDaysOff, n)
}

// backToBack is m, a Portion eaten back to back, with its days.
func backToBack(ctx context.Context, m domain.Miss) string {
	days := make([]string, len(m.Days))
	for i, d := range m.Days {
		days[i] = web.ShortDate(ctx, d)
	}
	list := days[0]
	if n := len(days); n > 1 {
		list = web.Tf(ctx, msgAnd, strings.Join(days[:n-1], ", "), days[n-1])
	}
	return web.Tf(ctx, msgBackToBack, m.Name, list)
}

// decision is approving p, and beside it Reject, which opens in place to the Cycle's
// earlier Planning Notes, notes, newest first, the line saying what a note does, and
// the note, as typed: open when open says the User is at it, as when a rejection or an
// approval was refused.
templ decision(p Proposal, notes []string, note string, open bool) {
	@web.Actions() {
		<form novalidate id="approve" method="post" action={ templ.SafeURL(fmt.Sprintf("/plan/proposals/%d/approve", p.ID)) }>
			@web.Button(templ.Attributes{"type": "submit"}) {
				{ web.T(ctx, msgApprove) }
			}
		</form>
		@web.TextButtonFold(web.T(ctx, msgReject), open) {
			@earlierNotes(notes)
			@noteForm("reject", fmt.Sprintf("/plan/proposals/%d/reject", p.ID), msgRejectHint, msgReject, note, false, "")
		}
	}
}

// noteForm is the form id posting a Planning Note to action: the line hint saying what
// the note does, the note as typed, optional unless required, refused with err if not
// "", and its button, send.
templ noteForm(id, action string, hint, send web.Message, note string, required bool, err string) {
	<form novalidate id={ id } class="stack" method="post" action={ templ.SafeURL(action) }>
		@web.Hint() {
			{ web.T(ctx, hint) }
		}
		@web.Field(web.T(ctx, msgPlanningNote), optionalUnless(ctx, required), err) {
			<textarea
				name="note"
				rows="3"
				required?={ required }
				if err != "" {
					aria-invalid="true"
				}
			>{ note }</textarea>
		}
		@web.Actions() {
			@web.Button(templ.Attributes{"type": "submit"}) {
				{ web.T(ctx, send) }
			}
		}
	</form>
}

// optionalUnless is how a Field marks a Planning Note optional, unless required.
func optionalUnless(ctx context.Context, required bool) string {
	if required {
		return ""
	}
	return web.T(ctx, msgOptional)
}

// earlierNotes are the Cycle's earlier Planning Notes, notes, newest first, under their
// head: nothing before the first.
templ earlierNotes(notes []string) {
	if len(notes) > 0 {
		@web.RowsHead(web.T(ctx, msgEarlierNotes))
		@web.Rows() {
			for _, n := range notes {
				@web.Row() {
					<span class="row-title">{ n }</span>
				}
			}
		}
	}
}

// daysBefore are the days before a Plan Proposal, trailing, folded into one Group: how
// many an approved Plan covered and how many none did; opened, each covered day with
// its figures, and the days no Plan covered collapsed into ranges.
templ daysBefore(trailing []domain.Day) {
	if len(trailing) > 0 {
		@web.Group(web.Tf(ctx, msgDaysBefore, len(trailing)), text(beforeLine(ctx, trailing)), false) {
			@web.Rows() {
				for _, r := range dayRuns(trailing) {
					@web.Row() {
						if r[0].Filled == 0 {
							<span class="row-title">{ web.Tf(ctx, msgNoPlanOn, dayRange(ctx, r)) }</span>
						} else {
							<span class="row-title">{ web.ShortDate(ctx, r[0].On) }</span>
							@figureLine(r[0].Nutrition, nil)
						}
					}
				}
			}
		}
	}
}

// text is s as a component.
templ text(s string) {
	{ s }
}

// beforeLine says how many of the days before an approved Plan covered, and how many
// none did, leaving out a count of none.
func beforeLine(ctx context.Context, trailing []domain.Day) string {
	planned := 0
	for _, d := range trailing {
		if d.Filled > 0 {
			planned++
		}
	}
	var parts []string
	if planned > 0 {
		parts = append(parts, web.Tf(ctx, msgOnPlan, planned))
	}
	if none := len(trailing) - planned; none > 0 {
		parts = append(parts, web.Tf(ctx, msgWithNoPlan, none))
	}
	return strings.Join(parts, ", ")
}

// dayRuns are days split into runs: each day a Plan covered alone, and the days in a
// row no Plan covered together.
func dayRuns(days []domain.Day) [][]domain.Day {
	var runs [][]domain.Day
	for i, d := range days {
		if n := len(runs); n > 0 && d.Filled == 0 && days[i-1].Filled == 0 {
			runs[n-1] = append(runs[n-1], d)
		} else {
			runs = append(runs, []domain.Day{d})
		}
	}
	return runs
}

// dayRange is the days r, as their first and last, or the one day.
func dayRange(ctx context.Context, r []domain.Day) string {
	if len(r) == 1 {
		return web.ShortDate(ctx, r[0].On)
	}
	return web.Tf(ctx, msgDates, web.ShortDate(ctx, r[0].On), web.ShortDate(ctx, r[len(r)-1].On))
}

// proposalDay is a day a Plan Proposal plans: its nutrition, whether partly, its Slots
// filled and its Prep Sessions.
type proposalDay struct {
	domain.Day
	planDay
}

// proposalDays are the days p plans of c, each with what fills its Slots and what is
// prepared on it, and the Delivery's day with p's freezer splits, first, if it has any or
// changes the Plan's.
func proposalDays(c Cycle, p Proposal) []proposalDay {
	byDay := map[time.Time]planDay{}
	for _, d := range days(c, p) {
		byDay[d.on] = d
	}
	out := make([]proposalDay, len(p.Days))
	for i, d := range p.Days {
		out[i] = proposalDay{Day: d, planDay: byDay[d.On]}
	}
	if len(p.Plan.FreezerSplits) == 0 && !p.SplitsChanged {
		return out
	}
	if len(out) == 0 || !out[0].On.Equal(c.Delivery.On) {
		out = append([]proposalDay{{Day: domain.Day{On: c.Delivery.On}, planDay: planDay{on: c.Delivery.On}}}, out...)
	}
	out[0].splits, out[0].changedSplits, out[0].splitsChanged = p.Plan.FreezerSplits, p.ChangedSplits, p.SplitsChanged
	out[0].changed = out[0].changed || p.SplitsChanged
	return out
}

// firstFilled is the first of ds that fills a Slot, past a Delivery's day holding only
// freezer splits, or none.
func firstFilled(ds []proposalDay) proposalDay {
	for _, d := range ds {
		if len(d.filled) > 0 {
			return d
		}
	}
	return proposalDay{}
}

// plannedFrom is the Slot d is planned from, its first filled, and whether that is d
// being planned only partly: a Plan fills every Slot from its first on.
func (d proposalDay) plannedFrom() (domain.SlotKind, bool) {
	if !d.Partly || len(d.filled) == 0 {
		return "", false
	}
	return d.filled[0].kind, true
}

// dayTitle is d's date, and the Slot it is planned from when only partly.
func dayTitle(ctx context.Context, d proposalDay) string {
	if from, partly := d.plannedFrom(); partly {
		return web.Tf(ctx, msgFromSlot, web.Date(ctx, d.On), web.T(ctx, web.SlotKindNames[from]))
	}
	return web.Date(ctx, d.On)
}

// dayLine is d's row under its date: marked Changed when its Plan Proposal changes it,
// its figures, each more than 25% off a Target of t marked, then what is cooked on it
// and its active minutes, when a Slot of it is filled; and how many freezer splits it
// has, if any.
templ dayLine(t domain.Targets, d proposalDay) {
	if d.changed {
		// A span, as Today's Tag is: the line's own children stretch across it.
		<span>
			@web.Changed()
		</span>
	}
	if len(d.filled) > 0 {
		@figureLine(d.Nutrition, dayMissed(t, d.Day))
		<span>{ cooked(ctx, d.sessions) }</span>
	}
	if n := len(d.splits); n > 0 {
		<span>
			@web.Icon("snowflake")
			{ web.Tf(ctx, msgToFreezerCount, n) }
		</span>
	}
}

// cooked names the Recipes sessions cook, with their active minutes together, or says
// nothing is cooked.
func cooked(ctx context.Context, sessions []domain.PrepSession) string {
	var names []string
	active := 0
	for _, ps := range sessions {
		if ps.Recipe != nil {
			names = append(names, ps.Name())
			active += ps.Recipe.ActiveMinutes
		}
	}
	if len(names) == 0 {
		return web.T(ctx, msgNothingCooked)
	}
	return web.Tf(ctx, msgCooked, strings.Join(names, ", "), active)
}

// dayBody is what a day d holds: its freezer splits, each marked when changed, or that
// none is left when they all are; then its Slots, each with its Portion's size, calories
// and protein, and where it comes from, then each Prep Session of a Recipe, which opens
// to its Ingredients and the Portions it leaves for later.
templ dayBody(d proposalDay) {
	if len(d.splits) > 0 || d.splitsChanged {
		@web.RowsHead(web.T(ctx, msgToFreezer))
		if len(d.splits) > 0 {
			@web.IngredientRowsWith(d.splits, d.changedSplits, nil)
		} else {
			@web.Rows() {
				@web.Row() {
					@web.RowTitle(web.T(ctx, msgNothingToFreezer), false, "", false)
				}
			}
		}
	}
	if len(d.filled) > 0 {
		@web.RowsHead(web.T(ctx, msgSlots))
		@web.Rows() {
			for _, f := range d.filled {
				@web.SlotRow(f.kind, f.name, f.changed, sizeOf(ctx, f.size), kcalProtein(f.nutrition), source(ctx, f, d.On))
			}
		}
	}
	if slices.ContainsFunc(d.sessions, ofRecipe) {
		@web.RowsHead(web.T(ctx, msgPrepSessions))
		@web.Rows() {
			for i, ps := range d.sessions {
				if ofRecipe(ps) {
					@cookedRow(ps, d.changedSessions[i])
				}
			}
		}
	}
}

// ofRecipe is whether ps prepares a Recipe, not one Ingredient as it is.
func ofRecipe(ps domain.PrepSession) bool { return ps.Recipe != nil }

// source says where f's Portion comes from, eaten on the day on: cooked that day, or a
// new Recipe when that is a Recipe Draft's, from the day it was cooked and where it is
// kept, where one Ingredient is kept, or already in the kitchen.
func source(ctx context.Context, f filledSlot, on time.Time) string {
	switch {
	case f.from == nil:
		return web.T(ctx, msgInTheKitchen)
	case f.from.Recipe == nil:
		return web.T(ctx, web.InLocations[f.location])
	case f.from.At.On.Equal(on) && f.from.Recipe.IsDraft():
		return web.T(ctx, msgNewRecipeSource)
	case f.from.At.On.Equal(on):
		return web.T(ctx, msgCookedThatDay)
	}
	return web.Tf(ctx, msgCookedOn, web.ShortDate(ctx, f.from.At.On), web.T(ctx, web.InLocations[f.location]))
}

// cookedRow is ps, a Prep Session of a Recipe, as a row that opens, marked Changed when
// changed: its Portions and their size, its minutes; opened, its Ingredients scaled, and
// its Portions eaten on a later day or after the Cycle.
templ cookedRow(ps domain.PrepSession, changed bool) {
	@web.FoldRow(cookedLine(ps, changed)) {
		@web.RowsHead(web.T(ctx, msgIngredients))
		@web.IngredientRows(ps.Ingredients())
		if later := eatenLater(ps); len(later) > 0 {
			@web.RowsHead(web.T(ctx, msgEatenLater))
			@web.Rows() {
				for _, pp := range later {
					@web.Row() {
						<span class="row-title">{ laterSlot(ctx, pp.EatAt) }</span>
						<span class="row-meta">{ web.Capitalised(web.T(ctx, web.InLocations[pp.Location])) }</span>
					}
				}
			}
		}
	}
}

// cookedLine is the line a Prep Session of a Recipe folds to: its name, a Recipe Draft's
// marked new, and marked Changed when changed, its Portions and their size, its minutes
// in all and active.
templ cookedLine(ps domain.PrepSession, changed bool) {
	@web.RowTitle(ps.Name(), ps.Recipe.IsDraft(), web.T(ctx, msgNewRecipeSource), changed)
	<span class="row-figure">{ web.Tf(ctx, msgPortionsSized, len(ps.Portions), size(ctx, ps.Size)) }</span>
	<span class="row-meta">{ web.Tf(ctx, msgTotalActive, ps.Recipe.TotalMinutes, ps.Recipe.ActiveMinutes) }</span>
}

// eatenLater are ps's Portions eaten on a day after it is prepared, or after the Cycle.
func eatenLater(ps domain.PrepSession) []domain.PlannedPortion {
	var later []domain.PlannedPortion
	for _, pp := range ps.Portions {
		if pp.EatAt == nil || !pp.EatAt.On.Equal(ps.At.On) {
			later = append(later, pp)
		}
	}
	return later
}

// laterSlot is the Slot a Portion is eaten at, or after the Cycle for none.
func laterSlot(ctx context.Context, s *domain.Slot) string {
	if s == nil {
		return web.T(ctx, msgAfterTheCycle)
	}
	return web.Tf(ctx, msgSlotOn, web.Capitalised(web.T(ctx, web.SlotKindNames[s.Kind])), web.ShortDate(ctx, s.On))
}
