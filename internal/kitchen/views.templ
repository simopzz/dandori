package kitchen

import (
	"context"
	"net/url"
	"strconv"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/ingredients"
	"github.com/simopzz/dandori/internal/web"
)

// countSheetID is the Count sheet's id.
const countSheetID = "count"

// movementsSheetID is the Movements sheet's id.
const movementsSheetID = "movements"

// moveSheetID is the Move sheet's id.
const moveSheetID = "move"

// stockID is the id of the list a Count or a move refreshes.
const stockID = "stock"

// page is the Kitchen page at now: what the kitchen holds, the Count sheet its primary
// action opens, cleared each time it closes, and each Stock Item's Movements and its
// move, and the Ingredients, a click away in their side sheets.
templ page(now time.Time, stock []Held, f CountForm) {
	@web.Layout(web.T(ctx, msgKitchenTitle), web.KitchenTab) {
		@web.PageHeader("台所", web.T(ctx, msgKitchen), now) {
			<p class="lede">
				@ingredients.SheetLink()
			</p>
		}
		<div id={ stockID } hx-get="/kitchen/stock" hx-trigger={ movementSaved + " from:body" }>
			@stockList(now, stock)
		</div>
		@web.AddSheet(countSheetID, web.T(ctx, msgCount), false) {
			@web.SheetBody(countSheetID) {
				@countBody(f)
			}
			// Outside the body, so htmx tells this swap to it, and the body doesn't open
			// the sheet that has just closed.
			<div
				hidden
				hx-get="/kitchen/count/sheet"
				hx-trigger={ "toggle[newState=='closed'] from:#" + countSheetID }
				hx-target={ "#" + web.SideSheetBody(countSheetID) }
				hx-swap="innerHTML"
			></div>
		}
		@web.SideSheet(movementsSheetID, web.T(ctx, msgMovements))
		@web.SideSheet(moveSheetID, web.T(ctx, msgMove))
		@ingredients.Sheet()
	}
}

// countPage is the Count form as a page of its own, for a browser without htmx: the
// sheet's body, under the page's header.
templ countPage(now time.Time, f CountForm) {
	@web.Layout(web.T(ctx, msgCountTitle), web.KitchenTab) {
		@web.PageHeader("台所", web.T(ctx, msgCount), now)
		<div id={ web.SideSheetBody(countSheetID) }>
			@countBody(f)
		</div>
		@web.SideSheet(movementsSheetID, web.T(ctx, msgMovements))
		@ingredients.Sheet()
	}
}

// stockList is every Stock Item holding more than nothing under its Storage Location,
// or how to start when there is none.
templ stockList(now time.Time, stock []Held) {
	if len(stock) == 0 {
		@web.Empty() {
			{ web.T(ctx, msgEmptyKitchen) }
		}
	}
	for i, group := range byLocation(stock) {
		@web.Section(i+1, web.T(ctx, locationHeadings[group.location])) {
			@web.Rows() {
				for _, h := range group.held {
					@web.Row() {
						<span class="row-title">
							@web.SideSheetLink(movementsSheetID, stockItemURL("/kitchen/movements", h.Ingredient.ID, h.Location), stockItemURL("/kitchen/movements/sheet", h.Ingredient.ID, h.Location)) {
								{ h.Ingredient.Name }
							}
						</span>
						<span class="row-figure">{ quantity(ctx, h.Item.Held, h.Ingredient.Unit) }</span>
						if !h.Item.Counted.IsZero() {
							<span class="row-meta">{ countedText(ctx, now, h.Item.Counted.In(now.Location())) }</span>
						}
						<span class="row-action">
							@web.SideSheetLink(countSheetID, stockItemURL("/kitchen/count", h.Ingredient.ID, h.Location), stockItemURL("/kitchen/count/sheet", h.Ingredient.ID, h.Location)) {
								{ web.T(ctx, msgCount) }
								<span class="sr-only">{ h.Ingredient.Name }</span>
							}
							@web.SideSheetLink(moveSheetID, stockItemURL("/kitchen/move", h.Ingredient.ID, h.Location), stockItemURL("/kitchen/move/sheet", h.Ingredient.ID, h.Location)) {
								{ web.T(ctx, msgMove) }
								<span class="sr-only">{ h.Ingredient.Name } { web.T(ctx, inLocations[h.Location]) }</span>
							}
						</span>
					}
				}
			}
		}
	}
}

// locationGroup is one Storage Location's Stock Items.
type locationGroup struct {
	location domain.StorageLocation
	held     []Held
}

// byLocation splits stock, in Storage Location order, into a group each.
func byLocation(stock []Held) []locationGroup {
	var groups []locationGroup
	for _, h := range stock {
		if len(groups) == 0 || groups[len(groups)-1].location != h.Location {
			groups = append(groups, locationGroup{location: h.Location})
		}
		last := &groups[len(groups)-1]
		last.held = append(last.held, h)
	}
	return groups
}

// stockItemURL is path, asking for the Stock Item of the Ingredient id in location.
func stockItemURL(path string, id int64, location domain.StorageLocation) templ.SafeURL {
	query := url.Values{"ingredient": {strconv.FormatInt(id, 10)}, "location": {string(location)}}
	return templ.SafeURL(path + "?" + query.Encode())
}

// movementsPage is a Stock Item's Movements as a page of their own, for a browser without
// htmx: the sheet's body, under the page's header.
templ movementsPage(now time.Time, item StockItemMovements) {
	@web.Layout(web.T(ctx, msgMovementsTitle), web.KitchenTab) {
		@web.PageHeader("台所", web.T(ctx, msgMovements), now)
		@movementsBody(now, item, false)
	}
}

// movementsBody is a Stock Item's Movements, newest first, to read: a mistake in one is
// corrected by another Count, never here. Above them each Storage Location is a link,
// so a move can be followed from one side to the other, swapping the body when inSheet.
templ movementsBody(now time.Time, item StockItemMovements, inSheet bool) {
	@web.SegmentedLinks(web.T(ctx, msgLocations)) {
		for _, l := range domain.StorageLocations {
			@web.SegmentLink(l == item.Location, movementsLink(item, l, inSheet)) {
				{ web.T(ctx, locationHeadings[l]) }
			}
		}
	}
	@web.Section(0, web.Tf(ctx, msgStockItem, item.Ingredient.Name, web.T(ctx, locationHeadings[item.Location]))) {
		if len(item.Movements) == 0 {
			@web.Empty() {
				{ web.T(ctx, msgNoMovements) }
			}
		} else {
			@web.Rows() {
				for _, m := range item.Movements {
					@web.Row() {
						<span class="row-title">{ causeText(ctx, m, item.Location) }</span>
						<span class="row-figure">{ web.Tf(ctx, msgBeforeAfter, quantity(ctx, m.Before, item.Ingredient.Unit), quantity(ctx, m.After, item.Ingredient.Unit)) }</span>
						<span class="row-meta">
							<span>{ happenedText(ctx, now, m.At.In(now.Location())) }</span>
							if m.Note != "" {
								<em>{ m.Note }</em>
							}
						</span>
					}
				}
			}
		}
	}
}

// movementsLink opens the Movements in l of item's Ingredient: the page of them, or
// inSheet the sheet's body, where the link to item takes the focus back from the link
// the swap removed.
func movementsLink(item StockItemMovements, l domain.StorageLocation, inSheet bool) templ.Attributes {
	link := templ.Attributes{"href": string(stockItemURL("/kitchen/movements", item.Ingredient.ID, l))}
	if inSheet {
		link["hx-get"] = string(stockItemURL("/kitchen/movements/sheet", item.Ingredient.ID, l))
		link["hx-target"] = "#" + web.SideSheetBody(movementsSheetID)
		link["hx-swap"] = "innerHTML"
		link["autofocus"] = l == item.Location
	}
	return link
}

// happenedText says when a Movement happened, told in at's zone, with its year unless
// that is now's.
func happenedText(ctx context.Context, now, at time.Time) string {
	if at.Year() != now.Year() {
		return web.Tf(ctx, msgHappened, web.ShortDateInYear(ctx, at), at.Format("15:04"))
	}
	return web.Tf(ctx, msgHappened, web.ShortDate(ctx, at), at.Format("15:04"))
}

// countedText says when a Stock Item was last counted, told in now's zone, with its date
// unless it was today.
func countedText(ctx context.Context, now, at time.Time) string {
	if y, m, d := at.Date(); y == now.Year() && m == now.Month() && d == now.Day() {
		return web.Tf(ctx, msgCountedAt, at.Format("15:04"))
	}
	return web.Tf(ctx, msgCountedOn, happenedText(ctx, now, at))
}

// countBody is the Count just saved, if any, then the form of the Ingredient chosen, or
// else the search for one.
templ countBody(f CountForm) {
	if f.Counted != nil {
		@web.Notice() {
			{ web.Tf(ctx, msgCounted, f.Counted.Ingredient.Name, quantity(ctx, f.Counted.Stated, f.Counted.Ingredient.Unit), web.T(ctx, inLocations[f.Counted.Location])) }
		}
	}
	if f.Ingredient != nil {
		@countForm(f)
	} else {
		@countSearch(f.Query)
		<div
			id="count-list"
			hx-get="/kitchen/count/list"
			hx-trigger={ "toggle[newState=='closed'] from:#" + ingredients.SheetID }
			hx-include="#count-search"
		>
			@foundList(f.Found, f.Staple, f.Query)
		</div>
	}
}

// countSearch finds an Ingredient to count as the User types, swapping the list alone
// when htmx sends it, so the field keeps its focus; without htmx it opens the Count
// page searched.
templ countSearch(q string) {
	<form
		id="count-search"
		role="search"
		method="get"
		action="/kitchen/count"
		hx-get="/kitchen/count/list"
		hx-trigger="submit, input delay:300ms"
		hx-target="#count-list"
		hx-swap="innerHTML"
	>
		@web.SearchField(web.T(ctx, msgSearch)) {
			<input type="search" name="q" value={ q } placeholder={ web.T(ctx, msgSearch) } autocomplete="off" autofocus/>
		}
	</form>
}

// foundList is the Ingredients a search for q found to count, each opening its form;
// or why the Staple it named isn't one of them; or the offer to add what nothing matched.
templ foundList(found []domain.Ingredient, staple, q string) {
	if staple != "" {
		@web.Empty() {
			{ web.Tf(ctx, msgStaple, staple) }
		}
	} else if len(found) == 0 {
		@web.Empty() {
			if q == "" {
				{ web.T(ctx, msgNothingToCount) }
			} else {
				{ web.Tf(ctx, msgNoMatch, q) }
			}
		}
		@ingredients.AddLink(q)
	} else {
		@web.Rows() {
			for _, ing := range found {
				@web.Row() {
					<a
						class="row-title"
						href={ chooseURL("/kitchen/count", ing) }
						hx-get={ string(chooseURL("/kitchen/count/sheet", ing)) }
						hx-target={ "#" + web.SideSheetBody(countSheetID) }
						hx-swap="innerHTML"
					>{ ing.Name }</a>
					<span class="row-meta">{ web.T(ctx, ingredients.StorageLocationNames[ing.Usual]) }</span>
				}
			}
		}
	}
}

// chooseURL is path, asking for the form of ing.
func chooseURL(path string, ing domain.Ingredient) templ.SafeURL {
	return templ.SafeURL(path + "?ingredient=" + strconv.FormatInt(ing.ID, 10))
}

// countForm counts f's Ingredient, swapping the sheet's body when htmx posts it. Each
// Storage Location shows what Dandori believes it holds, with no request to choose it.
// Choose another changes what the legend names, so it stands beside it. Movements opens
// the Storage Location chosen when it is followed, which htmx includes; without htmx, the
// one the form started on, whose Movements link the other two.
templ countForm(f CountForm) {
	<form
		id="count-form"
		method="post"
		action="/kitchen/count"
		hx-post="/kitchen/count"
		hx-target={ "#" + web.SideSheetBody(countSheetID) }
		hx-swap="innerHTML"
	>
		<input type="hidden" name="ingredient" value={ strconv.FormatInt(f.Ingredient.ID, 10) }/>
		@web.FieldGroupAction("count-ingredient", 0, f.Ingredient.Name, chooseAnother()) {
			<div class="stack">
				<div>
					@web.Hint() {
						{ web.T(ctx, msgWhere) }
					}
					@web.Segmented(web.T(ctx, msgWhere), "location", locationChoices(ctx, f), string(f.Location), f.Errs["location"])
				</div>
				@web.Field(web.T(ctx, msgStated), "", f.Errs["stated"]) {
					<input
						type="number"
						inputmode="decimal"
						min="0"
						step={ quantityStep(f.Ingredient.Unit) }
						name="stated"
						value={ f.Stated }
						required
						autocomplete="off"
						autofocus
						{ ingredients.Invalid(f.Errs["stated"])... }
					/>
				}
				@web.Field(web.T(ctx, msgNote), web.T(ctx, msgOptional), "") {
					<input name="note" value={ f.Note } autocomplete="off"/>
				}
				@web.ActionsApart() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgCount) }
					}
					@web.SideSheetLinkWith(movementsSheetID, stockItemURL("/kitchen/movements", f.Ingredient.ID, f.Location), chooseURL("/kitchen/movements/sheet", *f.Ingredient), templ.Attributes{"hx-include": "#count-form [name=location]"}) {
						{ web.T(ctx, msgMovements) }
					}
				}
			</div>
		}
	</form>
}

// chooseAnother is the link beside the name of a Count form's Ingredient.
templ chooseAnother() {
	@web.TextLink(anotherLink()) {
		{ web.T(ctx, msgAnother) }
	}
}

// anotherLink goes back to the search, swapping the sheet's body; without htmx it opens
// the Count page.
func anotherLink() templ.Attributes {
	return templ.Attributes{
		"href":      "/kitchen/count",
		"hx-get":    "/kitchen/count/sheet",
		"hx-target": "#" + web.SideSheetBody(countSheetID),
		"hx-swap":   "innerHTML",
	}
}

// locationChoices are the Storage Locations, each with what Dandori believes it holds of
// f's Ingredient.
func locationChoices(ctx context.Context, f CountForm) []web.Choice {
	choices := make([]web.Choice, len(domain.StorageLocations))
	for i, l := range domain.StorageLocations {
		choices[i] = web.Choice{
			Value: string(l),
			Label: web.Tf(ctx, msgHolds, web.T(ctx, ingredients.StorageLocationNames[l]), quantity(ctx, f.Believed[l], f.Ingredient.Unit)),
		}
	}
	return choices
}

// quantityStep is how finely a quantity of unit is stated.
func quantityStep(unit domain.Unit) string {
	if unit == domain.Pieces {
		return "0.1"
	}
	return "1"
}

// movePage is the form that moves a Stock Item as a page of its own, for a browser
// without htmx: the sheet's body, under the page's header.
templ movePage(now time.Time, f MoveForm) {
	@web.Layout(web.T(ctx, msgMoveTitle), web.KitchenTab) {
		@web.PageHeader("台所", web.T(ctx, msgMove), now)
		<div id={ web.SideSheetBody(moveSheetID) }>
			@moveForm(f)
		</div>
	}
}

// moveForm moves f's Stock Item, swapping the sheet's body when htmx posts it. Its target
// starts unchosen, so stock can't go to the wrong place by default.
templ moveForm(f MoveForm) {
	<form
		id="move-form"
		method="post"
		action="/kitchen/move"
		hx-post="/kitchen/move"
		hx-target={ "#" + web.SideSheetBody(moveSheetID) }
		hx-swap="innerHTML"
	>
		<input type="hidden" name="ingredient" value={ strconv.FormatInt(f.Ingredient.ID, 10) }/>
		<input type="hidden" name="location" value={ string(f.From) }/>
		@web.FieldGroup(0, web.Tf(ctx, msgStockItem, f.Ingredient.Name, web.T(ctx, locationHeadings[f.From]))) {
			<div class="stack">
				@web.Field(web.T(ctx, msgMoveQuantity), "", f.Errs["quantity"]) {
					<input
						type="number"
						inputmode="decimal"
						min="0"
						step={ quantityStep(f.Ingredient.Unit) }
						name="quantity"
						value={ f.Quantity }
						required
						autocomplete="off"
						autofocus
						{ ingredients.Invalid(f.Errs["quantity"])... }
					/>
				}
				<div>
					@web.Hint() {
						{ web.T(ctx, msgMoveWhere) }
					}
					@web.Segmented(web.T(ctx, msgMoveWhere), "to", targetChoices(ctx, f), string(f.To), f.Errs["to"])
				</div>
				@web.Field(web.T(ctx, msgNote), web.T(ctx, msgOptional), "") {
					<input name="note" value={ f.Note } autocomplete="off"/>
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgMove) }
					}
				}
			</div>
		}
	</form>
}

// movedNotice confirms a move just saved of moved of ing, in the sheet that made it.
templ movedNotice(ing domain.Ingredient, to domain.StorageLocation, moved domain.Quantity) {
	@web.Notice() {
		{ web.Tf(ctx, msgMoved, quantity(ctx, moved, ing.Unit), ing.Name, web.T(ctx, toLocations[to])) }
	}
}

// targetChoices are the Storage Locations f's Stock Item can move to, each with what
// Dandori believes it holds of the Ingredient.
func targetChoices(ctx context.Context, f MoveForm) []web.Choice {
	var choices []web.Choice
	for _, l := range domain.StorageLocations {
		if l != f.From {
			choices = append(choices, web.Choice{
				Value: string(l),
				Label: web.Tf(ctx, msgHolds, web.T(ctx, ingredients.StorageLocationNames[l]), quantity(ctx, f.Believed[l], f.Ingredient.Unit)),
			})
		}
	}
	return choices
}

// Status says when the scheduler last brought the User's kitchen up to now, at, told in
// now's zone, with its date unless it was today. Before its first beat, ok is false and
// it says nothing.
templ Status(now, at time.Time, ok bool) {
	if ok {
		@web.Hint() {
			{ statusText(ctx, now, at.In(now.Location())) }
		}
	}
}

func statusText(ctx context.Context, now, at time.Time) string {
	if y, m, d := at.Date(); y == now.Year() && m == now.Month() && d == now.Day() {
		return web.Tf(ctx, msgUpToDateAt, at.Format("15:04"))
	}
	return web.Tf(ctx, msgUpToDateOn, web.Date(ctx, at), at.Format("15:04"))
}
