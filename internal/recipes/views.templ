package recipes

import (
	"fmt"

	"github.com/simopzz/dandori/internal/runs"
	"github.com/simopzz/dandori/internal/web"
)

// PortionNutrition is a Recipe's nutritional values per Portion.
type PortionNutrition struct {
	Kcal     int
	ProteinG int
	CarbsG   int
	FatG     int
}

// RecipeSummary is one Recipe in the Recipe Library list.
type RecipeSummary struct {
	ID          int64
	Name        string
	Portions    int
	PrepMinutes int
	PerPortion  PortionNutrition
}

// RecipeLibrary is the Recipe Library page: the paste form and every Recipe.
type RecipeLibrary struct {
	Recipes []RecipeSummary
	// Error is why a paste was rejected.
	Error string
}

// RecipeView is one saved Recipe.
type RecipeView struct {
	ID          int64
	Name        string
	Portions    int
	PrepMinutes int
	Appliances  []string
	Steps       []string
	Ingredients []string // e.g. "600 g chicken breast"
	PerPortion  PortionNutrition
	// Error is why an action on the Recipe failed.
	Error string
}

// RecipeForm is a Recipe as its form shows it, either a parsed draft or a
// saved Recipe being edited: the raw field values, so a rejected
// submission is shown back as typed, and an error per field.
type RecipeForm struct {
	Title  string
	Action string
	Submit string
	// Discard, when set, is where the draft is discarded.
	Discard string
	// Values holds name, portions, prep_minutes and appliances.
	Values      map[string]string
	Steps       []string
	Ingredients []IngredientRow
	Errors      map[string]string
	// Rematched means an Ingredient turned from known to new or back since
	// the form was shown, so it must be checked again.
	Rematched bool
	// Failed means the Recipe was valid but could not be stored.
	Failed bool
	// PerPortion is shown when the Recipe as it stands is valid.
	PerPortion *PortionNutrition
}

// IngredientRow is one Ingredient line of a RecipeForm. A known Ingredient
// keeps its unit and nutritional values; a new one shows them to confirm.
type IngredientRow struct {
	Name     string
	Quantity string
	Unit     string
	Kcal     string
	ProteinG string
	CarbsG   string
	FatG     string
	New      bool
}

// DraftPending is a draft whose parse Run has not produced a Recipe: still
// running, or ended without one.
type DraftPending struct {
	Run  runs.Run
	Page string // the draft's own page, fetched again once the Run ends
}

func ingField(name string, i int) string { return fmt.Sprintf("ing_%s_%d", name, i) }

func formatMinutes(m int) string {
	if m == 0 {
		return "not given"
	}
	return fmt.Sprintf("%d min", m)
}

// RecipeLibraryPage lists the Recipe Library and takes recipe text to parse.
templ RecipeLibraryPage(l RecipeLibrary) {
	@web.Layout("Dandori — Recipes", web.TabRecipes) {
		@web.PageHeader("レシピ", "Recipe Library")
		if len(l.Recipes) == 0 {
			@web.Empty() {
				No Recipes yet.
			}
		} else {
			@web.Rows() {
				for _, r := range l.Recipes {
					@web.Row() {
						<a class="row-title" href={ templ.SafeURL(fmt.Sprintf("/recipes/%d", r.ID)) }>{ r.Name }</a>
						<span class="row-meta">
							{ fmt.Sprintf("%d Portions · %s · %d kcal, %d g protein per Portion", r.Portions, formatMinutes(r.PrepMinutes), r.PerPortion.Kcal, r.PerPortion.ProteinG) }
						</span>
					}
				}
			}
		}
		@web.AddSheet("paste-recipe", "Paste a recipe", l.Error != "") {
			<form class="stack" method="post" action="/recipes/parse">
				@web.Field("Recipe text", "", l.Error) {
					<textarea
						name="text"
						rows="8"
						required
						if l.Error != "" {
							aria-invalid="true"
						}
					></textarea>
				}
				@web.Hint() {
					From a website, a note or a message. It becomes a draft you check before it is saved.
				}
				@web.Actions() {
					@web.Button(templ.Attributes{"type": "submit"}) {
						Parse recipe
					}
				}
			</form>
		}
	}
}

// RecipePage shows one Recipe with its nutritional values per Portion.
templ RecipePage(r RecipeView) {
	@web.Layout("Dandori — "+r.Name, web.TabRecipes) {
		@web.PageHeader("レシピ", r.Name)
		if r.Error != "" {
			@web.Alert() {
				{ r.Error }
			}
		}
		<dl>
			<dt>Portions</dt>
			<dd>{ fmt.Sprint(r.Portions) }</dd>
			<dt>Prep time</dt>
			<dd>{ formatMinutes(r.PrepMinutes) }</dd>
			<dt>Appliances</dt>
			<dd>
				if len(r.Appliances) == 0 {
					none
				}
				for i, a := range r.Appliances {
					if i > 0 {
						{ ", " }
					}
					{ a }
				}
			</dd>
		</dl>
		@perPortion(r.PerPortion)
		@web.Section(1, "Ingredients") {
			<ul>
				for _, ing := range r.Ingredients {
					<li>{ ing }</li>
				}
			</ul>
		}
		@web.Section(2, "Steps") {
			<ol>
				for _, s := range r.Steps {
					<li>{ s }</li>
				}
			</ol>
		}
		@web.Actions() {
			@web.ButtonLink(templ.SafeURL(fmt.Sprintf("/recipes/%d/edit", r.ID))) {
				Edit
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/recipes/%d/delete", r.ID)) }>
				@web.DestructiveButton(templ.Attributes{"type": "submit"}) {
					Delete
				}
			</form>
		}
	}
}

templ perPortion(n PortionNutrition) {
	<dl>
		<dt>Per Portion</dt>
		<dd>
			{ fmt.Sprintf("%d kcal · %d g protein · %d g carbs · %d g fat", n.Kcal, n.ProteinG, n.CarbsG, n.FatG) }
		</dd>
	</dl>
}

// DraftPendingPage follows a parse Run until its draft is ready.
templ DraftPendingPage(d DraftPending) {
	@web.Layout("Dandori — Parsing a recipe", web.TabRecipes) {
		@web.PageHeader("レシピ", "Parsing a recipe")
		if d.Run.Running() {
			@web.Notice() {
				The recipe is being parsed; the draft appears here when it is ready.
			}
		} else {
			@web.Alert() {
				There is no draft to check: the parse Run ended ({ d.Run.StatusLabel() }) without one,
				or its draft was already accepted or discarded.
				<a href="/recipes">Back to the Recipe Library</a>
			}
		}
		@runs.TracePanel(d.Run, d.Page)
	}
}

// RecipeFormPage is a draft to check and accept, or a Recipe to edit.
templ RecipeFormPage(f RecipeForm) {
	@web.Layout("Dandori — "+f.Title, web.TabRecipes) {
		@web.PageHeader("レシピ", f.Title)
		<form id="recipe" method="post" action={ templ.SafeURL(f.Action) }>
			if f.Failed {
				@web.Alert() {
					The Recipe could not be saved; try again. Details are in the server log.
				}
			}
			if f.Rematched {
				@web.Alert() {
					Some Ingredients changed between known and new; check them and submit again.
				}
			} else if len(f.Errors) > 0 {
				@web.Alert() {
					The Recipe was not saved; fix the fields marked below.
				}
			}
			<div class="stack section">
				@textField(f, "name", "Name")
				@web.FieldRow() {
					@recipeNumberField(f, "portions", "Portions", "", "1")
					@recipeNumberField(f, "prep_minutes", "Prep time", "min", "0")
				}
				if f.PerPortion != nil {
					@perPortion(*f.PerPortion)
				}
			</div>
			@web.FieldGroup(1, "Ingredients") {
				@web.Hint() {
					Quantities are in each Ingredient's unit. Nutritional values are per 100 g, per 100 ml or per piece.
					Ingredients marked { " " }
					@web.Tag(true, "") {
						New
					}
					{ " " } are not in your Recipe Library yet: check their values.
					Clear a row's name and quantity to remove it.
				}
				if msg := f.Errors["ingredients"]; msg != "" {
					<p>
						@web.FieldError(msg)
					</p>
				}
				<div class="ingredient-grid">
					<div class="ingredient-head" aria-hidden="true">
						<span></span>
						<span>Ingredient</span>
						<span>Quantity</span>
						<span>Unit</span>
						<span>kcal</span>
						<span>Protein (g)</span>
						<span>Carbs (g)</span>
						<span>Fat (g)</span>
					</div>
					<div id="ingredients">
						for i, row := range f.Ingredients {
							@ingredientRow(f, i, row)
						}
					</div>
				</div>
				<template id="ingredients-template">
					@ingredientRow(RecipeForm{}, 0, IngredientRow{Unit: "g", New: true})
				</template>
				@web.TextButton(templ.Attributes{"type": "button", "data-add": "ingredients"}) {
					+ Add Ingredient
				}
			}
			<div class="section">
				@web.Field("Appliances", "one per line", "") {
					<textarea name="appliances" rows="2">{ f.Values["appliances"] }</textarea>
				}
			</div>
			@web.FieldGroup(2, "Steps") {
				@web.Hint() {
					Clear a step to remove it.
				}
				<ol id="steps" class="draft-steps">
					for _, s := range f.Steps {
						@stepField(s)
					}
				</ol>
				<template id="steps-template">
					@stepField("")
				</template>
				@web.TextButton(templ.Attributes{"type": "button", "data-add": "steps"}) {
					+ Add step
				}
			}
			@web.Actions() {
				@web.Button(templ.Attributes{"type": "submit"}) {
					{ f.Submit }
				}
				if f.Discard != "" {
					@web.DestructiveButton(templ.Attributes{"type": "submit", "form": "discard", "formnovalidate": true}) {
						Discard draft
					}
				}
			}
		</form>
		if f.Discard != "" {
			<form id="discard" method="post" action={ templ.SafeURL(f.Discard) }></form>
		}
		<script src="/static/recipe-form.js" defer></script>
	}
}

templ ingredientRow(f RecipeForm, i int, row IngredientRow) {
	<div class="ingredient-row">
		<input type="hidden" name={ ingField("new", i) } value={ fmt.Sprint(row.New) }/>
		<span class="ingredient-status">
			if row.New && row.Name != "" {
				@web.Tag(true, "New Ingredient: confirm its nutritional values") {
					New
				}
			}
		</span>
		@rowInput(f, ingField("name", i), "Ingredient", row.Name, false)
		@rowInput(f, ingField("quantity", i), "Quantity", row.Quantity, true)
		if row.New {
			@web.CellField("Unit", f.Errors[ingField("unit", i)]) {
				<select name={ ingField("unit", i) }>
					for _, u := range []string{"g", "ml", "piece"} {
						<option value={ u } selected?={ row.Unit == u }>{ u }</option>
					}
				</select>
			}
			@rowInput(f, ingField("kcal", i), "kcal", row.Kcal, true)
			@rowInput(f, ingField("protein_g", i), "Protein (g)", row.ProteinG, true)
			@rowInput(f, ingField("carbs_g", i), "Carbs (g)", row.CarbsG, true)
			@rowInput(f, ingField("fat_g", i), "Fat (g)", row.FatG, true)
			if msg := f.Errors[ingField("nutrition", i)]; msg != "" {
				<span class="ingredient-error">
					@web.FieldError(msg)
				</span>
			}
		} else {
			<span class="unit">
				<input type="hidden" name={ ingField("unit", i) } value={ row.Unit }/>
				{ row.Unit }
			</span>
			<span class="known">Known Ingredient: values from your Recipe Library</span>
		}
	</div>
}

templ stepField(s string) {
	<li>
		<textarea name="steps" rows="1" aria-label="Step">{ s }</textarea>
	</li>
}

templ rowInput(f RecipeForm, name, label, value string, decimal bool) {
	@web.CellField(label, f.Errors[name]) {
		<input
			type="text"
			name={ name }
			value={ value }
			if decimal {
				inputmode="decimal"
			}
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}

templ textField(f RecipeForm, name, label string) {
	@web.Field(label, "", f.Errors[name]) {
		<input
			type="text"
			required
			name={ name }
			value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}

templ recipeNumberField(f RecipeForm, name, label, unit, min string) {
	@web.Field(label, unit, f.Errors[name]) {
		<input
			type="number"
			inputmode="numeric"
			min={ min }
			step="1"
			required
			name={ name }
			value={ f.Values[name] }
			if f.Errors[name] != "" {
				aria-invalid="true"
			}
		/>
	}
}
