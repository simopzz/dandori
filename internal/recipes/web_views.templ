package recipes

import (
	"cmp"
	"context"
	"encoding/json"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/domain"
	"github.com/simopzz/dandori/internal/ingredients"
	"github.com/simopzz/dandori/internal/web"
)

// library is the Recipe Library page: the paste box, as typed in paste, the way to write
// a Recipe, the Recipe Drafts to check, and the User's Recipes a search for q found, with
// the search once there is something to search.
templ library(now time.Time, paste PasteForm, drafts []Draft, recipes []domain.Recipe, q string) {
	@web.Layout(web.T(ctx, msgRecipesTitle), web.RecipesTab) {
		@web.PageHeader("レシピ", web.T(ctx, msgRecipes), now)
		@pasteForm(paste)
		if len(drafts) > 0 {
			@web.Section(0, web.T(ctx, msgDraftsToCheck)) {
				@web.Rows() {
					for _, d := range drafts {
						@web.Row() {
							<a class="row-title" href={ templ.SafeURL(draftURL(d.ID)) }>{ d.Name }</a>
							<span class="row-meta">{ web.Tf(ctx, msgParsedOn, parsedDate(ctx, now, d.StartedAt.In(now.Location()))) }</span>
						}
					}
				}
			}
		}
		@web.Section(0, web.T(ctx, msgRecipes)) {
			if q != "" || len(recipes) > 0 {
				@searchForm(q)
			}
			<div id={ listID }>
				@recipeList(recipes, q)
			</div>
		}
		@web.AddButton([]web.AddChoice{{Title: web.T(ctx, msgWrite), Href: "/recipes/new"}})
	}
}

// listID is the id of the list a search swaps.
const listID = "recipe-list"

// searchForm searches the User's Recipes as they type, swapping the list alone when htmx
// sends it, so the field keeps its focus; without htmx it opens the page searched.
templ searchForm(q string) {
	@web.ListSearch("recipe-search", "/recipes", "/recipes/list", listID, web.T(ctx, msgSearch)) {
		<input type="search" name="q" value={ q } placeholder={ web.T(ctx, msgSearch) } autocomplete="off"/>
	}
}

// recipeList is the User's Recipes a search for q found, or why there are none.
templ recipeList(recipes []domain.Recipe, q string) {
	if len(recipes) == 0 {
		@web.Empty() {
			if q == "" {
				{ web.T(ctx, msgNoRecipes) }
			} else {
				{ web.Tf(ctx, msgNoMatch, q) }
			}
		}
	} else {
		@web.Rows() {
			for _, rec := range recipes {
				@web.Row() {
					<a class="row-title" href={ templ.SafeURL(recipeURL(rec.ID)) }>{ rec.Name }</a>
					<span class="row-meta">
						<span>{ kindsOf(ctx, rec.Kinds) }</span>
						<span>{ web.Tf(ctx, msgMinutes, rec.TotalMinutes) }</span>
						<span>{ web.Tf(ctx, msgKcalPer, web.Number(ctx, rec.NutritionPerPortion().Kcal.Value)) }</span>
					</span>
				}
			}
		}
	}
}

// parsedDate is the day a Recipe Draft was parsed, with its year unless it is now's.
func parsedDate(ctx context.Context, now, at time.Time) string {
	if at.Year() != now.Year() {
		return web.ShortDateInYear(ctx, at)
	}
	return web.ShortDate(ctx, at)
}

// kindsOf names kinds in the order of a day.
func kindsOf(ctx context.Context, kinds []domain.SlotKind) string {
	names := make([]string, len(kinds))
	for i, k := range kinds {
		names[i] = web.T(ctx, web.SlotKindNames[k])
	}
	return strings.Join(names, ", ")
}

// recipePage is one Recipe, all of it, its header leaving room for a rating later.
templ recipePage(now time.Time, rec domain.Recipe) {
	@web.Layout(web.Tf(ctx, msgRecipeTitle, rec.Name), web.RecipesTab) {
		@web.PageHeader("レシピ", rec.Name, now) {
			<p class="lede">
				@web.TextLink(templ.Attributes{"href": recipeURL(rec.ID) + "/edit"}) {
					{ web.T(ctx, msgEdit) }
				}
			</p>
		}
		@recipeFacts(rec)
		@web.Section(0, web.T(ctx, msgPerPortion)) {
			@perPortion(rec.NutritionPerPortion())
		}
		@web.Section(1, web.T(ctx, msgIngredients)) {
			@web.Rows() {
				for _, ri := range rec.Ingredients {
					@web.Row() {
						<span class="row-title">{ ri.Ingredient.Name }</span>
						<span class="row-figure">{ web.Quantity(ctx, ri.Quantity, ri.Ingredient.Unit) }</span>
					}
				}
			}
		}
		@recipeSteps(rec.Steps)
	}
}

// perPortion is one Portion's nutritional values, fibre and sugar a floor when some of
// the Recipe's Ingredients don't know them, and a dash a screen reader says is unknown
// when none does.
templ perPortion(n domain.PortionNutrition) {
	<p class="row-meta">
		<span>{ web.Tf(ctx, msgKcal, web.Number(ctx, n.Kcal.Value)) }</span>
		<span>{ web.T(ctx, msgProtein) + " " + web.Tf(ctx, msgGrams, web.Number(ctx, n.Protein.Value)) }</span>
		<span>{ web.T(ctx, msgCarbs) + " " + web.Tf(ctx, msgGrams, web.Number(ctx, n.Carbs.Value)) }</span>
		<span>{ web.T(ctx, msgFat) + " " + web.Tf(ctx, msgGrams, web.Number(ctx, n.Fat.Value)) }</span>
		@floored(msgFibre, n.Fibre, n.FibreFloor)
		@floored(msgSugar, n.Sugar, n.SugarFloor)
	</p>
}

// floored is one value in grams that may be a floor, or unknown.
templ floored(name web.Message, a domain.Amount, floor bool) {
	<span>
		{ web.T(ctx, name) + " " }
		if !a.Known {
			<span aria-hidden="true">–</span>
			<span class="sr-only">{ web.T(ctx, msgUnknown) }</span>
		} else if floor {
			{ web.Tf(ctx, msgAtLeastGrams, web.Number(ctx, a.Value)) }
		} else {
			{ web.Tf(ctx, msgGrams, web.Number(ctx, a.Value)) }
		}
	</span>
}

// formPage is the Recipe form as a page.
templ formPage(now time.Time, f RecipeForm) {
	@web.Layout(web.T(ctx, f.Title), web.RecipesTab) {
		@web.PageHeader("レシピ", web.T(ctx, f.Heading), now)
		@recipeForm(f)
	}
}

// knownIngredients is the id of the list of names a row's name offers as the User types.
const knownIngredients = "known-ingredients"

// removeFormID is the id of the form deleting the Recipe being edited or discarding the
// Recipe Draft, beside the Recipe form since forms don't nest, so Enter still saves.
const removeFormID = "recipe-remove"

// recipeForm is the one form every Recipe is written with. Its add buttons ask htmx for
// one more row, and without htmx post the form back with one.
templ recipeForm(f RecipeForm) {
	<form id="recipe-form" method="post" action={ templ.SafeURL(f.Action) }>
		// Enter presses a form's first submit button: this one saves, not
		// the add or pick buttons above the save button shown.
		<button type="submit" hidden tabindex="-1"></button>
		if f.Confirm {
			@web.Alert() {
				{ web.T(ctx, msgConfirmNew) }
			}
		}
		<div class="stack section">
			<div>
				@web.Field(web.T(ctx, msgName), "", f.Errs["name"]) {
					<input name="name" value={ f.Name } required autocomplete="off" { ingredients.Invalid(f.Errs["name"])... }/>
				}
				if f.TakenID != 0 {
					@web.TextLink(templ.Attributes{"href": recipeURL(f.TakenID)}) {
						{ f.TakenName }
					}
				}
			</div>
			@web.FieldRow() {
				@numberField(msgPortions, "portions", f.Portions, f.Errs["portions"])
				@numberField(msgActive, "active", f.Active, f.Errs["active"])
				@numberField(msgTotal, "total", f.Total, f.Errs["total"])
			}
			<fieldset class="stack">
				<legend class="field-label">{ web.T(ctx, msgSlots) }</legend>
				for _, kind := range domain.SlotKinds {
					@web.Check(web.T(ctx, web.SlotKindNames[kind]), "") {
						<input type="checkbox" name="slots" value={ string(kind) } checked?={ slices.Contains(f.Slots, string(kind)) } { ingredients.Invalid(f.Errs["slots"])... }/>
					}
				}
				@web.FieldError(f.Errs["slots"])
			</fieldset>
		</div>
		@web.FieldGroup(1, web.T(ctx, msgIngredients)) {
			@web.Hint() {
				{ web.T(ctx, msgRowsHint) }
			}
			<div id="ingredients" class="ingredient-grid">
				for i, row := range f.Ingredients {
					@ingredientRow(i, row)
				}
			</div>
			<datalist id={ knownIngredients }>
				for _, ing := range f.Known {
					<option value={ ing.Name }></option>
				}
			</datalist>
			@web.TextButton(addButton("ingredients", "/recipes/ingredient-row/blank", "#ingredients [name^=ing_name_]")) {
				{ web.T(ctx, msgAddIngredient) }
			}
		}
		@web.FieldGroup(2, web.T(ctx, msgSteps)) {
			<ol id="steps" class="draft-steps">
				for _, step := range f.Steps {
					@stepRow(step, false)
				}
			</ol>
			@web.TextButton(addButton("steps", "/recipes/step-row/blank", "")) {
				{ web.T(ctx, msgAddStep) }
			}
		}
		<div class="section">
			@web.Field(web.T(ctx, msgAppliances), web.T(ctx, msgOnePerLine), "") {
				<textarea name="appliances" rows="3">{ f.Appliances }</textarea>
			}
		</div>
		if f.RemoveAction != "" {
			@web.ActionsApart() {
				@saveButton(f)
				@web.DestructiveButton(templ.Attributes{"type": "submit", "form": removeFormID}) {
					{ web.T(ctx, f.Remove) }
				}
			}
		} else {
			@web.Actions() {
				@saveButton(f)
			}
		}
	</form>
	if f.RemoveAction != "" {
		<form id={ removeFormID } method="post" action={ templ.SafeURL(f.RemoveAction) }></form>
	}
	<script src="/static/recipe-form.js"></script>
}

// saveButton saves f.
templ saveButton(f RecipeForm) {
	@web.Button(templ.Attributes{"type": "submit"}) {
		{ web.T(ctx, f.Submit) }
	}
}

// addButton adds to the list named list the row at src, which is told the fields of
// include. A second press while the first loads is dropped, or both would count the same
// rows and take the same number.
func addButton(list, src, include string) templ.Attributes {
	attrs := templ.Attributes{
		"type": "submit", "name": "add", "value": list, "formnovalidate": true,
		"hx-get": src, "hx-target": "#" + list, "hx-swap": "beforeend", "hx-sync": "this:drop",
	}
	if include != "" {
		attrs["hx-include"] = include
	}
	return attrs
}

// pickButton picks name, the known Ingredient suggested for the row at index i, swapping
// the row in place; without htmx it posts the form back with the row picked. It names
// what it picks, so the row gets the Ingredient the User saw.
func pickButton(i int, name string) templ.Attributes {
	vals, _ := json.Marshal(map[string]string{rowField("pick", i): name})
	return templ.Attributes{
		"type": "submit", "name": rowField("pick", i), "value": name, "formnovalidate": true,
		"hx-get": "/recipes/ingredient-row", "hx-vals": string(vals),
		"hx-include": "closest .ingredient-row", "hx-target": "closest .ingredient-row", "hx-swap": "outerHTML",
	}
}

// numberField is a Field for a whole number.
templ numberField(label web.Message, name, value, err string) {
	@web.Field(web.T(ctx, label), "", err) {
		<input type="number" inputmode="numeric" name={ name } value={ value } required { ingredients.Invalid(err)... }/>
	}
}

// stepRow is one step of the form, taking focus as it arrives when focus says so.
templ stepRow(step string, focus bool) {
	<li><textarea name="steps" rows="2" aria-label={ web.T(ctx, msgStep) } autofocus?={ focus }>{ step }</textarea></li>
}

// ingredientRow is the row at index i: its name, which says what it is as the User leaves
// it, and its quantity, with what the name leads to beneath them.
templ ingredientRow(i int, row IngredientRow) {
	<div class="ingredient-row">
		@web.Field(web.T(ctx, msgIngredient), "", row.Errs["name"]) {
			<input
				name={ rowField("name", i) }
				value={ row.Name }
				list={ knownIngredients }
				autocomplete="off"
				autofocus?={ row.Focus }
				hx-get="/recipes/ingredient-row"
				hx-trigger="change"
				hx-target="next .ingredient-details"
				hx-swap="innerHTML"
				hx-include="closest .ingredient-row"
				{ ingredients.Invalid(row.Errs["name"])... }
			/>
		}
		@web.Field(web.T(ctx, msgQuantity), "", cmp.Or(row.UnitChanged, row.Errs["quantity"])) {
			<input name={ rowField("quantity", i) } value={ row.Quantity } inputmode="decimal" autocomplete="off" { ingredients.Invalid(cmp.Or(row.UnitChanged, row.Errs["quantity"]))... }/>
		}
		<div class="ingredient-details">
			@rowDetails(i, row)
		</div>
	</div>
}

// rowDetails is what the row at index i shows beneath its name: nothing while it has
// none, the unit of a known Ingredient, or the fields that confirm a new one.
templ rowDetails(i int, row IngredientRow) {
	if row.Name != "" {
		<input type="hidden" name={ rowField("new", i) } value={ strconv.FormatBool(row.New) }/>
		if row.New {
			@web.Tag(true, "") {
				{ web.T(ctx, msgNew) }
			}
			if row.Suggested != "" {
				<p class="field-hint">
					{ web.Tf(ctx, msgDidYouMean, row.Suggested) + " " }
					@web.TextButton(pickButton(i, row.Suggested)) {
						{ web.Tf(ctx, msgPick, row.Suggested) }
					}
				</p>
			}
			@ingredients.NewIngredientFields(func(field string) string { return rowField(field, i) }, row.typed())
		} else {
			<span class="field-hint">{ web.Tf(ctx, msgMeasuredIn, web.T(ctx, ingredients.UnitNames[domain.Unit(row.Unit)])) }</span>
		}
	}
}

// PasteForm is the paste box as typed, Err why it was refused.
type PasteForm struct{ Text, Err string }

// pasteForm reads a pasted recipe into a Recipe Draft through a parse Run.
templ pasteForm(f PasteForm) {
	<form id="paste-form" method="post" action="/recipes/paste" class="section">
		@web.Field(web.T(ctx, msgPaste), web.T(ctx, msgPasteHint), f.Err) {
			<textarea
				name="text"
				rows="6"
				if f.Err != "" {
					aria-invalid="true"
					autofocus
				}
			>{ f.Text }</textarea>
		}
		@web.Actions() {
			@web.Button(templ.Attributes{"type": "submit"}) {
				{ web.T(ctx, msgRead) }
			}
		}
	</form>
}

// recipeFacts is how many Portions rec makes, its minutes, kinds of Slot and appliances.
templ recipeFacts(rec domain.Recipe) {
	<dl>
		<dt>{ web.T(ctx, msgMakes) }</dt>
		<dd>
			if rec.Portions == 1 {
				{ web.T(ctx, msgMakesOne) }
			} else {
				{ web.Tf(ctx, msgMakesValue, rec.Portions) }
			}
		</dd>
		<dt>{ web.T(ctx, msgActiveShort) }</dt>
		<dd>{ web.Tf(ctx, msgMinutes, rec.ActiveMinutes) }</dd>
		<dt>{ web.T(ctx, msgTotalShort) }</dt>
		<dd>{ web.Tf(ctx, msgMinutes, rec.TotalMinutes) }</dd>
		<dt>{ web.T(ctx, msgSlots) }</dt>
		<dd>{ kindsOf(ctx, rec.Kinds) }</dd>
		if len(rec.Appliances) > 0 {
			<dt>{ web.T(ctx, msgNeeds) }</dt>
			<dd>{ strings.Join(rec.Appliances, ", ") }</dd>
		}
	</dl>
}

// recipeSteps are a Recipe's steps, if it has any.
templ recipeSteps(steps []string) {
	if len(steps) > 0 {
		@web.Section(2, web.T(ctx, msgSteps)) {
			<ol>
				for _, step := range steps {
					<li>{ step }</li>
				}
			</ol>
		}
	}
}
