package runs

import (
	"encoding/json"
	"bytes"
	"cmp"
	"context"
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/agent"
	"github.com/simopzz/dandori/internal/web"
)

// Run is one of the User's Runs with its Trace.
type Run struct {
	ID     int64
	Kind   Kind
	Status Status
	// Asked is what the Run was asked, such as the pasted recipe: on the Runs page, its
	// first line only.
	Asked     string
	StartedAt time.Time
	Trace     []StoredTraceEvent
	// Cause is what cancelled it when the User didn't, a document its kind's page tells,
	// or nil.
	Cause json.RawMessage
}

// StoredTraceEvent is a Trace Event as the Run kept it, with when it happened.
type StoredTraceEvent struct {
	// Seq is its place in the Trace, from 1.
	Seq int
	At  time.Time
	agent.TraceEvent
}

// result is the link to what a Run left the User.
type result struct{ Text, Href string }

// runURL is the page of the Run `id`.
func runURL(id int64) string { return fmt.Sprintf("/runs/%d", id) }

// lastSeq is the place of the last Trace Event `r`'s page shows, 0 for none.
func (r Run) lastSeq() int {
	if len(r.Trace) == 0 {
		return 0
	}
	return r.Trace[len(r.Trace)-1].Seq
}

// runsPage lists the User's Runs, newest first, `kinds` naming each kind.
templ runsPage(now time.Time, list []Run, kinds map[Kind]web.Message) {
	@web.Layout(web.Tf(ctx, msgRunTitle, web.T(ctx, msgRuns)), web.RunsTab) {
		@web.PageHeader("実行", web.T(ctx, msgRuns), now)
		<div class="section">
			if len(list) == 0 {
				@web.Empty() {
					{ web.T(ctx, msgNoRuns) }
				}
			} else {
				@web.Rows() {
					for _, r := range list {
						@web.Row() {
							<a class="row-title" href={ templ.SafeURL(runURL(r.ID)) }>{ cmp.Or(headline(r.Asked), web.T(ctx, kinds[r.Kind])) }</a>
							@statusTag(r.Status)
							<span class="row-meta">
								<span>{ web.T(ctx, kinds[r.Kind]) }</span>
								<span>{ web.DateTime(ctx, now, r.StartedAt.In(now.Location())) }</span>
							</span>
						}
					}
				}
			}
		</div>
	}
}

// statusTag is a Run's status as a Tag in a tone of its own: going navy, succeeded sage,
// failed the accent, and the rest cream.
templ statusTag(s Status) {
	switch s {
		case Going:
			@web.ToneTag(web.Going) {
				{ web.T(ctx, statusNames[s]) }
			}
		case Succeeded:
			@web.ToneTag(web.Done) {
				{ web.T(ctx, statusNames[s]) }
			}
		default:
			@web.Tag(s == Failed, "") {
				{ web.T(ctx, statusNames[s]) }
			}
	}
}

// headlineRunes is how much of what a Run was asked names it on the Runs page.
const headlineRunes = 60

// headline names a Run on the Runs page by `line`, the first of what it was asked: cut to
// headlineRunes, with an ellipsis where it was cut.
func headline(line string) string {
	line = strings.TrimSpace(line)
	if r := []rune(line); len(r) > headlineRunes {
		return strings.TrimSpace(string(r[:headlineRunes])) + "…"
	}
	return line
}

// runPage is a Run and its Trace, with what the User gave it, folded under askedName, and
// a link to what it left, if anything, or a form posting what it was asked to `again`.
// While the Run goes, the page offers to cancel it and appends its Trace Events as they
// stream in; once it ends, it fetches itself again into the body, which goes on to what
// the Run left. Without JavaScript, a link opens it again further along.
templ runPage(now time.Time, r Run, k KindPage, res result, again string, about templ.Component) {
	{{ kind, askedName := web.T(ctx, k.Name), web.T(ctx, k.AskedLabel) }}
	@web.Layout(web.Tf(ctx, msgRunTitle, kind), cmp.Or(k.Tab, web.RunsTab)) {
		@web.PageHeader("実行", kind, now) {
			<p class="lede">
				@statusTag(r.Status)
				{ " " + web.Tf(ctx, msgStarted, web.Time(ctx, r.StartedAt.In(now.Location()))) }
				if again != "" {
					{ " · " }
					@web.TextButton(templ.Attributes{"type": "submit", "form": "try-again"}) {
						{ web.T(ctx, msgTryAgain) }
					}
				}
			</p>
			if about != nil {
				@about
			}
			if res.Href != "" {
				<p class="lede">
					@web.TextLink(templ.Attributes{"href": res.Href}) {
						{ res.Text }
					}
				</p>
			}
			if again != "" {
				// Its button sits in the line above: a form can't go inside a <p>.
				<form novalidate id="try-again" method="post" action={ templ.SafeURL(again) }>
					<input type="hidden" name="text" value={ r.Asked }/>
				</form>
			}
			if r.Status == Going {
				<noscript>
					<p class="lede">
						@web.TextLink(templ.Attributes{"href": runURL(r.ID)}) {
							{ web.T(ctx, msgSeeFurther) }
						}
					</p>
				</noscript>
				<form novalidate id="cancel-run" method="post" action={ templ.SafeURL(runURL(r.ID) + "/cancel") }>
					@web.DestructiveButton(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgCancel) }
					}
				</form>
			}
		}
		if r.Asked != "" && askedName != "" {
			<div class="section">
				@web.Fold(label(askedName), true) {
					@web.Verbatim(r.Asked)
				}
			</div>
		}
		@web.Section(1, web.T(ctx, msgTrace)) {
			<div
				if r.Status == Going {
					hx-get={ runURL(r.ID) + "?ended" }
					hx-trigger="end"
					hx-target="body"
				}
			>
				<ol
					class="trace"
					if r.Status == Going {
						hx-sse:connect={ fmt.Sprintf("%s/events?after=%d", runURL(r.ID), r.lastSeq()) }
						hx-swap="beforeend"
						hx-sse:close="end"
					}
				>
					for _, ev := range r.Trace {
						@traceEvent(ev, now.Location(), k)
					}
				</ol>
			</div>
		}
	}
}

// traceEvent is one Trace Event, a line of when and its fixed line in the User's
// Language, folding its data: what the model was sent or what it or a tool said,
// verbatim, under the model's or the tool's name.
templ traceEvent(ev StoredTraceEvent, zone *time.Location, k KindPage) {
	{{ d := detail(ctx, ev.TraceEvent) }}
	<li class={ "trace-event", "trace-" + string(ev.Kind) }>
		@web.Fold(traceLine(ev, zone, k), d != "") {
			if ev.Kind == agent.Said {
				@web.Markdown(ev.Text)
			} else {
				@web.Verbatim(d)
			}
		}
	</li>
}

templ traceLine(ev StoredTraceEvent, zone *time.Location, k KindPage) {
	<time datetime={ ev.At.Format(time.RFC3339) }>{ web.Time(ctx, ev.At.In(zone)) }</time>
	<span class="trace-kind">{ line(ctx, ev.TraceEvent, k) }</span>
}

templ label(text string) {
	<span class="trace-kind">{ text }</span>
}

// detail is what `ev`'s Fold holds, its data verbatim: the model's name, or a tool's over
// what it was sent, indented to read, or what it said; a retry's wait; a turn's tokens.
func detail(ctx context.Context, ev agent.TraceEvent) string {
	text := ev.Text
	var b bytes.Buffer
	if ev.Kind == agent.Called && json.Indent(&b, []byte(text), "", "  ") == nil {
		text = b.String()
	}
	switch ev.Kind {
	case agent.Started:
		return ev.Model
	case agent.Called, agent.Answered, agent.Refused:
		return strings.TrimSpace(ev.Tool + "\n\n" + text)
	case agent.Retrying:
		return text + "\n\n" + web.Tf(ctx, msgWaiting, ev.WaitMillis)
	case agent.Tokens:
		u := ev.Usage
		return web.Tf(ctx, msgTokens, u.Input, u.Output, u.Thinking, u.CacheRead, u.CacheWrite)
	case agent.Failed, agent.Ended:
		return ""
	}
	return text
}

// line is `ev`'s fixed line in the Language of `ctx`, in a Run of kind `k`.
func line(ctx context.Context, ev agent.TraceEvent, k KindPage) string {
	switch ev.Kind {
	case agent.Started:
		return web.T(ctx, msgStartedRun)
	case agent.Asked:
		return web.Tf(ctx, msgAsked, ev.Turn)
	case agent.Said:
		return web.T(ctx, msgSaid)
	case agent.Called:
		return web.T(ctx, msgCalled)
	case agent.Answered:
		return web.T(ctx, msgAnswered)
	case agent.Refused:
		return web.T(ctx, msgRefused)
	case agent.Retrying:
		return web.Tf(ctx, msgRetrying, ev.Attempt, ev.Retries)
	case agent.Tokens:
		return web.Tf(ctx, msgUsed, ev.Usage.Input+ev.Usage.Output)
	case agent.Failed:
		msg, ok := k.Reasons[ev.Reason]
		if !ok {
			msg = reasonNames[ev.Reason]
		}
		reason := web.T(ctx, msg)
		if strings.Contains(reason, "%s") {
			return web.Tf(ctx, msg, ev.Text)
		}
		if ev.Text != "" { // a detail that is not always there, such as why the model refused
			return reason + " " + ev.Text
		}
		return reason
	case agent.Ended:
		return web.Tf(ctx, msgEnded, web.T(ctx, statusNames[Status(ev.Status)]))
	}
	return string(ev.Kind)
}
