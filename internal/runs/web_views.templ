package runs

import (
	"bytes"
	"cmp"
	"context"
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/simopzz/dandori/internal/agent"
	"github.com/simopzz/dandori/internal/web"
)

// Run is one of the User's Runs with its Trace.
type Run struct {
	ID     int64
	Kind   string
	Status Status
	// Asked is what the Run was asked, such as the pasted recipe: on the Runs page, its
	// first line only.
	Asked     string
	StartedAt time.Time
	Trace     []StoredTraceEvent
}

// StoredTraceEvent is a Trace Event as the Run kept it, with when it happened.
type StoredTraceEvent struct {
	// Seq is its place in the Trace, from 1.
	Seq int
	At  time.Time
	agent.TraceEvent
}

// result is the link to what a Run left the User.
type result struct{ Text, Href string }

// runURL is the page of the Run id.
func runURL(id int64) string { return fmt.Sprintf("/runs/%d", id) }

// lastSeq is the place of the last Trace Event r's page shows, 0 for none.
func (r Run) lastSeq() int {
	if len(r.Trace) == 0 {
		return 0
	}
	return r.Trace[len(r.Trace)-1].Seq
}

// runsPage lists the User's Runs, newest first, kinds naming each kind.
templ runsPage(now time.Time, list []Run, kinds map[string]web.Message) {
	@web.Layout(web.Tf(ctx, msgRunTitle, web.T(ctx, msgRuns)), web.RunsTab) {
		@web.PageHeader("実行", web.T(ctx, msgRuns), now)
		<div class="section">
			if len(list) == 0 {
				@web.Empty() {
					{ web.T(ctx, msgNoRuns) }
				}
			} else {
				@web.Rows() {
					for _, r := range list {
						@web.Row() {
							<a class="row-title" href={ templ.SafeURL(runURL(r.ID)) }>{ cmp.Or(headline(r.Asked), web.T(ctx, kinds[r.Kind])) }</a>
							@web.Tag(r.Status == Failed, "") {
								{ web.T(ctx, statusNames[r.Status]) }
							}
							<span class="row-meta">
								<span>{ web.T(ctx, kinds[r.Kind]) }</span>
								<span>{ startedOn(ctx, now, r.StartedAt.In(now.Location())) }</span>
							</span>
						}
					}
				}
			}
		</div>
	}
}

// headlineRunes is how much of what a Run was asked names it on the Runs page.
const headlineRunes = 60

// headline names a Run on the Runs page by line, the first of what it was asked: cut to
// headlineRunes, with an ellipsis where it was cut.
func headline(line string) string {
	line = strings.TrimSpace(line)
	if r := []rune(line); len(r) > headlineRunes {
		return strings.TrimSpace(string(r[:headlineRunes])) + "…"
	}
	return line
}

// runPage is a Run and its Trace, with what the User gave it, folded under askedName,
// and a link to what it left, if anything, or a form posting what it was asked to again.
// While the Run goes, the page offers to cancel
// it and appends its Trace Events as they stream in; once it ends, it fetches itself
// again into the body, which goes on to what the Run left. Without JavaScript, a link
// opens it again further along.
templ runPage(now time.Time, r Run, kind, askedName string, res result, again string) {
	@web.Layout(web.Tf(ctx, msgRunTitle, kind), web.RunsTab) {
		@web.PageHeader("実行", kind, now) {
			<p class="lede">
				@web.Tag(r.Status == Failed, "") {
					{ web.T(ctx, statusNames[r.Status]) }
				}
				{ " " + web.Tf(ctx, msgStarted, web.TimeWithSeconds(ctx, r.StartedAt.In(now.Location()))) }
				if again != "" {
					{ " · " }
					@web.TextButton(templ.Attributes{"type": "submit", "form": "try-again"}) {
						{ web.T(ctx, msgTryAgain) }
					}
				}
			</p>
			if res.Href != "" {
				<p class="lede">
					@web.TextLink(templ.Attributes{"href": res.Href}) {
						{ res.Text }
					}
				</p>
			}
			if again != "" {
				// Its button sits in the line above: a form can't go inside a <p>.
				<form id="try-again" method="post" action={ templ.SafeURL(again) }>
					<input type="hidden" name="text" value={ r.Asked }/>
				</form>
			}
			if r.Status == Going {
				<noscript>
					<p class="lede">
						@web.TextLink(templ.Attributes{"href": runURL(r.ID)}) {
							{ web.T(ctx, msgSeeFurther) }
						}
					</p>
				</noscript>
				<form id="cancel-run" method="post" action={ templ.SafeURL(runURL(r.ID) + "/cancel") }>
					@web.DestructiveButton(templ.Attributes{"type": "submit"}) {
						{ web.T(ctx, msgCancel) }
					}
				</form>
			}
		}
		if r.Asked != "" && askedName != "" {
			<div class="section">
				@web.Fold(label(askedName), true) {
					<pre class="trace-detail">{ r.Asked }</pre>
				}
			</div>
		}
		@web.Section(0, web.T(ctx, msgTrace)) {
			<div
				if r.Status == Going {
					hx-get={ runURL(r.ID) + "?ended" }
					hx-trigger="end"
					hx-target="body"
				}
			>
				<ol
					class="trace"
					if r.Status == Going {
						hx-sse:connect={ fmt.Sprintf("%s/events?after=%d", runURL(r.ID), r.lastSeq()) }
						hx-swap="beforeend"
						hx-sse:close="end"
					}
				>
					for _, ev := range r.Trace {
						@traceEvent(ev, now.Location())
					}
				</ol>
			</div>
		}
	}
}

// traceEvent is one Trace Event, a line of when and its fixed line in the User's
// Language, folding what the model was sent or what it or a tool said, verbatim.
templ traceEvent(ev StoredTraceEvent, zone *time.Location) {
	<li class={ "trace-event", "trace-" + string(ev.Kind) }>
		@web.Fold(traceLine(ev, zone), ev.Text != "" && ev.Kind != agent.Failed) {
			if ev.Kind == agent.Said {
				@web.Markdown(ev.Text)
			} else {
				<pre class="trace-detail">{ indented(ev.TraceEvent) }</pre>
			}
		}
	</li>
}

templ traceLine(ev StoredTraceEvent, zone *time.Location) {
	<time datetime={ ev.At.Format(time.RFC3339) }>{ web.TimeWithSeconds(ctx, ev.At.In(zone)) }</time>
	<span class="trace-kind">{ line(ctx, ev.TraceEvent) }</span>
}

templ label(text string) {
	<span class="trace-kind">{ text }</span>
}

// startedOn is when a Run started at, as of now: the day, with its year unless it is
// now's, and the time.
func startedOn(ctx context.Context, now, at time.Time) string {
	if at.Year() != now.Year() {
		return web.Tf(ctx, msgStartedOn, web.ShortDateInYear(ctx, at), web.Time(ctx, at))
	}
	return web.Tf(ctx, msgStartedOn, web.ShortDate(ctx, at), web.Time(ctx, at))
}

// indented is ev's text, a tool's input indented to read.
func indented(ev agent.TraceEvent) string {
	var b bytes.Buffer
	if ev.Kind != agent.Called || json.Indent(&b, []byte(ev.Text), "", "  ") != nil {
		return ev.Text
	}
	return b.String()
}

// line is ev's fixed line in the Language of ctx.
func line(ctx context.Context, ev agent.TraceEvent) string {
	switch ev.Kind {
	case agent.Started:
		return web.Tf(ctx, msgStartedWith, ev.Model)
	case agent.Asked:
		return web.Tf(ctx, msgAsked, ev.Turn)
	case agent.Said:
		return web.T(ctx, msgSaid)
	case agent.Called:
		return web.Tf(ctx, msgCalled, ev.Tool)
	case agent.Answered:
		return web.Tf(ctx, msgAnswered, ev.Tool)
	case agent.Refused:
		return web.Tf(ctx, msgRefused, ev.Tool)
	case agent.Retrying:
		return web.Tf(ctx, msgRetrying, ev.Attempt, ev.Retries, ev.WaitMillis)
	case agent.Tokens:
		u := ev.Usage
		return web.Tf(ctx, msgTokens, u.Input, u.Output, u.Thinking, u.CacheRead, u.CacheWrite)
	case agent.Failed:
		reason := web.T(ctx, reasonNames[ev.Reason])
		if strings.Contains(reason, "%s") {
			return web.Tf(ctx, reasonNames[ev.Reason], ev.Text)
		}
		if ev.Text != "" { // a detail that is not always there, such as why the model refused
			return reason + " " + ev.Text
		}
		return reason
	case agent.Ended:
		return web.Tf(ctx, msgEnded, web.T(ctx, statusNames[Status(ev.Status)]))
	}
	return string(ev.Kind)
}
